{
  "name": "my-affiliate-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node --experimental-strip-types scripts/build-outbound-manifest.mjs && node scripts/release-preservation-check.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "commercial-experiment": "node --experimental-strip-types scripts/commercial-experiment.mjs",
    "commercial-crawl": "node --experimental-strip-types scripts/commercial-crawl.mjs",
    "seo-check": "node scripts/site-inventory.mjs --check",
    "freshness-report": "node scripts/source-freshness-report.mjs",
    "source-health-report": "node scripts/source-health-report.mjs",
    "data-quality-check": "node scripts/data-quality-check.mjs",
    "indexation-ledger": "node scripts/build-indexation-ledger.mjs",
    "search-readiness": "node scripts/search-readiness.mjs",
    "revenue-intelligence": "node --experimental-strip-types scripts/revenue-intelligence.mjs --as-of 2026-08-31",
    "acquisition-pack": "node --experimental-strip-types scripts/acquisition-pack.mjs --as-of 2026-08-31",
    "agent-bus-handoff": "node --experimental-strip-types scripts/agent-bus-handoff.mjs --as-of 2026-08-31",
    "distribution-suppression": "node --experimental-strip-types scripts/distribution-suppression.mjs --as-of 2026-08-31",
    "production-contract-probe": "node scripts/production-cta-contract-probe.mjs",
    "production-route-snapshot": "node scripts/production-route-snapshot.mjs",
    "production-route-snapshot:verify": "node scripts/production-route-snapshot.mjs --verify",
    "partner-activate": "node --experimental-strip-types scripts/partner-activate.mjs",
    "partner-manage": "node --experimental-strip-types scripts/partner-manage.mjs",
    "partner-import": "node --experimental-strip-types scripts/partner-import.mjs",
    "partner-platform": "node --experimental-strip-types scripts/partner-platform.mjs",
    "partner-factory": "node --experimental-strip-types scripts/partner-factory.mjs",
    "partner-health": "node --experimental-strip-types scripts/partner-health.mjs",
    "route-debug": "node --experimental-strip-types scripts/route-debug.mjs",
    "outbound-export": "node scripts/outbound-export.mjs",
    "live-revenue-ops": "node scripts/live-revenue-ops.mjs",
    "operations": "node scripts/gridpermit-operations.mjs",
    "operations:install-skills": "node scripts/install-gridpermit-skills.mjs",
    "release-preservation-check": "node scripts/release-preservation-check.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@netlify/blobs": "11.1.1",
    "astro": "^7.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^6.0.3"
  }
}
