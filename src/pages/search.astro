---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import DesignHead from "../components/DesignHead.astro";
// Site-wide, client-side-only search. The entire index is embedded in the
// page at build time (as JSON) and matched instantly in the browser — no
// external search service, no network request per keystroke. See
// src/lib/search-index.ts for the pure index-building/matching logic this
// page and its tests both call.
import { SITE_ORIGIN, buildBreadcrumbSchema, buildLocalityIndexEntries, type LocalityRecord } from "../lib/locality-guide";
import { getAllBlogPosts } from "../lib/blog-posts";
import { buildSearchIndex } from "../lib/search-index";
import { buildCountyHubs, type ReadyEvaluationSummary } from "../lib/county-hub";
import { buildUtilityHubs } from "../lib/utility-hub";
import Analytics from "../components/Analytics.astro";
import { STATE_META, SUPPORTED_STATE_CODES } from "../lib/state-meta";

const localityModules = import.meta.glob("../../data/localities/*.json", { eager: true }) as Record<
	string,
	{ default: LocalityRecord }
>;
const recordsById = new Map(Object.values(localityModules).map((mod) => [mod.default.record_id, mod.default]));
// Combine every evaluation run's records — see the same note in
// solar-permit-guides.astro and LocalityGuideLayout.astro. Loaded via glob
// so a new batch's evaluation file is picked up automatically.
const evaluationModules = import.meta.glob("../../output/*-evaluation.json", { eager: true }) as Record<
	string,
	{ default: { records: Array<{ record_id: string; readiness: string; completeness_pct: number }> } }
>;
const allEvaluatedRecords = Object.values(evaluationModules).flatMap((mod) => mod.default.records);
const localityEntries = buildLocalityIndexEntries(allEvaluatedRecords, recordsById);
const blogPosts = await getAllBlogPosts();
const countyHubs = buildCountyHubs(allEvaluatedRecords as ReadyEvaluationSummary[], recordsById);
const utilityHubs = buildUtilityHubs(allEvaluatedRecords as ReadyEvaluationSummary[], recordsById);

const searchIndex = buildSearchIndex({
  localityEntries, blogPosts,
  countyHubs: countyHubs.filter(hub => hub.state === 'CA'),
  utilityHubs: utilityHubs.filter(hub => hub.state === 'CA'),
  states: SUPPORTED_STATE_CODES.map(code => STATE_META[code]),
});

const PAGE_PATH = "/search/";
const CANONICAL_URL = `${SITE_ORIGIN}${PAGE_PATH}`;
const title = "Search | GridPermit";
const description = "Search GridPermit's California solar permit guides, blog, and methodology.";

const breadcrumbItems = [
	{ name: "Home", url: `${SITE_ORIGIN}/` },
	{ name: "Search", url: CANONICAL_URL },
];
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems);
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
	<Analytics />
	<DesignHead />
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={CANONICAL_URL} />

	<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
	<link rel="sitemap" href="/sitemap-index.xml" />

	<meta property="og:type" content="website" />
	<meta property="og:url" content={CANONICAL_URL} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />

	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</head>
<body>
	<a href="#main-content" class="skip-link">Skip to main content</a>


	<Header />

	<div class="page-container">
		<nav class="breadcrumb-nav" aria-label="Breadcrumb">
			<a href="/">Home</a><span class="crumb-sep">/</span><span class="crumb-current">Search</span>
		</nav>

		<main class="content-card" id="main-content" tabindex="-1">
			<p class="gp-kicker">Find your place</p><h1>Start local.<br/>Get clear.</h1>
			<p class="subtitle">Search published city guides, counties, electric utilities and solar topics. Coverage varies by location.</p>

			<label for="search-input" class="gp-kicker">City, county, utility or topic</label><input type="search" id="search-input" placeholder="Search for a city, utility, or topic…" aria-label="Site search" aria-controls="results-list" aria-describedby="search-hint" />

			<noscript><p>Instant search requires JavaScript. You can still <a href="/permits/">browse guides by state</a>.</p></noscript>
			<p id="search-result-count" role="status" class="gp-kicker"></p><ul class="results-list" id="results-list" aria-label="Search results"></ul>
			<p class="search-hint" id="search-hint">Start typing to search cities (e.g. "Oakland"), counties (e.g. "Alameda County"), utilities (e.g. "PG&E" or "SCE"), or topics (e.g. "SGIP", "NEM 3.0").</p>
			<div class="no-results" id="no-results" hidden>
				<p>No results found for that search.</p>
				<p class="no-results-hint">Try searching by city, county, utility name, or state (e.g. "Texas" or "Ohio"). You can also browse <a href="/california/solar-permit-guides/">California guides</a> or go to the <a href="/">homepage</a>.</p>
			</div>

			<script is:inline type="application/json" id="search-index-data" set:html={JSON.stringify(searchIndex).replace(/</g, "\\u003c")} />
		</main>
	</div>

	<Footer />

	<script>
		import { trackEvent } from "../lib/analytics-events";
		import { searchEntries, type SearchEntry } from "../lib/search-index";

		const dataEl = document.getElementById("search-index-data");
		const index: SearchEntry[] = dataEl ? JSON.parse(dataEl.textContent ?? "[]") : [];

		const input = document.getElementById("search-input") as HTMLInputElement | null;
		const resultsList = document.getElementById("results-list");
		const hint = document.getElementById("search-hint");
		const noResults = document.getElementById("no-results");

		// Fires at most once per distinct non-empty query, not on every
		// keystroke — avoids flooding GA with one event per character typed.
		let lastTrackedQuery = "";
		let activeIndex = -1; // keyboard-highlighted result, -1 = none

		function currentItems(): HTMLAnchorElement[] {
			if (!resultsList) return [];
			return Array.from(resultsList.querySelectorAll("a"));
		}

		function setActive(index: number) {
			const items = currentItems();
			if (items.length === 0) {
				activeIndex = -1;
				return;
			}
			activeIndex = ((index % items.length) + items.length) % items.length;
			for (const [i, el] of items.entries()) {
				el.classList.toggle("is-active", i === activeIndex);
			}
			items[activeIndex]?.scrollIntoView({ block: "nearest" });
		}

		function render(query: string) {
			const results = searchEntries(index, query);
			if (!resultsList || !hint || !noResults) return;

			resultsList.innerHTML = "";
			activeIndex = -1;
			if (query.trim() === "") {
				hint.hidden = false;
				noResults.hidden = true;
				lastTrackedQuery = "";
                const count = document.getElementById("search-result-count"); if (count) count.textContent = "";
				return;
			}
			hint.hidden = true;
			noResults.hidden = results.length > 0;

			const count = document.getElementById("search-result-count");
            if (count) count.textContent = `${results.length} ${results.length === 1 ? "result" : "results"}`;
			const normalizedQuery = query.trim().toLowerCase();
			if (normalizedQuery !== lastTrackedQuery) {
				lastTrackedQuery = normalizedQuery;
				trackEvent("search_used", { result_count: results.length });
			}

			for (const r of results) {
				const li = document.createElement("li");
				li.className = "result-item";

				const a = document.createElement("a");
				a.href = r.url;

				const category = document.createElement("span");
				category.className = "result-category";
				category.textContent = r.category;

				const title = document.createElement("span");
				title.className = "result-title";
				title.textContent = r.title;

				const description = document.createElement("span");
				description.className = "result-description";
				description.textContent = r.description;

				a.append(category, title, description);
				li.appendChild(a);
				resultsList.appendChild(li);
			}
		}

		input?.addEventListener("input", () => render(input.value));

		// Supports the homepage's WebSite SearchAction JSON-LD
		// (target: "/search?q={search_term_string}") and lets any other page
		// link to a pre-run search, e.g. <a href="/search?q=Oakland">.
		const initialQuery = new URLSearchParams(window.location.search).get("q");
		if (initialQuery && input) {
			input.value = initialQuery;
			render(initialQuery);
		}

		// Arrow keys move a highlighted result; Enter follows it (falling back
		// to the first result if none is highlighted yet) — keyboard users
		// never have to reach for the mouse to open a search result.
		input?.addEventListener("keydown", (e) => {
			const items = currentItems();
			if (items.length === 0) return;

			if (e.key === "ArrowDown") {
				e.preventDefault();
				setActive(activeIndex + 1);
			} else if (e.key === "ArrowUp") {
				e.preventDefault();
				setActive(activeIndex - 1);
			} else if (e.key === "Enter") {
				const target = items[activeIndex] ?? items[0];
				if (target) {
					e.preventDefault();
					target.click();
				}
			}
		});
	</script>


<style>
 .page-container { max-width: 960px; }
 #search-input { width: 100%; padding: 22px; font-size: 22px; margin-bottom: 24px; }
 .results-list { list-style: none; margin: 24px 0; padding: 0; }
 .result-item { margin: 0; }
 .result-item a { display: block; padding: 24px 0; border-top: 1px solid var(--gp-line); text-decoration: none; }
 .result-item a.is-active { background: var(--gp-surface); outline: 2px solid var(--gp-focus); outline-offset: 4px; }
 .result-category { display: block; font: 10px/1.5 var(--gp-mono); color: var(--gp-muted); text-transform: uppercase; margin: 0 0 10px; }
 .result-title { display: block; font-size: 24px; font-weight: 300; margin-bottom: 10px; }
 .result-description { display: block; font-size: 14px; color: var(--gp-muted); max-width: 720px; }
 .search-hint,.no-results { color: var(--gp-muted); font-size: 14px; padding: 24px 0; }
</style>
</body>
</html>
