---
// Site-wide, client-side-only search. The entire index is embedded in the
// page at build time (as JSON) and matched instantly in the browser — no
// external search service, no network request per keystroke. See
// src/lib/search-index.ts for the pure index-building/matching logic this
// page and its tests both call.
import { SITE_ORIGIN, buildBreadcrumbSchema, buildLocalityIndexEntries, type LocalityRecord } from "../lib/locality-guide";
import { getAllBlogPosts } from "../lib/blog-posts";
import { buildSearchIndex } from "../lib/search-index";
import Analytics from "../components/Analytics.astro";

const localityModules = import.meta.glob("../../data/localities/*.json", { eager: true }) as Record<
	string,
	{ default: LocalityRecord }
>;
const recordsById = new Map(Object.values(localityModules).map((mod) => [mod.default.record_id, mod.default]));
// Combine every evaluation run's records — see the same note in
// solar-permit-guides.astro and LocalityGuideLayout.astro. Loaded via glob
// so a new batch's evaluation file is picked up automatically.
const evaluationModules = import.meta.glob("../../output/*-evaluation.json", { eager: true }) as Record<
	string,
	{ default: { records: Array<{ record_id: string; readiness: string; completeness_pct: number }> } }
>;
const allEvaluatedRecords = Object.values(evaluationModules).flatMap((mod) => mod.default.records);
const localityEntries = buildLocalityIndexEntries(allEvaluatedRecords, recordsById);
const blogPosts = await getAllBlogPosts();

const searchIndex = buildSearchIndex({ localityEntries, blogPosts });

const PAGE_PATH = "/search/";
const CANONICAL_URL = `${SITE_ORIGIN}${PAGE_PATH}`;
const title = "Search | GridPermit";
const description = "Search GridPermit's California solar permit guides, blog, and methodology.";

const breadcrumbItems = [
	{ name: "Home", url: `${SITE_ORIGIN}/` },
	{ name: "Search", url: CANONICAL_URL },
];
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems);
---

<!DOCTYPE html>
<html lang="en">
<head>
	<Analytics />
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={CANONICAL_URL} />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" class="async-font-css">
	<noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"></noscript>

	<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
	<link rel="sitemap" href="/sitemap-index.xml" />

	<meta property="og:type" content="website" />
	<meta property="og:url" content={CANONICAL_URL} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />

	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</head>
<body>
	<div class="top-banner">
		Independent Educational Guide: California residential solar and battery estimates. Illustrative only — not utility-specific.
	</div>

	<nav class="navbar">
		<div class="nav-container">
			<a href="/" class="brand-logo" aria-label="GridPermit Home">
				<span class="logo-text">Grid<span class="logo-bold">Permit</span></span>
			</a>
			<div class="nav-links">
				<a href="/#calculator">ROI Calculator</a>
				<a href="/how-it-works">How It Works</a>
				<a href="/california/solar-permit-guides/">California Guides</a>
				<a href="/blog">Blog</a>
				<a href="/methodology">Methodology</a>
			</div>
			<a href="/#calculator" class="btn-cta-nav">Estimate Savings</a>
		</div>
	</nav>

	<div class="page-container">
		<nav class="breadcrumb-nav" aria-label="Breadcrumb">
			<a href="/">Home</a><span class="crumb-sep">/</span><span class="crumb-current">Search</span>
		</nav>

		<main class="content-card">
			<h1>Search GridPermit</h1>
			<p class="subtitle">Search across California permit guides, blog posts, and site pages — {searchIndex.length} indexed pages</p>

			<input type="search" id="search-input" placeholder="Search for a city, utility, or topic…" aria-label="Site search" autofocus />

			<ul class="results-list" id="results-list"></ul>
			<p class="search-hint" id="search-hint">Start typing to search cities (e.g. "Oakland"), utilities (e.g. "PG&E" or "SCE"), or topics (e.g. "SGIP", "NEM 3.0").</p>
			<p class="no-results" id="no-results" hidden>No results found.</p>

			<script is:inline type="application/json" id="search-index-data" set:html={JSON.stringify(searchIndex)} />
		</main>
	</div>

	<footer class="footer">
		<div class="footer-container">
			<p>© 2026 GridPermit. All rights reserved.</p>
			<p class="affiliate-disclosure">
				GridPermit is an independent educational resource and referral website. Estimates are provided for informational purposes only and are not engineering, financial, tax, or installation advice. GridPermit is not a solar installer, contractor, engineering firm, public utility, or government agency.
			</p>
			<div class="footer-links">
				<a href="/about">About Us</a> | <a href="/how-it-works">How It Works</a> | <a href="/california/solar-permit-guides/">California Guides</a> | <a href="/blog">Blog</a> | <a href="/methodology">Methodology</a> | <a href="/contact">Contact</a> | <a href="/privacy">Privacy Policy</a> | <a href="/terms">Terms of Service</a>
			</div>
		</div>
	</footer>

	<script>
		import { trackEvent } from "../lib/analytics-events";
		import { searchEntries, type SearchEntry } from "../lib/search-index";

		const dataEl = document.getElementById("search-index-data");
		const index: SearchEntry[] = dataEl ? JSON.parse(dataEl.textContent ?? "[]") : [];

		const input = document.getElementById("search-input") as HTMLInputElement | null;
		const resultsList = document.getElementById("results-list");
		const hint = document.getElementById("search-hint");
		const noResults = document.getElementById("no-results");

		// Fires at most once per distinct non-empty query, not on every
		// keystroke — avoids flooding GA with one event per character typed.
		let lastTrackedQuery = "";
		let activeIndex = -1; // keyboard-highlighted result, -1 = none

		function currentItems(): HTMLAnchorElement[] {
			if (!resultsList) return [];
			return Array.from(resultsList.querySelectorAll("a"));
		}

		function setActive(index: number) {
			const items = currentItems();
			if (items.length === 0) {
				activeIndex = -1;
				return;
			}
			activeIndex = ((index % items.length) + items.length) % items.length;
			for (const [i, el] of items.entries()) {
				el.classList.toggle("is-active", i === activeIndex);
			}
			items[activeIndex]?.scrollIntoView({ block: "nearest" });
		}

		function render(query: string) {
			const results = searchEntries(index, query);
			if (!resultsList || !hint || !noResults) return;

			resultsList.innerHTML = "";
			activeIndex = -1;
			if (query.trim() === "") {
				hint.hidden = false;
				noResults.hidden = true;
				lastTrackedQuery = "";
				return;
			}
			hint.hidden = true;
			noResults.hidden = results.length > 0;

			const normalizedQuery = query.trim().toLowerCase();
			if (normalizedQuery !== lastTrackedQuery) {
				lastTrackedQuery = normalizedQuery;
				trackEvent("search_used", { result_count: results.length });
			}

			for (const r of results) {
				const li = document.createElement("li");
				li.className = "result-item";
				li.innerHTML = `<a href="${r.url}"><span class="result-category">${r.category}</span><span class="result-title">${r.title}</span><span class="result-description">${r.description}</span></a>`;
				resultsList.appendChild(li);
			}
		}

		input?.addEventListener("input", () => render(input.value));

		// Supports the homepage's WebSite SearchAction JSON-LD
		// (target: "/search?q={search_term_string}") and lets any other page
		// link to a pre-run search, e.g. <a href="/search?q=Oakland">.
		const initialQuery = new URLSearchParams(window.location.search).get("q");
		if (initialQuery && input) {
			input.value = initialQuery;
			render(initialQuery);
		}

		// Arrow keys move a highlighted result; Enter follows it (falling back
		// to the first result if none is highlighted yet) — keyboard users
		// never have to reach for the mouse to open a search result.
		input?.addEventListener("keydown", (e) => {
			const items = currentItems();
			if (items.length === 0) return;

			if (e.key === "ArrowDown") {
				e.preventDefault();
				setActive(activeIndex + 1);
			} else if (e.key === "ArrowUp") {
				e.preventDefault();
				setActive(activeIndex - 1);
			} else if (e.key === "Enter") {
				const target = items[activeIndex] ?? items[0];
				if (target) {
					e.preventDefault();
					target.click();
				}
			}
		});
	</script>

	<style>
		:root { --primary: #2563eb; --bg-dark: #0f172a; --bg-slate: #f8fafc; --text-main: #0f172a; --text-muted: #64748b; --border-color: #e2e8f0; --radius: 16px; }
		* { box-sizing: border-box; }
		body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--bg-slate); color: var(--text-main); line-height: 1.6; margin: 0; }
		.top-banner { background: #1e293b; color: #cbd5e1; text-align: center; padding: 0.6rem 1rem; font-size: 0.85rem; font-weight: 500; }
		.navbar { background: white; border-bottom: 1px solid var(--border-color); padding: 0.85rem 2rem; position: sticky; top: 0; z-index: 100; }
		.nav-container { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
		.brand-logo { text-decoration: none; }
		.logo-text { font-size: 1.75rem; font-weight: 400; color: #0f172a; }
		.logo-bold { font-weight: 800; }
		.nav-links { display: flex; gap: 1.25rem; }
		.nav-links a { text-decoration: none; color: var(--text-muted); font-weight: 600; font-size: 0.88rem; }
		.btn-cta-nav { background: var(--primary); color: white; padding: 0.6rem 1.25rem; border-radius: 8px; font-weight: 700; text-decoration: none; font-size: 0.9rem; }
		@media (max-width: 640px) {
			.nav-container { flex-wrap: wrap; row-gap: 0.6rem; }
			.nav-links { flex-wrap: wrap; justify-content: center; }
		}

		.page-container { max-width: 800px; margin: 0 auto; padding: 2rem 1rem 4rem; }
		.breadcrumb-nav { font-size: 0.82rem; color: var(--text-muted); margin-bottom: 1rem; }
		.breadcrumb-nav a { color: var(--primary); text-decoration: none; }
		.crumb-sep { margin: 0 0.4rem; }
		.crumb-current { color: var(--text-main); font-weight: 600; }

		.content-card { background: white; border: 1px solid var(--border-color); border-radius: var(--radius); padding: 2.25rem; }
		h1 { font-size: 2rem; font-weight: 800; margin: 0 0 0.35rem; }
		.subtitle { color: var(--text-muted); font-size: 0.95rem; margin: 0 0 1.5rem; }

		#search-input { width: 100%; padding: 0.85rem 1.1rem; border: 1px solid var(--border-color); border-radius: 10px; font-size: 1rem; font-family: inherit; margin-bottom: 1.25rem; }
		#search-input:focus { outline: none; border-color: var(--primary); }

		.search-hint, .no-results { color: var(--text-muted); font-size: 0.9rem; text-align: center; padding: 1rem 0; }

		.results-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; }
		.result-item a { display: block; background: #f8fafc; border: 1px solid var(--border-color); border-radius: 10px; padding: 1rem 1.25rem; text-decoration: none; color: var(--text-main); }
		.result-item a:hover, .result-item a.is-active { border-color: var(--primary); background: #eff6ff; }
		.result-category { display: block; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--primary); margin-bottom: 0.25rem; }
		.result-title { display: block; font-size: 1.02rem; font-weight: 700; margin-bottom: 0.25rem; }
		.result-description { display: block; font-size: 0.85rem; color: #475569; }

		.footer { background: var(--bg-dark); color: white; padding: 2.5rem 1.5rem; text-align: center; border-top: 1px solid rgba(255, 255, 255, 0.1); }
		.affiliate-disclosure { font-size: 0.75rem; color: #64748b; max-width: 800px; margin: 0.75rem auto; line-height: 1.4; }
		.footer-links { margin-top: 0.75rem; font-size: 0.85rem; }
		.footer-links a { color: #94a3b8; text-decoration: none; margin: 0 0.5rem; }
		p { margin: 0 0 0.75rem; }
	</style>
</body>
</html>
