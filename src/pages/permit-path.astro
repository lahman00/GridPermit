---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import DesignHead from "../components/DesignHead.astro";
import Analytics from "../components/Analytics.astro";
import { SITE_ORIGIN } from "../lib/locality-guide";
import { stateMeta } from "../lib/state-meta";
import { permitPathRecords, type PublishedLocality } from "../lib/permit-path-records";

const localityModules = import.meta.glob("../../data/localities/*.json", { eager: true }) as Record<
  string,
  { default: PublishedLocality }
>;

// The page only needs each locality's label for the <select>. Record details are
// static JSON files (src/pages/permit-path/records/[id].json.ts) loaded on demand.
const records = permitPathRecords(Object.values(localityModules).map((mod) => mod.default));

const localityGroups: { name: string; records: typeof records }[] = [];
for (const record of records) {
  const name = stateMeta(record.state).name;
  const last = localityGroups[localityGroups.length - 1];
  if (last && last.name === name) last.records.push(record);
  else localityGroups.push({ name, records: [record] });
}

const title = "Solar Permit Path Checker | GridPermit";
const description = "Check a researched locality’s permit authority, utility path, SolarAPP+ status, required documents, fees and verified timeline facts.";
const canonical = `${SITE_ORIGIN}/permit-path/`;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <Analytics />
	<DesignHead />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index,follow" />
  <meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <style>.wrap {max-width:1120px;margin:0 auto;padding:2.5rem 1.25rem 5rem}.hero {max-width:820px;margin-bottom:1.75rem}.eyebrow {font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;font-weight:800;color:var(--blue)}.lead {font-size:1.05rem;color: var(--gp-muted);max-width:760px}.layout {display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1.25rem;align-items:start}.card {background: var(--gp-surface);border:1px solid var(--border);border-radius: 2px;padding:1.35rem;box-shadow: none}.helper {color:var(--muted);font-size:.9rem;margin:.25rem 0 1rem}label {display:block;font-weight:750;font-size:.86rem;margin:.95rem 0 .35rem}select, input {width:100%;padding:.72rem .78rem;border: 1px solid var(--gp-line);border-radius: 2px;background: var(--gp-surface);color:var(--slate);font:inherit}.checks {display:grid;grid-template-columns:1fr 1fr;gap:.5rem .75rem;margin-top:.4rem}.check {display:flex;align-items:flex-start;gap:.5rem;font-size:.88rem;color: var(--gp-ink)}.check input {width:auto;margin-top:.2rem}.button {border:0;border-radius: 2px;background:var(--blue);color: var(--gp-ink);font:inherit;font-weight:800;padding:.8rem 1rem;margin-top:1rem;cursor:pointer}.button:hover {filter:brightness(1.08)}.result-empty {border: 1px dashed var(--gp-line);border-radius: 2px;padding:1.2rem;color:var(--muted)}.cta {background: var(--gp-surface);border: 1px solid var(--gp-line);border-radius: 2px;padding:1rem;margin-top:1rem}.cta a {display:inline-block;color: var(--gp-accent-ink);background:var(--blue);padding:.65rem .8rem;border-radius: 2px;text-decoration:none;font-weight:800}:global(#result) {--tone-ok:#62b982;--tone-warn:#e6a34a}
:global(:root[data-theme='light'] #result) {--tone-ok:#1b6b3a;--tone-warn:#8a5300}
:global(#result .status) {border:1px solid var(--gp-line);border-radius: 2px;padding:.9rem 1rem;margin:.75rem 0 1rem;color: var(--gp-ink);font-weight:650}
:global(#result .status.good) {border-left:4px solid var(--tone-ok);background: color-mix(in srgb, var(--tone-ok) 10%, var(--gp-surface))}
:global(#result .status.caution) {border-left:4px solid var(--tone-warn);background: color-mix(in srgb, var(--tone-warn) 10%, var(--gp-surface))}
:global(#result .section) {padding:1rem 0;border-top:1px solid var(--border)}
:global(#result .section h3) {font-size:.94rem;margin:0 0 .45rem}
:global(#result .value) {font-weight:750}
:global(#result .muted) {color:var(--muted)}
:global(#result .official) {display:inline-flex;align-items:center;min-height:44px;margin-top:.15rem;color:var(--blue);font-weight:750;text-decoration:underline;text-underline-offset:3px}
:global(#result .unknowns) {margin:.45rem 0 0;padding-left:1.15rem;color: var(--gp-muted)}
:global(#result .docs) {margin:.35rem 0 0;padding-left:1.15rem}
:global(#result .sources) {display:grid;gap:.55rem}
:global(#result .source) {font-size:.82rem;color: var(--gp-muted)}
:global(#result .source a) {color:var(--blue);text-decoration:underline;text-underline-offset:3px}
:global(#result .verified) {font-size:.78rem;color:var(--muted)}
:global(#result .cta) {background: var(--gp-surface);border: 1px solid var(--gp-line);border-radius: 2px;padding:1rem;margin-top:1rem}
:global(#result .cta a) {display:inline-flex;align-items:center;min-height:44px;color: var(--gp-accent-ink);background:var(--blue);padding:.65rem .8rem;border-radius: 2px;text-decoration:none;font-weight:800}
.mods {border:0;margin:.95rem 0 0;padding:0;min-width:0}
.mods legend {padding:0;font-weight:750;font-size:.86rem;margin:0 0 .35rem}
:global(#result .pro-note) {margin:1rem 0 0;font-size:.86rem;color:var(--muted)}:global(#result .pro-note a) {display:inline-flex;align-items:center;min-height:44px;color:var(--blue);font-weight:750}.disclaimer {max-width:900px;margin:1.5rem 0 0;color:var(--muted);font-size:.8rem}@media(max-width:820px){.layout {grid-template-columns:1fr}.checks {grid-template-columns:1fr}}
.eyebrow {margin:0 0 var(--gp-space-2)}
.hero h1 {margin:0 0 var(--gp-space-3)}
:global(#result[aria-busy='true'] .result-empty) {border-style:solid}
  </style>
</head>
<body>
<a href="#main-content" class="skip-link">Skip to main content</a>
  <Header />
  <main class="wrap" id="main-content" tabindex="-1">
    <section class="hero">
      <div class="eyebrow">Decision-stage permit research</div>
      <h1>Find the permit path before you buy, revise or wait.</h1>
      <p class="lead">Choose a locality already researched by GridPermit, then add the project facts that commonly change the approval path. The checker only reports facts present in our source-linked records. It does not invent a local rule when the record is incomplete.</p>
    </section>
    <div class="layout">
      <section class="card" aria-labelledby="checker-heading">
        <h2 id="checker-heading">Project facts</h2>
        <p class="helper">Start with jurisdiction and utility. Then flag anything that may change permit or interconnection review.</p>
        <label for="locality">Jurisdiction / utility</label>
        <select id="locality" class="t-input" aria-describedby="locality-error">
          <option value="">Select a researched locality</option>
          {localityGroups.map((group) => <optgroup label={group.name}>{group.records.map((record) => <option value={record.id}>{record.city}, {record.state} · {record.utility ?? "Utility not verified"}</option>)}</optgroup>)}
        </select>
        <p class="gp-field-error" id="locality-error" role="alert"></p>
        <label for="project-type">Project type</label>
        <select id="project-type">
          <option value="new-pv">New rooftop PV</option>
          <option value="pv-storage">New PV + battery storage</option>
          <option value="battery-only">Battery added to an existing system</option>
          <option value="pv-expansion">Add PV to an existing system</option>
          <option value="revision">Equipment / design revision</option>
        </select>
        <label for="stage">Current stage</label>
        <select id="stage">
          <option value="planning">Planning / choosing path</option>
          <option value="permit">Permit application / correction</option>
          <option value="installation">Installation / design changed</option>
          <option value="inspection">AHJ inspection</option>
          <option value="interconnection">Utility interconnection</option>
          <option value="pto">Waiting for PTO</option>
        </select>
        <fieldset class="mods">
        <legend>Project modifiers</legend>
        <div class="checks">
          <label class="check"><input type="checkbox" id="battery" /> Battery / storage</label>
          <label class="check"><input type="checkbox" id="mpu" /> Main panel upgrade</label>
          <label class="check"><input type="checkbox" id="ground" /> Ground mount / canopy</label>
          <label class="check"><input type="checkbox" id="existing" /> Existing PV</label>
          <label class="check"><input type="checkbox" id="owner" /> Owner-builder / DIY</label>
          <label class="check"><input type="checkbox" id="equipment" /> Equipment changed from plans</label>
          <label class="check"><input type="checkbox" id="unpermitted" /> Existing unpermitted work</label>
        </div>
        </fieldset>
        <button class="button" id="check-path" type="button">Check permit path</button>
      </section>
      <section class="card" id="result-card" aria-labelledby="result-heading">
        <h2 id="result-heading" tabindex="-1">Verified path</h2>
        <p class="sr-only" role="status" id="result-announce"></p>
        <div id="result" class="t-panel-slide" data-open="true"><div class="result-empty">Select a locality and project facts to see the verified AHJ, utility path, known documents, fees, timeline and open questions.</div></div>
      </section>
    </div>
    <aside class="cta" aria-labelledby="organizer-cta-title"><h2 id="organizer-cta-title">Keep your solar project organized</h2><p class="helper">For homeowners comparing quotes and tracking permits, inspections and utility approval, the optional Solar Project Organizer includes a six-page fillable PDF and three editable CSV templates. It is a blank planning tool, not a permit research or filing service.</p><a href="/solar-project-organizer/" data-track-click="internal_resource_clicked">View the $9 Solar Project Organizer</a></aside>
    <p class="disclaimer">GridPermit is an informational research tool, not an AHJ, utility, engineering firm, electrical contractor or legal service. Always use the current official permit and interconnection instructions for the actual project. Technical electrical and structural decisions belong with the responsible authority and qualified professionals.</p>
  </main>
  <script is:inline>
    // Records embedded in the page (none in production) are used directly; every other
    // record is a small static JSON file fetched once, when its locality is chosen.
    let records = [];
    try {
      const embedded = JSON.parse(document.getElementById("permit-path-data")?.textContent || "[]");
      if (Array.isArray(embedded)) records = embedded;
    } catch {
      records = [];
    }
    const byId = new Map(records.map((record) => [record.id, record]));
    const $ = (id) => document.getElementById(id);
    const pending = new Map();
    const EMPTY_RESULT = $("result")?.innerHTML || "";
    const RECORD_TIMEOUT_MS = 10000;
    function loadRecord(id) {
      if (byId.has(id)) return Promise.resolve(byId.get(id));
      if (pending.has(id)) return pending.get(id);
      if (typeof fetch !== "function") return Promise.reject(new Error("Record loading is unavailable"));
      const controller = typeof AbortController === "function" ? new AbortController() : null;
      const timer = controller && typeof setTimeout === "function" ? setTimeout(() => controller.abort(), RECORD_TIMEOUT_MS) : null;
      const request = fetch(`/permit-path/records/${encodeURIComponent(id)}.json`, { headers: { Accept: "application/json" }, ...(controller ? { signal: controller.signal } : {}) })
        .then((response) => {
          if (!response.ok) throw new Error(`Record request failed (${response.status})`);
          return response.json();
        })
        .then((record) => {
          if (!record || record.id !== id) throw new Error("Unexpected record");
          byId.set(id, record);
          return record;
        })
        .finally(() => {
          if (timer !== null && typeof clearTimeout === "function") clearTimeout(timer);
          pending.delete(id);
        });
      pending.set(id, request);
      return request;
    }
    const checked = (id) => Boolean($(id)?.checked);
    const esc = (value) => String(value ?? "").replace(/[&<>'"]/g, (char) => ({"&":"&amp;","<":"&lt;",">":"&gt;","'":"&#39;",'"':"&quot;"}[char]));
    const safeUrl = (url) => (typeof url === "string" && /^https?:\/\//i.test(url) ? url : "");
    const link = (url, label) => safeUrl(url) ? `<a class="official" href="${esc(safeUrl(url))}" target="_blank" rel="noopener">${esc(label)} ↗</a>` : `<span class="muted">Official link not verified in this record.</span>`;
    const hasText = (items, pattern) => (items || []).some((item) => pattern.test(String(item)));

    function formatFee(fees) {
      if (!Array.isArray(fees) || !fees.length) return "Unknown from the current verified record.";
      return fees.map((fee) => {
        const amount = Number.isFinite(fee.amount_usd) ? `$${Number(fee.amount_usd).toLocaleString()}` : "amount not stated";
        return `${esc(fee.name || "Permit fee")}: ${amount}${fee.unit ? ` (${esc(fee.unit)})` : ""}`;
      }).join("<br>");
    }

    function formatTimeline(timeline) {
      if (!timeline) return "Unknown from the current verified record.";
      const min = Number.isFinite(timeline.min_days) ? timeline.min_days : null;
      const max = Number.isFinite(timeline.max_days) ? timeline.max_days : null;
      let range = "Timeline stated without a numeric range.";
      if (min !== null && max !== null) range = min === max ? `${min} day${min === 1 ? "" : "s"}` : `${min}–${max} days`;
      return `${esc(range)}${timeline.notes ? `<div class="muted">${esc(timeline.notes)}</div>` : ""}`;
    }

    // Only the flags auto-selected by project type are reset on a later type change.
    // Explicit user checkbox choices remain untouched.
    const autoSelected = new Set();
    ["battery", "existing", "equipment"].forEach((id) => {
      $(id)?.addEventListener("change", () => autoSelected.delete(id));
    });
    $("project-type")?.addEventListener("change", (event) => {
      for (const id of autoSelected) $(id).checked = false;
      autoSelected.clear();
      const value = event.target.value;
      const implied = [
        ...(["pv-storage", "battery-only"].includes(value) ? ["battery"] : []),
        ...(["battery-only", "pv-expansion"].includes(value) ? ["existing"] : []),
        ...(value === "revision" ? ["equipment"] : []),
      ];
      for (const id of implied) {
        if (!$(id).checked) {
          $(id).checked = true;
          autoSelected.add(id);
        }
      }
    });

    // Field-level validation: the message sits under the field that needs fixing (on a phone the
    // result panel is far below), the field is marked invalid and gets a short shake.
    const LOCALITY_REQUIRED = "Choose a researched locality first. If your city is not listed, GridPermit does not yet have a publishable locality record for it.";
    function showLocalityError() {
      const field = $("locality");
      const message = $("locality-error");
      if (message) message.textContent = LOCALITY_REQUIRED;
      field?.setAttribute?.("aria-invalid", "true");
      if (field?.classList) {
        field.classList.remove("is-shaking");
        void field.offsetWidth;
        field.classList.add("is-shaking");
        if (typeof setTimeout === "function") setTimeout(() => field.classList.remove("is-shaking"), 320);
      }
      field?.focus?.();
    }
    function clearLocalityError() {
      const message = $("locality-error");
      if (message) message.textContent = "";
      $("locality")?.setAttribute?.("aria-invalid", "false");
    }
    // Each check gets a sequence number; a later check or a new locality makes older responses stale.
    let checkSeq = 0;
    let prefetchTimer = null;
    $("locality")?.addEventListener?.("change", () => {
      clearLocalityError();
      checkSeq += 1;
      const result = $("result");
      if (result?.getAttribute?.("aria-busy") === "true") {
        result.removeAttribute?.("aria-busy");
        result.innerHTML = EMPTY_RESULT;
      }
      const id = $("locality")?.value;
      if (!id) return;
      // Keyboard arrowing fires change per option on some platforms: wait for the choice to settle.
      if (typeof setTimeout !== "function") {
        loadRecord(id).catch(() => {});
        return;
      }
      if (prefetchTimer !== null && typeof clearTimeout === "function") clearTimeout(prefetchTimer);
      prefetchTimer = setTimeout(() => {
        prefetchTimer = null;
        if ($("locality")?.value === id) loadRecord(id).catch(() => {});
      }, 250);
    });

    // Replays the transitions.dev panel reveal so an updated result is noticeable. Reduced-motion
    // users get the new content instantly (see the t-panel-slide guard in global.css).
    function replayReveal() {
      const panel = $("result");
      if (!panel?.style || !panel.dataset || !panel.classList) return;
      panel.classList.add("is-revealing");
      panel.style.transition = "none";
      panel.dataset.open = "false";
      void panel.offsetWidth;
      panel.style.transition = "";
      panel.dataset.open = "true";
      if (typeof setTimeout === "function") setTimeout(() => panel.classList.remove("is-revealing"), 450);
    }

    // Asks the site analytics wiring (src/components/Analytics.astro) to record a completed check.
    // Only categorical project facts are sent: never the locality, city or any free text.
    function reportCheck(params) {
      if (typeof CustomEvent !== "function" || typeof document.dispatchEvent !== "function") return;
      document.dispatchEvent(new CustomEvent("gridpermit:track", { detail: { name: "permit_path_checked", params } }));
    }

    // After a check, tell screen readers the verdict, move focus to the result heading and, when the
    // result sits below the form (single-column layout), scroll it into view. The page's scroll-padding
    // keeps it clear of the sticky header.
    function revealResult(announcement) {
      const card = $("result-card");
      const heading = card && card.querySelector ? card.querySelector("h2") : null;
      if (!heading) return;
      const live = $("result-announce");
      if (live) live.textContent = announcement;
      const media = (query) => typeof matchMedia === "function" && matchMedia(query).matches;
      if (media("(max-width: 820px)") && card.scrollIntoView) {
        card.scrollIntoView({ behavior: media("(prefers-reduced-motion: reduce)") ? "auto" : "smooth", block: "start" });
      }
      if (heading.focus) heading.focus({ preventScroll: true });
    }

    $("check-path")?.addEventListener("click", () => {
      const id = $("locality")?.value;
      if (!id) {
        // The alert states the problem next to the field; keep the user at the field they must fix.
        showLocalityError();
        return;
      }
      clearLocalityError();
      const token = ++checkSeq;
      const cached = byId.get(id);
      if (cached) {
        renderResult(cached);
        return;
      }
      const result = $("result");
      const live = $("result-announce");
      result?.setAttribute?.("aria-busy", "true");
      if (result) result.innerHTML = `<div class="result-empty">Loading the verified record for this locality…</div>`;
      if (live) live.textContent = "Loading the verified record.";
      loadRecord(id).then(
        (record) => {
          // A newer check or a different locality owns the panel now.
          if (token !== checkSeq) return;
          result?.removeAttribute?.("aria-busy");
          renderResult(record);
        },
        () => {
          if (token !== checkSeq) return;
          result?.removeAttribute?.("aria-busy");
          if (result) result.innerHTML = `<div class="status caution" role="alert">This locality record could not be loaded. Check your connection, then select Check permit path again.</div>`;
          if (live) live.textContent = "";
          replayReveal();
        },
      );
    });

    function renderResult(record) {
      const conditions = record.eligibility?.other_conditions || [];
      const program = record.eligibility?.program_or_pathway || "";
      const automatedPath = /solarapp|symbium|automated|instant/i.test(program);
      const blockers = [];
      const unknowns = [];
      const groundExcluded = hasText(conditions, /ground[- ]mount(?:ed)?[^.]*not allowed|no ground[- ]mount(?:ed)?/i);
      const existingPvExcluded = hasText(conditions, /\bno existing (?:pv|solar|photovoltaic)(?:\s+or\s+ess)?\b/i);
      if (checked("ground") && (groundExcluded || hasText(conditions, /roof[- ]mounted|rooftop/i))) blockers.push("The recorded automated pathway excludes the selected ground-mount/canopy scope; confirm the separate plan-review route with the AHJ.");
      if (checked("owner") && hasText(conditions, /licensed contractor/i)) blockers.push("The recorded pathway says licensed contractors are required; owner-builder/DIY eligibility is not established here.");
      if (checked("battery") && !hasText(conditions, /battery|storage|ess|bess/i) && !/battery|storage|ess|bess/i.test(program)) unknowns.push("Battery/storage eligibility is not established by this locality record.");
      if (checked("mpu") && !hasText(conditions, /main panel|mpu|service panel/i)) unknowns.push("Main-panel-upgrade treatment is not established by this locality record.");
      if (checked("existing") && existingPvExcluded) blockers.push("The recorded automated pathway excludes a property with existing PV or ESS. Ask the AHJ about the standard review path.");
      else if (checked("existing")) unknowns.push("Project-specific treatment of existing PV or system expansion is not established by this locality record.");
      if (checked("equipment")) unknowns.push("Equipment substitutions can affect approved plans and utility applications; this locality record does not establish whether this specific change needs a revision.");
      if (checked("unpermitted")) unknowns.push("The record does not establish how this AHJ treats existing unpermitted work. Resolve that with the AHJ before assuming the standard solar pathway applies.");
      const projectType = $("project-type")?.value || "new-pv";
      const stage = $("stage")?.value || "planning";
      if (stage === "pto") unknowns.push("A PTO delay cannot be diagnosed from locality rules alone. Verify the utility application number and dated milestones: interconnection submission, AHJ final, corrections, meter/utility inspection and PTO status.");
      if (stage === "inspection") unknowns.push("Inspection failures require the exact correction text and the approved plan set/as-built conditions; this checker does not infer a cause from anecdotes.");

      let statusClass = "caution";
      let statusText = "GridPermit has a verified local permit record, but an automated approval pathway is not established in this record.";
      if (automatedPath && blockers.length === 0) {
        if (unknowns.length === 0) statusClass = "good";
        statusText = "This locality has a recorded automated or expedited path for some projects. The selected project is not automatically confirmed eligible; verify the conditions with the AHJ.";
      }
      if (automatedPath && blockers.length) statusText = "This locality has a recorded automated or expedited path for some projects, but the selected facts conflict with at least one recorded pathway condition. Ask the AHJ about standard review.";

      const docs = Array.isArray(record.requiredDocuments) && record.requiredDocuments.length
        ? `<ul class="docs">${record.requiredDocuments.map((doc) => `<li>${esc(doc.name)}${doc.required_when ? ` <span class="muted">— ${esc(doc.required_when)}</span>` : ""}</li>`).join("")}</ul>`
        : `<span class="muted">Required documents are not verified in this record.</span>`;
      const condHtml = conditions.length ? `<ul class="docs">${conditions.map((condition) => `<li>${esc(condition)}</li>`).join("")}</ul>` : `<span class="muted">No project-level eligibility conditions are verified in this record.</span>`;
      const openItems = [...blockers, ...unknowns];
      const sourceHtml = (record.sources || []).slice(0, 8).map((source) => `<div class="source">${safeUrl(source.url) ? `<a href="${esc(safeUrl(source.url))}" target="_blank" rel="noopener">${esc(source.title)}</a>` : esc(source.title)} — ${esc(source.publisher || source.type || "official source")}${source.accessedDate ? ` · accessed ${esc(source.accessedDate)}` : ""}</div>`).join("") || `<span class="muted">No source list available.</span>`;
      const scopeParts = [projectType, checked("battery") && "battery", checked("mpu") && "MPU", checked("ground") && "ground mount/canopy", checked("existing") && "existing PV", checked("owner") && "owner-builder", checked("equipment") && "equipment change", checked("unpermitted") && "unpermitted work"].filter(Boolean);
      const helpUrl = `/project-help/?jurisdiction=${encodeURIComponent(`${record.city}, ${record.state}`)}&utility=${encodeURIComponent(record.utility || "")}&scope=${encodeURIComponent(scopeParts.join(", "))}&stage=${encodeURIComponent(stage)}&utm_source=permit_path_checker&utm_medium=owned&utm_campaign=decision_stage`;

      $("result").innerHTML = `
        <div class="status ${statusClass}">${esc(statusText)}</div>
        <div class="section"><h3>Permit authority</h3><div class="value">${esc(record.permitAuthority || "Unknown")}</div>${link(record.permitUrl, "Open official permit instructions")}</div>
        <div class="section"><h3>Utility / interconnection</h3><div class="value">${esc(record.utility || "Utility not verified")}</div>${link(record.interconnectionUrl, "Open official utility path")}</div>
        <div class="section"><h3>Recorded pathway / eligibility</h3><div class="value">${esc(program || "No specific automated pathway verified")}</div>${condHtml}</div>
        <div class="section"><h3>Known permit-package documents</h3>${docs}</div>
        <div class="section"><h3>Verified permit fees</h3>${formatFee(record.permitFees)}</div>
        <div class="section"><h3>Verified permit timeline</h3>${formatTimeline(record.timeline)}</div>
        <div class="section"><h3>What still needs project-specific verification</h3>${openItems.length ? `<ul class="unknowns">${openItems.map((item) => `<li>${esc(item)}</li>`).join("")}</ul>` : `<span class="muted">No additional blocker was identified from the selected facts, but project-level eligibility still must be confirmed from the current official instructions.</span>`}</div>
        <div class="section"><h3>Sources used by this locality record</h3><div class="sources">${sourceHtml}</div>${record.lastVerified ? `<div class="verified">Record last verified: ${esc(record.lastVerified)}</div>` : ""}</div>
        <div class="cta"><strong>Still ambiguous?</strong><p class="helper">Send the jurisdiction, utility, scope and exact correction/delay. Include dated milestones when the issue is inspection or PTO.</p><a href="${helpUrl}">Send project facts</a></div>
        <p class="pro-note">Installer or permit specialist checking many jurisdictions? GridPermit Pro is a proposed research tool that does not exist yet. We're asking whether it would help before we build it. <a href="/pro/">Read the proposal</a></p>`;
      replayReveal();
      revealResult(`${record.city}, ${record.state}: ${statusText}`);
      reportCheck({ stage, project_type: projectType, pathway: automatedPath ? "automated" : "standard", open_items: openItems.length });
    }
  </script>
<Footer />
</body>
</html>
