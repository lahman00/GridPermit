---
import DirectoryFilter from "../../components/DirectoryFilter.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import DesignHead from "../../components/DesignHead.astro";
// One combined index + guide-list page per non-California state (California
// keeps its own two pre-existing, already-indexed pages:
// src/pages/california/index.astro and
// src/pages/california/solar-permit-guides.astro — see
// src/lib/locality-guide.ts's stateGuidesIndexUrl). A new state starts with
// far fewer READY records than California, so one honest page beats two
// thin ones; see docs/DATA_ARCHITECTURE.md's multi-state section and the
// mission's own instruction not to manufacture pages with no real content.
//
// Entirely data-driven from output/*-evaluation.json + data/localities/*.json
// via buildLocalityIndexEntries, filtered to this page's own state — no
// city, utility, or supplier name is hardcoded here, matching
// src/pages/california/solar-permit-guides.astro's approach exactly.
import {
	SITE_ORIGIN,
	buildLocalityIndexEntries,
	buildBreadcrumbSchema,
	type LocalityRecord,
} from "../../lib/locality-guide";
import { STATE_META, SUPPORTED_STATE_CODES } from "../../lib/state-meta";
import Analytics from "../../components/Analytics.astro";

export async function getStaticPaths() {
	// California is excluded — it has its own dedicated static pages, not
	// this generic per-state template.
	return SUPPORTED_STATE_CODES.filter((code) => code !== "CA").map((code) => ({
		params: { state: STATE_META[code].slug },
		props: { stateCode: code },
	}));
}

const { stateCode } = Astro.props;
const stateInfo = STATE_META[stateCode];

const localityModules = import.meta.glob("../../../data/localities/*.json", { eager: true }) as Record<
	string,
	{ default: LocalityRecord & { record_id: string } }
>;
const recordsById = new Map(Object.values(localityModules).map((mod) => [mod.default.record_id, mod.default]));

const evaluationModules = import.meta.glob("../../../output/*-evaluation.json", { eager: true }) as Record<
	string,
	{ default: { records: Array<{ record_id: string; readiness: string; completeness_pct: number }> } }
>;
const allEvaluatedRecords = Object.values(evaluationModules).flatMap((mod) => mod.default.records);
const entries = buildLocalityIndexEntries(allEvaluatedRecords, recordsById).filter((e) => e.state === stateCode);

const lettersPresent = [...new Set(entries.map((e) => e.city[0]!.toUpperCase()))];

const PAGE_PATH = `/${stateInfo.slug}/`;
const CANONICAL_URL = `${SITE_ORIGIN}${PAGE_PATH}`;
const title = `${stateInfo.name} Solar Permit Guides by City | GridPermit`;
const description =
	`Source-linked, confidence-scored solar permitting guides by ${stateInfo.name} city: permit authority, required documents, fees, and eligibility.`;

const breadcrumbItems = [
	{ name: "Home", url: `${SITE_ORIGIN}/` },
	{ name: stateInfo.name, url: CANONICAL_URL },
];
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems);

const collectionSchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: title,
	description,
	url: CANONICAL_URL,
	mainEntity: {
		"@type": "ItemList",
		numberOfItems: entries.length,
		itemListElement: entries.map((entry, i) => ({
			"@type": "ListItem",
			position: i + 1,
			name: `${entry.city}, ${entry.state} Solar Permit Guide`,
			url: `${SITE_ORIGIN}${entry.guideUrl}`,
		})),
	},
};
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
	<Analytics />
	<DesignHead />
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={CANONICAL_URL} />

	<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
	<link rel="sitemap" href="/sitemap-index.xml" />

	<meta property="og:type" content="website" />
	<meta property="og:url" content={CANONICAL_URL} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />

	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	<script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
</head>
<body>
	<a href="#main-content" class="skip-link">Skip to main content</a>


	<Header />

	<div class="page-container">
		<nav class="breadcrumb-nav" aria-label="Breadcrumb">
			{breadcrumbItems.map((item, i) => (
				<>
					{i > 0 && <span class="crumb-sep">/</span>}
					{i === breadcrumbItems.length - 1
						? <span class="crumb-current">{item.name}</span>
						: <a href={item.url.replace(SITE_ORIGIN, "")}>{item.name}</a>}
				</>
			))}
		</nav>

		<main class="content-card" id="main-content" tabindex="-1">
			<h1>{stateInfo.name} Solar Permit Guides</h1>
			<p class="subtitle">City-by-city permitting facts, sourced and confidence-scored ({entries.length} {entries.length === 1 ? "city" : "cities"} currently listed)</p>
<DirectoryFilter />

			<form class="state-search-form" action="/search" method="get" role="search">
				<label for="state-search-input" class="visually-hidden">Search for a city, county, or utility in {stateInfo.name}</label>
				<input type="search" id="state-search-input" name="q" placeholder={`Search ${stateInfo.name} cities, counties, or utilities…`} autocomplete="off" />
				<button type="submit" class="gp-button">Search →</button>
			</form>

			<div class="trust-note">
				Only cities that clear GridPermit's verification threshold (see our <a href="/methodology#ready-criteria">READY criteria</a>) are listed. GridPermit is expanding state by state; more {stateInfo.name} cities are added as their official sources are verified.
			</div>

			{entries.length === 0 ? (
				<p class="empty-state">No {stateInfo.name} cities have cleared the verification threshold yet. Try the search above: we may have partial research on file, or a nearby city's utility may serve your area too. See our <a href="/permits/">full state-by-state coverage</a>.</p>
			) : (
				<>
					{lettersPresent.length > 1 && (
						<nav class="az-jump-nav" aria-label="Jump to city by first letter">
							{lettersPresent.map((letter) => (
								<a href={`#letter-${letter}`}>{letter}</a>
							))}
						</nav>
					)}

					<section>
						{lettersPresent.map((letter) => (
							<div class="letter-group">
								<h2 id={`letter-${letter}`} class="letter-heading">{letter}</h2>
								<div class="guide-grid">
									{entries.filter((entry) => entry.city[0]!.toUpperCase() === letter).map((entry) => (
										<a href={entry.guideUrl} class="guide-card" data-filter-text={[entry.city, entry.county, entry.utility, entry.generationSupplierName].filter(Boolean).join(" ")} data-track-click="permit_guide_clicked">
											<h3>{entry.city}</h3>
											<p class="card-field"><strong>Utility:</strong> {entry.utility}</p>
											{entry.generationSupplierName && (
												<p class="card-field"><strong>Generation supplier:</strong> {entry.generationSupplierName}</p>
											)}
											<p class="card-field"><strong>Completeness:</strong> {entry.completenessPct}%</p>
											<p class="card-field"><strong>Last verified:</strong> {entry.lastVerified}</p>
											<span class="card-link">View full guide →</span>
										</a>
									))}
								</div>
							</div>
						))}
					</section>
				</>
			)}

			<div class="footer-disclaimer">
				<p><strong>Disclaimers:</strong> This page is for informational purposes only and is not legal, engineering, financial, tax, or permit advice. GridPermit is not a solar installer, contractor, engineering firm, public utility, or government agency. Each city's guide links to its own official sources. Verify current requirements directly with the relevant permitting authority and utility before starting a project.</p>
				<p><a href="/methodology/">Methodology</a> · <a href="/how-it-works/">How It Works</a> · <a href="/">Back to GridPermit</a></p>
			</div>
		</main>
	</div>

	<Footer />

	<style>
		.state-search-form { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }.state-search-form input { flex: 1; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: 2px; font-size: 0.95rem; font-family: inherit; }.state-search-form input:focus { outline: 2px solid var(--primary); outline-offset: 1px; }.state-search-form button { background: var(--primary); color: var(--gp-ink); border: none; padding: 0.75rem 1.25rem; border-radius: 2px; font-weight: 700; font-size: 0.95rem; cursor: pointer; white-space: nowrap; }.state-search-form button:hover { background: var(--gp-accent); }
		@media (max-width: 480px) {.state-search-form { flex-direction: column; } }.trust-note { background: var(--gp-surface); border: 1px solid var(--gp-line); color: var(--gp-muted); border-radius: 2px; padding: 0.9rem 1.1rem; font-size: 0.88rem; margin-bottom: 1.75rem; }.empty-state { color: var(--text-muted); font-size: 0.95rem; padding: 1rem 0; }.az-jump-nav { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1.5rem; }.az-jump-nav a { display: flex; align-items: center; justify-content: center; width: 1.9rem; height: 1.9rem; background: var(--gp-surface); border: 1px solid var(--border-color); border-radius: 2px; color: var(--primary); text-decoration: none; font-size: 0.82rem; font-weight: 700; }.az-jump-nav a:hover, .az-jump-nav a:focus-visible { border-color: var(--primary); background: var(--gp-surface); }.letter-group { scroll-margin-top: 1rem; }.letter-group:first-of-type .letter-heading { margin-top: 0.5rem; }.card-field strong { color: var(--text-main); }
	</style>
</body>
</html>
