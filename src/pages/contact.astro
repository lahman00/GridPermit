---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import DesignHead from "../components/DesignHead.astro";
import Analytics from "../components/Analytics.astro";

const webPageSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	name: "Contact Us - GridPermit",
	description: "Get in touch with the GridPermit team for educational inquiries or methodology questions.",
	url: "https://mygridpermit.com/contact/",
};
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
	<Analytics />
	<DesignHead />
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Contact Us - GridPermit</title>
	<meta name="description" content="Get in touch with the GridPermit team for educational inquiries or methodology questions." />
	<link rel="canonical" href="https://mygridpermit.com/contact/" />
	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://mygridpermit.com/contact/" />
	<meta property="og:title" content="Contact Us - GridPermit" />
	<meta property="og:description" content="Get in touch with the GridPermit team for educational inquiries or methodology questions." />
	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content="Contact Us - GridPermit" />
	<meta name="twitter:description" content="Get in touch with the GridPermit team for educational inquiries or methodology questions." />
	<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
	<link rel="sitemap" href="/sitemap-index.xml" />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
	<style>.back-link { display: inline-block; margin-bottom: 1.5rem; color: var(--gp-accent); font-weight: 600; text-decoration: none; }.cross-links { font-size: 0.85rem; color: var(--gp-muted); margin-bottom: 1.5rem; }.cross-links a { color: var(--gp-accent); text-decoration: none; }
	</style>
</head>
<body>
<a href="#main-content" class="skip-link">Skip to main content</a>
<Header />
	<main class="gp-reading-page" id="main-content" tabindex="-1">
		<a href="/" class="back-link">← Back to Home</a>
		<p class="cross-links"><a href="/blog/">Blog</a> · <a href="/california/solar-permit-guides/">California Guides</a> · <a href="/about/">About</a> · <a href="/methodology/">Methodology</a></p>
		<h1>Contact GridPermit</h1>
		<p>GridPermit is an independent educational referral website. We do not sell or install solar equipment directly.</p>
		<p>For questions about our calculation methodology, general educational content, or privacy inquiries, contact us via email:</p>
		<p><strong>General Support:</strong> support@mygridpermit.com<br><strong>Privacy Inquiries:</strong> privacy@mygridpermit.com</p>
		<p><strong>Partnerships & integrations:</strong> review our <a href="/partners/" style="color: var(--gp-accent);">partner pilot page</a> or use the <a href="/partner-inquiry/" style="color: var(--gp-accent);">partner inquiry form</a>.</p>
		<p><strong>Found an outdated or inaccurate fact on a city guide?</strong> Email support@mygridpermit.com with the city name and the specific fact. Include a link to a current official source if you have one. We review every correction against the cited source (or a newer official source) and update or remove the fact rather than leave a known error live. See our <a href="/methodology#ready-criteria" style="color: var(--gp-accent);">methodology page</a> for how we verify and source city guide facts.</p>
	</main>
<Footer />
</body>
</html>
