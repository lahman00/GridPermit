---
import Analytics from "../components/Analytics.astro";
---
<!DOCTYPE html>
<html lang="en">
<head>
	<Analytics />
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Contact Us - GridPermit</title>
	<meta name="description" content="Get in touch with the GridPermit team for educational inquiries or methodology questions." />
	<link rel="canonical" href="https://mygridpermit.com/contact/" />
	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://mygridpermit.com/contact/" />
	<meta property="og:title" content="Contact Us - GridPermit" />
	<meta property="og:description" content="Get in touch with the GridPermit team for educational inquiries or methodology questions." />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" class="async-font-css">
	<noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"></noscript>
	<style>
		body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f8fafc; color: #0f172a; line-height: 1.6; padding: 2rem 1rem; }
		.container { max-width: 800px; margin: 0 auto; background: white; padding: 2.5rem; border-radius: 12px; border: 1px solid #e2e8f0; }
		h1 { font-size: 2rem; font-weight: 800; margin-bottom: 1rem; color: #0f172a; }
		p { font-size: 0.95rem; color: #475569; margin-bottom: 1rem; }
		.back-link { display: inline-block; margin-bottom: 1.5rem; color: #2563eb; font-weight: 600; text-decoration: none; }
		.cross-links { font-size: 0.85rem; color: #64748b; margin-bottom: 1.5rem; }
		.cross-links a { color: #2563eb; text-decoration: none; }
	</style>
</head>
<body>
	<main class="container">
		<a href="/" class="back-link">← Back to Calculator</a>
		<p class="cross-links"><a href="/blog">Blog</a> · <a href="/california/solar-permit-guides/">California Guides</a> · <a href="/about">About</a> · <a href="/methodology">Methodology</a></p>
		<h1>Contact GridPermit</h1>
		<p>GridPermit is an independent educational referral website. We do not sell or install solar equipment directly.</p>
		<p>For questions about our calculation methodology, general educational content, or privacy inquiries, contact us via email:</p>
		<p><strong>General Support:</strong> support@gridpermit.com<br><strong>Privacy Inquiries:</strong> privacy@gridpermit.com</p>
	</main>
</body>
</html>
