---
import DirectoryFilter from "../../components/DirectoryFilter.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import DesignHead from "../../components/DesignHead.astro";
// Public index of every READY locality guide. Entirely data-driven from
// output/pilot-evaluation.json + output/next-batch-evaluation.json
// (readiness, across every collected batch so far) and data/localities/*.json
// (city facts) via buildLocalityIndexEntries in src/lib/locality-guide.ts —
// no city, utility, or supplier name is hardcoded here. See
// docs/PILOT_EVALUATION.md Section 3/4 and docs/NEXT_BATCH_EVALUATION.md for
// what "READY" means per batch, and docs/LOCALITY_PAGE_FACTORY.md for how
// each linked guide itself is built.
import {
	SITE_ORIGIN,
	buildLocalityIndexEntries,
	buildBreadcrumbSchema,
	type LocalityRecord,
} from "../../lib/locality-guide";
import Analytics from "../../components/Analytics.astro";

const localityModules = import.meta.glob("../../../data/localities/*.json", { eager: true }) as Record<
	string,
	{ default: LocalityRecord & { record_id: string } }
>;
const recordsById = new Map(
	Object.values(localityModules).map((mod) => [mod.default.record_id, mod.default]),
);

// Combine every evaluation run's records — each batch tracks readiness for
// only its own targets, so the union across all of them is the current
// full picture. buildLocalityIndexEntries only reads
// {record_id, readiness, completeness_pct} and doesn't care which file a
// given entry came from. Loaded via glob (rather than one hardcoded import
// per batch) so a new batch's evaluation file is picked up automatically —
// no wiring step to forget here.
const evaluationModules = import.meta.glob("../../../output/*-evaluation.json", { eager: true }) as Record<
	string,
	{ default: { records: Array<{ record_id: string; readiness: string; completeness_pct: number }> } }
>;
const allEvaluatedRecords = Object.values(evaluationModules).flatMap((mod) => mod.default.records);
// Scoped to CA only — buildLocalityIndexEntries itself returns every READY
// record sitewide (that's what powers a true cross-state index); this page
// is California-specific, so it must filter down the same way
// src/pages/[state]/index.astro does for every other state.
const entries = buildLocalityIndexEntries(allEvaluatedRecords, recordsById).filter((e) => e.state === "CA");

// Letters actually present in this dataset, in order — used for both the
// jump nav and the section headings below. Never a hardcoded A-Z list, so a
// letter with zero current cities (there is no California city starting
// with certain letters) never renders an empty, dead jump-nav entry.
const lettersPresent = [...new Set(entries.map((e) => e.city[0]!.toUpperCase()))];

const PAGE_PATH = "/california/solar-permit-guides/";
const CANONICAL_URL = `${SITE_ORIGIN}${PAGE_PATH}`;
const title = "California Solar Permit Guides by City | GridPermit";
const description =
	"Source-linked, confidence-scored solar permitting guides by California city: permit authority, required documents, fees, and eligibility.";

const breadcrumbItems = [
	{ name: "Home", url: `${SITE_ORIGIN}/` },
	{ name: "California", url: `${SITE_ORIGIN}/california/` },
	{ name: "Solar Permit Guides", url: CANONICAL_URL },
];
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems);

// CollectionPage + ItemList — this page's entire purpose is to list every
// verified city guide, so both schema types are a direct, accurate match
// (not added speculatively). itemListElement uses each entry's own already-
// verified guideUrl; nothing here is a separate, possibly-stale copy of it.
const collectionSchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: title,
	description,
	url: CANONICAL_URL,
	mainEntity: {
		"@type": "ItemList",
		numberOfItems: entries.length,
		itemListElement: entries.map((entry, i) => ({
			"@type": "ListItem",
			position: i + 1,
			name: `${entry.city} Solar Permit Guide`,
			url: `${SITE_ORIGIN}${entry.guideUrl}`,
		})),
	},
};
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
	<Analytics />
	<DesignHead />
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={CANONICAL_URL} />

	<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
	<link rel="sitemap" href="/sitemap-index.xml" />

	<!-- Open Graph -->
	<meta property="og:type" content="website" />
	<meta property="og:url" content={CANONICAL_URL} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />

	<!-- Twitter -->
	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	<script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
</head>
<body>
	<a href="#main-content" class="skip-link">Skip to main content</a>


	<Header />

	<div class="page-container">
		<nav class="breadcrumb-nav" aria-label="Breadcrumb">
			{breadcrumbItems.map((item, i) => (
				<>
					{i > 0 && <span class="crumb-sep">/</span>}
					{i === breadcrumbItems.length - 1
						? <span class="crumb-current">{item.name}</span>
						: <a href={item.url.replace(SITE_ORIGIN, "")}>{item.name}</a>}
				</>
			))}
		</nav>

		<main class="content-card" id="main-content" tabindex="-1">
			<h1>California Solar Permit Guides</h1>
			<p class="subtitle">City-by-city permitting facts, sourced and confidence-scored ({entries.length} {entries.length === 1 ? "city" : "cities"} currently listed)</p>
<DirectoryFilter />

			<div class="trust-note">
				Only cities that clear GridPermit's verification threshold (see our <a href="/methodology#ready-criteria">READY criteria</a>) are listed.
			</div>

			{lettersPresent.length > 1 && (
				<nav class="az-jump-nav" aria-label="Jump to city by first letter">
					{lettersPresent.map((letter) => (
						<a href={`#letter-${letter}`}>{letter}</a>
					))}
				</nav>
			)}

			<section>
				{lettersPresent.map((letter) => (
					<div class="letter-group">
						<h2 id={`letter-${letter}`} class="letter-heading">{letter}</h2>
						<div class="guide-grid">
							{entries.filter((entry) => entry.city[0]!.toUpperCase() === letter).map((entry) => (
								<a href={entry.guideUrl} class="guide-card" data-filter-text={[entry.city, entry.county, entry.utility, entry.generationSupplierName].filter(Boolean).join(" ")} data-track-click="permit_guide_clicked">
									<h3>{entry.city}</h3>
									<p class="card-field"><strong>Utility:</strong> {entry.utility}</p>
									{entry.generationSupplierName && (
										<p class="card-field"><strong>Generation supplier:</strong> {entry.generationSupplierName}</p>
									)}
									<p class="card-field"><strong>Completeness:</strong> {entry.completenessPct}%</p>
									<p class="card-field"><strong>Last verified:</strong> {entry.lastVerified}</p>
									<span class="card-link">View full guide →</span>
								</a>
							))}
						</div>
					</div>
				))}
			</section>

			<div class="footer-disclaimer">
				<p><strong>Disclaimers:</strong> This page is for informational purposes only and is not legal, engineering, financial, tax, or permit advice. GridPermit is not a solar installer, contractor, engineering firm, public utility, or government agency. Each city's guide links to its own official sources. Verify current requirements directly with the relevant permitting authority and utility before starting a project.</p>
				<p><a href="/methodology/">Methodology</a> · <a href="/how-it-works/">How It Works</a> · <a href="/">Back to GridPermit</a></p>
			</div>
		</main>
	</div>

	<Footer />

	<style>
		.trust-note { background: var(--gp-surface); border: 1px solid var(--gp-line); color: var(--gp-muted); border-radius: 2px; padding: 0.9rem 1.1rem; font-size: 0.88rem; margin-bottom: 1.75rem; }.az-jump-nav { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1.5rem; }.az-jump-nav a { display: flex; align-items: center; justify-content: center; width: 1.9rem; height: 1.9rem; background: var(--gp-surface); border: 1px solid var(--border-color); border-radius: 2px; color: var(--primary); text-decoration: none; font-size: 0.82rem; font-weight: 700; }.az-jump-nav a:hover, .az-jump-nav a:focus-visible { border-color: var(--primary); background: var(--gp-surface); }.letter-group { scroll-margin-top: 1rem; }.letter-group:first-of-type .letter-heading { margin-top: 0.5rem; }.card-field strong { color: var(--text-main); }
	</style>
</body>
</html>
