---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import DesignHead from "../../components/DesignHead.astro";
import Analytics from "../../components/Analytics.astro";
// Statewide, citable dataset view of every published California city guide.
// Every cell is copied from that city's own verified record by
// src/lib/permit-data-study.ts; nothing is estimated, averaged or inferred.
// The CSV at /california/solar-permit-data.csv is generated from the same
// rows, so the table, the download and the counts cannot drift apart.
import { SITE_ORIGIN, buildBreadcrumbSchema, type LocalityRecord } from "../../lib/locality-guide";
import {
	PERMIT_DATA_CSV_PATH,
	PERMIT_DATA_PATH,
	buildPermitDataRows,
	formatFee,
	percentOf,
	summarizePermitData,
} from "../../lib/permit-data-study";

const localityModules = import.meta.glob("../../../data/localities/*.json", { eager: true }) as Record<
	string,
	{ default: LocalityRecord & { record_id: string } }
>;
const recordsById = new Map(Object.values(localityModules).map((mod) => [mod.default.record_id, mod.default]));
const evaluationModules = import.meta.glob("../../../output/*-evaluation.json", { eager: true }) as Record<
	string,
	{ default: { records: Array<{ record_id: string; readiness: string; completeness_pct: number }> } }
>;
const allEvaluatedRecords = Object.values(evaluationModules).flatMap((mod) => mod.default.records);
const rows = buildPermitDataRows(allEvaluatedRecords, recordsById, "CA");
const summary = summarizePermitData(rows);

const CANONICAL_URL = `${SITE_ORIGIN}${PERMIT_DATA_PATH}`;
const CSV_URL = `${SITE_ORIGIN}${PERMIT_DATA_CSV_PATH}`;
const LICENSE_URL = "https://creativecommons.org/licenses/by/4.0/";
const title = "California Solar Permit Data by City (2026) | GridPermit";
const description =
	`Permit office, SolarAPP+ or Symbium path, utility and published fees for ${summary.total} California cities, ` +
	`each linked to its official source. Free CSV download.`;

const monthYear = (iso: string | null) =>
	iso ? new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" }) : "";
const checkedRange =
	monthYear(summary.verifiedFrom) === monthYear(summary.verifiedTo)
		? monthYear(summary.verifiedTo)
		: `${monthYear(summary.verifiedFrom)} to ${monthYear(summary.verifiedTo)}`;
const topUtilities = summary.utilities.slice(0, 3);
const otherUtilityCount = summary.total - topUtilities.reduce((sum, u) => sum + u.count, 0);
const utilityOptions = summary.utilities.map((u) => u.name);

const breadcrumbItems = [
	{ name: "Home", url: `${SITE_ORIGIN}/` },
	{ name: "California", url: `${SITE_ORIGIN}/california/` },
	{ name: "Permit Data", url: CANONICAL_URL },
];
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems);

const datasetSchema = {
	"@context": "https://schema.org",
	"@type": "Dataset",
	name: "California residential solar permit data by city",
	description:
		`One row per California city with a published GridPermit guide (${summary.total} cities): the permit office, ` +
		"whether the city's own page records an automated or instant residential solar permit path (SolarAPP+, Symbium or another platform), " +
		"the interconnection utility, any published permit or interconnection fee amount, the date the record was last verified, " +
		"and the official permit page. Every value is copied from a source-linked city record; blank values mean the fact is not in the record.",
	url: CANONICAL_URL,
	keywords: ["solar permit", "California", "SolarAPP+", "Symbium", "automated permitting", "interconnection", "permit fees"],
	license: LICENSE_URL,
	isAccessibleForFree: true,
	creator: { "@type": "Organization", name: "GridPermit", url: `${SITE_ORIGIN}/` },
	publisher: { "@type": "Organization", name: "GridPermit", url: `${SITE_ORIGIN}/` },
	spatialCoverage: { "@type": "Place", name: "California, United States" },
	temporalCoverage: summary.verifiedFrom && summary.verifiedTo ? `${summary.verifiedFrom}/${summary.verifiedTo}` : undefined,
	dateModified: summary.verifiedTo ?? undefined,
	variableMeasured: [
		"Permit office",
		"Automated permit path recorded",
		"Interconnection utility",
		"Published fee amounts",
		"Last verified date",
	],
	distribution: [{ "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: CSV_URL }],
};

const faqs = [
	{
		q: "How many California cities offer SolarAPP+ or another automated solar permit?",
		a:
			`Of the ${summary.total} California cities with a published GridPermit guide, ${summary.automated} (${percentOf(summary.automated, summary.total)}%) ` +
			`have a recorded automated or instant residential permit path on the city's own pages: ${summary.byKind["SolarAPP+"]} SolarAPP+, ` +
			`${summary.byKind.Symbium} Symbium and ${summary.byKind["Other automated"]} another platform. Eligibility is limited to qualifying projects, ` +
			"and a city without a recorded path may still offer one; check the city's guide and official page.",
	},
	{
		q: "Does an automated permit mean utility approval?",
		a: "No. The city building permit and the utility's interconnection approval (permission to operate) are separate steps. The utility column shows who handles interconnection for that city.",
	},
	{
		q: "Can I reuse this data?",
		a: "Yes. The table and CSV are free to reuse under CC BY 4.0 with attribution to GridPermit and a link to this page. Re-check the official source before relying on any value for a real project.",
	},
];
const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
	<Analytics />
	<DesignHead />
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={CANONICAL_URL} />
	<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
	<link rel="sitemap" href="/sitemap-index.xml" />
	<link rel="alternate" type="text/csv" href={PERMIT_DATA_CSV_PATH} title="California solar permit data (CSV)" />

	<meta property="og:type" content="website" />
	<meta property="og:url" content={CANONICAL_URL} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	<script is:inline type="application/ld+json" set:html={JSON.stringify(datasetSchema)} />
	<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</head>
<body>
	<a href="#main-content" class="skip-link">Skip to main content</a>

	<Header />

	<div class="page-container">
		<nav class="breadcrumb-nav" aria-label="Breadcrumb">
			{breadcrumbItems.map((item, i) => (
				<>
					{i > 0 && <span class="crumb-sep">/</span>}
					{i === breadcrumbItems.length - 1
						? <span class="crumb-current">{item.name}</span>
						: <a href={item.url.replace(SITE_ORIGIN, "")}>{item.name}</a>}
				</>
			))}
		</nav>

		<div class="layout-grid">
		<main class="content-card" id="main-content" tabindex="-1">
			<span class="gp-kicker">Open data · California</span>
			<h1>California Solar Permit Data by City</h1>
			<p class="subtitle">
				Permit office, automated permit path, utility and published fees for {summary.total} California cities,
				copied from each city's source-linked GridPermit record. Records checked {checkedRange}.
			</p>

			<div class="data-stats" role="list">
				<div class="data-stat" role="listitem">
					<strong>{summary.automated} of {summary.total}</strong>
					<span>cities record an automated or instant residential permit path ({percentOf(summary.automated, summary.total)}%)</span>
				</div>
				<div class="data-stat" role="listitem">
					<strong>{summary.byKind["SolarAPP+"]} SolarAPP+ · {summary.byKind.Symbium} Symbium</strong>
					<span>{summary.byKind["Other automated"]} use another platform</span>
				</div>
				<div class="data-stat" role="listitem">
					<strong>{summary.withPublishedFee} cities</strong>
					<span>have a published permit or interconnection fee amount in the record</span>
				</div>
				<div class="data-stat" role="listitem">
					<strong>{topUtilities.map((u) => `${u.name} ${u.count}`).join(" · ")}</strong>
					<span>interconnection utility; {otherUtilityCount} cities are served by other utilities</span>
				</div>
			</div>

			<p class="data-actions">
				<a class="button primary" href={PERMIT_DATA_CSV_PATH} download="gridpermit-california-solar-permit-data.csv" data-track-click="permit_data_downloaded">Download CSV ({summary.total} rows)</a>
				<a class="button secondary" href="/permit-path/">Check one project with the free checker</a>
			</p>

			<div class="disclaimer-box">
				<strong>How to read this table.</strong> A value appears only if the city's verified record states it. A blank cell means
				the fact is not in our record, not that the city lacks it. An automated path covers qualifying projects only, and the
				utility's interconnection approval is always a separate step. Re-check the official page before relying on any value.
			</div>

			<section id="data" aria-labelledby="data-heading">
				<h2 id="data-heading">All {summary.total} cities</h2>
				<form class="data-filters" id="data-filters" role="search" aria-label="Filter the city table">
					<label>
						<span>City or county</span>
						<input type="search" id="filter-text" autocomplete="off" placeholder="e.g. Fresno" />
					</label>
					<label>
						<span>Automated path</span>
						<select id="filter-path">
							<option value="">Any</option>
							<option value="SolarAPP+">SolarAPP+</option>
							<option value="Symbium">Symbium</option>
							<option value="Other automated">Other automated</option>
							<option value="none">None recorded</option>
						</select>
					</label>
					<label>
						<span>Utility</span>
						<select id="filter-utility">
							<option value="">Any</option>
							{utilityOptions.map((name) => <option value={name}>{name}</option>)}
						</select>
					</label>
				</form>
				<p class="data-count" id="data-count" aria-live="polite">Showing all {summary.total} cities.</p>

				<div class="data-table-wrap" tabindex="0" role="region" aria-labelledby="data-heading">
					<table class="data-table" id="data-table">
						<caption class="sr-only">California solar permit data by city. Columns: city, county, permit office, automated path, utility, published fees, last verified.</caption>
						<thead>
							<tr>
								<th scope="col">City</th>
								<th scope="col">County</th>
								<th scope="col">Permit office</th>
								<th scope="col">Automated path</th>
								<th scope="col">Utility</th>
								<th scope="col">Published fees</th>
								<th scope="col">Checked</th>
							</tr>
						</thead>
						<tbody>
							{rows.map((row) => (
								<tr data-search={`${row.city} ${row.county ?? ""}`.toLowerCase()} data-path={row.automatedKind ?? "none"} data-utility={row.utility ?? ""}>
									<th scope="row"><a href={row.guideUrl}>{row.city}</a></th>
									<td>{row.county ?? ""}</td>
									<td>{row.permitUrl && row.permitAuthority ? <a href={row.permitUrl} rel="noopener">{row.permitAuthority}</a> : row.permitAuthority ?? ""}</td>
									<td>{row.automatedKind ?? ""}</td>
									<td>{row.utility ?? ""}</td>
									<td>{row.fees.length ? row.fees.map((fee) => <span class="fee">{formatFee(fee)}</span>) : ""}</td>
									<td><time datetime={row.lastVerified}>{row.lastVerified}</time></td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>

			<section id="methodology">
				<h2>Method and limits</h2>
				<ul class="fact-list">
					<li><strong>Scope:</strong> every California city with a published GridPermit guide. Cities without a guide yet are not in the table.</li>
					<li><strong>Automated path:</strong> the record's permit pathway names SolarAPP+, Symbium, or an automated, instant or real-time permit process on the city's own pages. It is the same rule the <a href="/permit-path/">Permit Path checker</a> uses. The CSV includes the pathway text as recorded and the record's confidence score.</li>
					<li><strong>Published fees:</strong> dollar amounts stated on an official page and recorded with a confidence of at least 0.7. Fee names and units are kept as recorded; some are utility interconnection fees rather than city permit fees. Amounts are not totals and can change.</li>
					<li><strong>Utility:</strong> the distribution utility that handles interconnection and permission to operate for the city, as recorded.</li>
					<li><strong>Checked:</strong> the date the city's record was last verified against its sources. Each city guide lists every source.</li>
				</ul>
				<p>See <a href="/methodology/">GridPermit's methodology</a> for how records are researched and scored.</p>
			</section>

			<section id="cite">
				<h2>Reuse and citation</h2>
				<p>The table and the <a href={PERMIT_DATA_CSV_PATH}>CSV download</a> are free to reuse under <a href={LICENSE_URL} rel="license noopener">CC BY 4.0</a>. Please credit GridPermit and link to this page:</p>
				<p class="cite-line">GridPermit. <em>California Solar Permit Data by City</em>. {CANONICAL_URL} (records checked {checkedRange}).</p>
				<p>Found a value that changed? <a href="/contact/">Tell us</a> and we will re-check the official source.</p>
			</section>

			<section id="faq">
				<h2>Frequently Asked Questions</h2>
				{faqs.map((f) => (
					<details class="faq-item" data-track-toggle="faq_expanded">
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))}
			</section>

			<div class="footer-disclaimer">
				<p><strong>Disclaimers:</strong> This page is for informational purposes only and is not legal, engineering, financial, tax, or permit advice. GridPermit is not a solar installer, contractor, utility or government agency. Always confirm requirements with the city and the utility.</p>
				<p><a href="/california/">California Solar Permit Guide</a> · <a href="/california/solar-permit-guides/">All California Guides</a> · <a href="/california/solar-permit-timeline/">Permit timelines</a> · <a href="/methodology/">Methodology</a></p>
			</div>
		</main>
		</div>
	</div>

	<Footer />

	<script is:inline>
		(() => {
			const form = document.getElementById("data-filters");
			const text = document.getElementById("filter-text");
			const path = document.getElementById("filter-path");
			const utility = document.getElementById("filter-utility");
			const count = document.getElementById("data-count");
			const rows = Array.from(document.querySelectorAll("#data-table tbody tr"));
			if (!text || !path || !utility || !count || !rows.length) return;
			const total = rows.length;
			let timer = 0;
			const apply = () => {
				const q = text.value.trim().toLowerCase();
				const p = path.value;
				const u = utility.value;
				let shown = 0;
				for (const row of rows) {
					const match =
						(!q || (row.getAttribute("data-search") || "").includes(q)) &&
						(!p || row.getAttribute("data-path") === p) &&
						(!u || row.getAttribute("data-utility") === u);
					row.hidden = !match;
					if (match) shown += 1;
				}
				count.textContent = shown === total ? `Showing all ${total} cities.` : `Showing ${shown} of ${total} cities.`;
			};
			if (form) form.addEventListener("submit", (event) => { event.preventDefault(); apply(); });
			text.addEventListener("input", () => { window.clearTimeout(timer); timer = window.setTimeout(apply, 150); });
			path.addEventListener("change", apply);
			utility.addEventListener("change", apply);
		})();
	</script>

	<style>
		.data-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: var(--gp-space-2); margin: 0 0 var(--gp-space-4); }
		.data-stat { border: 1px solid var(--gp-line); background: var(--gp-surface); padding: var(--gp-space-2) var(--gp-space-3); border-radius: 2px; display: flex; flex-direction: column; gap: var(--gp-space-1); }
		.data-stat strong { font-size: 18px; line-height: 1.35; }
		.data-stat span { color: var(--gp-muted); font-size: 14px; line-height: 1.5; }
		.data-actions { display: flex; flex-wrap: wrap; gap: var(--gp-space-2); margin: 0 0 var(--gp-space-4); }
		.disclaimer-box { background: var(--gp-surface); border: 1px solid var(--gp-line); color: var(--gp-muted); border-radius: 2px; padding: var(--gp-space-2) var(--gp-space-3); font-size: 15px; line-height: 1.6; }
		.data-filters { display: flex; flex-wrap: wrap; gap: var(--gp-space-2); margin: 0 0 var(--gp-space-2); }
		.data-filters label { display: flex; flex-direction: column; gap: var(--gp-space-half); font-size: 13px; color: var(--gp-muted); min-width: 180px; flex: 1 1 180px; }
		.data-filters input, .data-filters select { min-height: 44px; font: inherit; font-size: 16px; color: var(--gp-ink); background: var(--gp-bg, transparent); border: 1px solid var(--gp-line); border-radius: 2px; padding: 8px 10px; }
		.data-count { color: var(--gp-muted); font-size: 14px; margin: 0 0 var(--gp-space-2); }
		.data-table-wrap { max-width: 100%; overflow-x: auto; border: 1px solid var(--gp-line); }
		.data-table-wrap:focus-visible { outline: 2px solid var(--gp-accent); outline-offset: 2px; }
		.data-table { min-width: 860px; font-size: 14px; }
		.data-table th, .data-table td { padding: 10px 12px; }
		.data-table tbody th { font-size: 14px; letter-spacing: 0; text-transform: none; color: var(--gp-ink); font-weight: 500; }
		.data-table time { white-space: nowrap; }
		.data-table .fee { display: block; }
		.data-table .fee + .fee { margin-top: 4px; }
		.cite-line { font-family: var(--gp-mono); font-size: 13px; background: var(--gp-surface); border: 1px solid var(--gp-line); padding: var(--gp-space-2); overflow-wrap: anywhere; }
		@media print {
			.data-filters, .data-actions { display: none; }
			.data-table-wrap { overflow: visible; border: 0; }
			.data-table { min-width: 0; font-size: 9pt; }
		}
	</style>
</body>
</html>
