---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import DesignHead from "../../components/DesignHead.astro";
// The statewide authority hub — the top of GridPermit's topical
// architecture (Home > California > city guide / topic guide). Explains
// the California solar permitting framework in general (permit vs.
// interconnection, SolarAPP+, inspections, batteries, how GridPermit
// verifies data) using only well-established, broadly-sourced facts —
// nothing here is locality-specific, so nothing here should ever
// contradict an individual city's guide. City-specific facts belong on
// the city's own guide page, never here.
//
// Replaces what was previously a bare 301 redirect to
// /california/solar-permit-guides/ (see netlify.toml) — every locality
// page's breadcrumb already links "California" to this exact path, so
// this page turning real removes a redirect hop on all of them at once.
import {
	SITE_ORIGIN,
	buildLocalityIndexEntries,
	buildBreadcrumbSchema,
	utilityShortName,
	type LocalityRecord,
} from "../../lib/locality-guide";
import { buildCountyHubs, type ReadyEvaluationSummary } from "../../lib/county-hub";
import { buildUtilityHubs } from "../../lib/utility-hub";
import Analytics from "../../components/Analytics.astro";

const localityModules = import.meta.glob("../../../data/localities/*.json", { eager: true }) as Record<
	string,
	{ default: LocalityRecord & { record_id: string } }
>;
const recordsById = new Map(
	Object.values(localityModules).map((mod) => [mod.default.record_id, mod.default]),
);
const evaluationModules = import.meta.glob("../../../output/*-evaluation.json", { eager: true }) as Record<
	string,
	{ default: { records: Array<{ record_id: string; readiness: string; completeness_pct: number }> } }
>;
const allEvaluatedRecords = Object.values(evaluationModules).flatMap((mod) => mod.default.records);
// Scoped to CA only — buildLocalityIndexEntries itself returns every READY
// record sitewide; this page is California-specific, so its stats and
// links must not include other states' counties/utilities/cities.
const entries = buildLocalityIndexEntries(allEvaluatedRecords, recordsById).filter((e) => e.state === "CA");

// Derived stats — always computed from the live dataset, never hardcoded,
// so this page can't drift out of sync with what's actually published.
const countyCount = new Set(
	entries.map((e) => recordsById.get(e.recordId)?.county?.value).filter(Boolean),
).size;
// Deduped by short name ("PG&E"), not the raw utility string — this
// dataset has more than one full-name spelling on file for PG&E (see
// buildRelatedLocalities in src/lib/locality-guide.ts for the same fix
// applied to related-locality matching), which would otherwise overcount.
const utilityCount = new Set(entries.map((e) => utilityShortName(e.utility)).filter(Boolean)).size;

// buildCountyHubs/buildUtilityHubs key each hub by state+county /
// state+utility internally, so the array itself covers every state — filter
// down to CA's own hubs before rendering them on this CA-specific page.
const countyHubs = buildCountyHubs(allEvaluatedRecords as ReadyEvaluationSummary[], recordsById).filter(
	(h) => h.state === "CA",
);
const utilityHubs = buildUtilityHubs(allEvaluatedRecords as ReadyEvaluationSummary[], recordsById).filter(
	(h) => h.state === "CA",
);

const PAGE_PATH = "/california/";
const CANONICAL_URL = `${SITE_ORIGIN}${PAGE_PATH}`;
const title = "California Solar Permit Guide | GridPermit";
const description =
	"How California residential solar permitting works: permit authority vs. utility interconnection, SolarAPP+, inspections, and batteries — plus city guides.";

const breadcrumbItems = [
	{ name: "Home", url: `${SITE_ORIGIN}/` },
	{ name: "California", url: CANONICAL_URL },
];
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems);

const webPageSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	name: title,
	description,
	url: CANONICAL_URL,
	isPartOf: { "@type": "WebSite", name: "GridPermit", url: `${SITE_ORIGIN}/` },
};

const faqs = [
	{
		q: "Is a solar permit the same thing as utility interconnection approval?",
		a: "No. A building/electrical permit (issued by your city or county building department) confirms your installation meets construction and safety codes. Interconnection approval (issued by your electric utility) confirms it's safe to connect to the grid and sets your billing arrangement. Most homeowners need both, from two different agencies, and they're reviewed on separate timelines.",
	},
	{
		q: "What is SolarAPP+?",
		a: "SolarAPP+ (Solar Automated Permit Processing) is a free, NREL-developed online platform that many California cities and counties use to instantly review and approve eligible small residential rooftop solar (and increasingly battery) permit applications against code requirements, without a manual plan-check queue. Not every city uses it, and not every project qualifies even where it's offered — each city guide on this site states what we've verified about that city's specific process.",
	},
	{
		q: "Does every California city permit solar the same way?",
		a: "No. California law (including the Solar Rights Act and Government Code §65850.5) requires cities to offer an expedited, standardized process for small residential rooftop solar, but each city still runs its own permitting department, sets its own fees, and decides which platform (SolarAPP+, a different portal, or paper) it uses. Some cities also contract their building department out to their county. This is why GridPermit verifies each city individually rather than describing one statewide process.",
	},
	{
		q: "What does GridPermit's confidence score mean?",
		a: "Every fact on a city guide page is labeled High, Medium, or Low confidence based on how directly its cited source supports it — for example, a fact stated explicitly on a city's own current webpage is High confidence; a fact inferred from an older document or a source that couldn't be independently re-confirmed is Medium or Low. See our methodology page for the exact rule.",
	},
];
const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((f) => ({
		"@type": "Question",
		name: f.q,
		acceptedAnswer: { "@type": "Answer", text: f.a },
	})),
};
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
	<Analytics />
	<DesignHead />
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={CANONICAL_URL} />
	<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
	<link rel="sitemap" href="/sitemap-index.xml" />

	<meta property="og:type" content="website" />
	<meta property="og:url" content={CANONICAL_URL} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	<script is:inline type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
	<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</head>
<body>
	<a href="#main-content" class="skip-link">Skip to main content</a>


	<Header />

	<div class="page-container">
		<nav class="breadcrumb-nav" aria-label="Breadcrumb">
			{breadcrumbItems.map((item, i) => (
				<>
					{i > 0 && <span class="crumb-sep">/</span>}
					{i === breadcrumbItems.length - 1
						? <span class="crumb-current">{item.name}</span>
						: <a href={item.url.replace(SITE_ORIGIN, "")}>{item.name}</a>}
				</>
			))}
		</nav>

		<div class="layout-grid">
		<main class="content-card" id="main-content" tabindex="-1">
			<h1>California Solar Permit Guide</h1>
			<p class="subtitle">How residential solar permitting works in California, and how to find your city's verified requirements</p>

			<div class="stats-row">
				<div class="stat-pill"><strong>{entries.length}</strong> verified cities</div>
				<div class="stat-pill"><strong>{countyCount}</strong> counties</div>
				<div class="stat-pill"><strong>{utilityCount}</strong> utilities</div>
			</div>

			<div class="disclaimer-box">
				<strong>Informational only.</strong> This page describes the general California framework, not any one city's rules. It is not legal, engineering, or permit advice. Always confirm current requirements with your specific city/county and utility.
			</div>

			<section id="permit-vs-interconnection">
				<h2>Two separate approvals: permit and interconnection</h2>
				<p>Installing residential solar in California almost always requires clearing two independent processes, run by two different organizations:</p>
				<ul class="fact-list">
					<li><strong>Building/electrical permit</strong>: issued by your city or county's building department (sometimes contracted out to the county, or in a few cities, to a state-chartered municipal utility's own permitting office). This confirms the installation meets structural, electrical, and fire-safety code.</li>
					<li><strong>Utility interconnection approval</strong>: issued by your electric utility (an investor-owned utility like PG&E, SCE, or SDG&E; a municipal utility; or a public utility district). This confirms it's safe to connect your system to the grid and establishes your net-metering or net-billing arrangement.</li>
				</ul>
				<p>These two approvals run on separate timelines with separate requirements. A city permit doesn't grant interconnection, and interconnection approval doesn't substitute for a building permit. Each <a href="/california/solar-permit-guides/">GridPermit city guide</a> lists both (the local permit authority and the interconnecting utility) as separately verified facts.</p>
			</section>

			<section id="solarapp">
				<h2>SolarAPP+ and expedited permitting</h2>
				<p><a href="https://solarapp.nrel.gov/" target="_blank" rel="noopener">SolarAPP+</a> is a free online platform, developed with the National Renewable Energy Laboratory, that many California cities and counties have adopted to let licensed contractors get instant, automated code-compliance review for eligible small residential rooftop solar (and, increasingly, paired battery storage) projects, with no manual plan-check queue. Separately, California's Solar Rights Act and Government Code §65850.5 require every city and county to offer <em>some</em> expedited, standardized review path for small residential rooftop solar, whether or not that city has adopted SolarAPP+ specifically.</p>
				<p>Adoption and eligibility rules vary by city: some cities use SolarAPP+ for panels only, some extend it to battery storage, and system-size or property-type limits differ. GridPermit records what we've independently verified about each city's actual process rather than assuming every city works the same way.</p>
			</section>

			<section id="inspections">
				<h2>Inspections</h2>
				<p>After permit issuance and installation, most jurisdictions require at least one inspection before the system can be authorized to operate: commonly a single combined final inspection for straightforward residential rooftop systems, though some cities require separate structural, electrical, or fire-safety inspections depending on the installation. Where we've verified a city's specific inspection process, it's listed on that city's guide page.</p>
				<p>For how long review itself typically takes, see our <a href="/california/solar-permit-timeline/">statewide permit-timeline guide</a>, aggregated from each city's own verified figures.</p>
			</section>

			<section id="batteries">
				<h2>Battery storage</h2>
				<p>Home battery storage is typically permitted alongside solar (or added later) through the same city building-department process, and separately needs the utility's sign-off. California's <a href="https://www.cpuc.ca.gov/industries-and-topics/electrical-energy/demand-side-management/self-generation-incentive-program" target="_blank" rel="noopener">Self-Generation Incentive Program (SGIP)</a>, administered under CPUC oversight, offers rebates toward qualifying battery storage installations for eligible households. Rules, funding availability, and rebate tiers change over time, so confirm current status directly with the SGIP program administrator before relying on a specific figure. For a walkthrough of the current SGIP rebate tiers, see our <a href="/blog/sgip-battery-rebates-california/">SGIP battery rebate guide</a>.</p>
			</section>

			<section id="local-differences">
				<h2>Why requirements differ by city</h2>
				<p>California doesn't operate one statewide permitting office for solar. Each city and county runs its own building department, sets its own fee schedule, and chooses its own permitting software. Some contract their entire building department out to their county rather than staffing one directly. Which electric utility serves a city, and whether a Community Choice Aggregator (CCA) supplies the actual generation there, also varies block by block in some cases. GridPermit verifies these facts per city rather than generalizing from a neighboring jurisdiction or assuming a city matches its county's typical pattern.</p>
			</section>

			<section id="verification">
				<h2>How GridPermit verifies each city</h2>
				<p>Every fact on a city guide traces to an official source (a city or county government page, an adopted municipal code section, a utility's own program page, or a CPUC/California Energy Commission document) and carries a confidence score reflecting how directly that source supports it. A city is only published (marked "READY") once most of the fact categories we track are populated with real sourced information and the record passes an automated validator with zero errors. See our full <a href="/methodology#ready-criteria">methodology and READY criteria</a> for the exact rule, including how we handle sources that disagree and how to report a correction.</p>
			</section>

			<section id="find-your-city">
				<h2>Find your city</h2>
				<p>Browse every verified city on the <a href="/california/solar-permit-guides/">California solar permit guide index</a>, or use <a href="/search/">search</a> to jump straight to a city, utility, or topic.</p>
				{countyHubs.length > 0 && (
					<>
						<p>Counties with multiple verified cities:</p>
						<ul class="county-links">
							{countyHubs.map((hub) => (
								<li><a href={`/california/county/${hub.countySlug}/`}>{hub.county}</a> ({hub.cities.length})</li>
							))}
						</ul>
					</>
				)}
				{utilityHubs.length > 0 && (
					<>
						<p>Utilities with multiple verified cities:</p>
						<ul class="county-links">
							{utilityHubs.map((hub) => (
								<li><a href={`/california/utility/${hub.utilitySlug}/`}>{hub.utilityShort}</a> ({hub.cities.length})</li>
							))}
						</ul>
					</>
				)}
			</section>

			<section id="faq">
				<h2>Frequently Asked Questions</h2>
				{faqs.map((f) => (
					<details class="faq-item" data-track-toggle="faq_expanded">
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))}
			</section>

			<div class="footer-disclaimer">
				<p><strong>Disclaimers:</strong> This page is for informational purposes only and is not legal, engineering, financial, tax, or permit advice. GridPermit is not a solar installer, contractor, engineering firm, public utility, or government agency. Verify current requirements with your city/county building department and your electric utility before starting a project.</p>
				<p><a href="/california/solar-permit-guides/">All California Guides</a> · <a href="/methodology/">Methodology</a> · <a href="/how-it-works/">How It Works</a> · <a href="/">Back to GridPermit</a></p>
			</div>
		</main>
		</div>
	</div>

	<Footer />

	<style>
		.stats-row { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 1.25rem; }.stat-pill { background: var(--gp-surface); border: 1px solid var(--gp-line); color: var(--gp-muted); border-radius: 2px; padding: 0.4rem 0.9rem; font-size: 0.85rem; }.stat-pill strong { font-weight: 800; }.disclaimer-box { background: var(--gp-surface); border: 1px solid var(--gp-line); color: var(--gp-muted); border-radius: 2px; padding: 0.9rem 1.1rem; font-size: 0.88rem; margin-bottom: 1.5rem; }.county-links { list-style: none; padding: 0; margin: 0 0 0.75rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }.county-links li { background: var(--gp-surface); border: 1px solid var(--border-color); border-radius: 2px; padding: 0.4rem 0.9rem; font-size: 0.88rem; }.county-links a { color: var(--primary); text-decoration: none; font-weight: 600; }
	</style>
</body>
</html>
