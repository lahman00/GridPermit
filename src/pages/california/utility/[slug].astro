---
import DirectoryFilter from "../../../components/DirectoryFilter.astro";
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.astro";
import DesignHead from "../../../components/DesignHead.astro";
// Utility hub pages — generated only for utilities with enough READY
// cities to offer genuine navigation and context value (see
// MIN_READY_CITIES_FOR_UTILITY_HUB in src/lib/utility-hub.ts). Never
// generalizes a per-city permitting fact onto the utility page — only
// utility-level facts already true across every one of its READY cities.
import { buildUtilityHubs, type UtilityEvaluationSummary } from "../../../lib/utility-hub";
import { SITE_ORIGIN, buildBreadcrumbSchema, type LocalityRecord } from "../../../lib/locality-guide";
import Analytics from "../../../components/Analytics.astro";

export async function getStaticPaths() {
	const localityModules = import.meta.glob("../../../../data/localities/*.json", { eager: true }) as Record<
		string,
		{ default: LocalityRecord & { record_id: string } }
	>;
	const recordsById = new Map(
		Object.values(localityModules).map((mod) => [mod.default.record_id, mod.default]),
	);
	const evaluationModules = import.meta.glob("../../../../output/*-evaluation.json", { eager: true }) as Record<
		string,
		{ default: { records: UtilityEvaluationSummary[] } }
	>;
	const allEvaluatedRecords = Object.values(evaluationModules).flatMap((mod) => mod.default.records);
	// This route is physically rooted at /california/utility/ — restrict to
	// California hubs only; see the identical fix/comment in
	// src/pages/california/county/[slug].astro.
	const hubs = buildUtilityHubs(allEvaluatedRecords, recordsById).filter((hub) => hub.state === "CA");

	return hubs.map((hub) => ({
		params: { slug: hub.utilitySlug },
		props: { hub },
	}));
}

const { hub } = Astro.props;

const PAGE_PATH = `/california/utility/${hub.utilitySlug}/`;
const CANONICAL_URL = `${SITE_ORIGIN}${PAGE_PATH}`;
const title = `${hub.utilityShort} Solar Permit Cities in California | GridPermit`;
const description = `${hub.cities.length} verified California cities served by ${hub.utilityShort} — permit authority per city, plus ${hub.utilityShort}'s role vs. each city's building department.`;

const breadcrumbItems = [
	{ name: "Home", url: `${SITE_ORIGIN}/` },
	{ name: "California", url: `${SITE_ORIGIN}/california/` },
	{ name: hub.utilityShort, url: CANONICAL_URL },
];
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems);

const collectionSchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: title,
	description,
	url: CANONICAL_URL,
	mainEntity: {
		"@type": "ItemList",
		numberOfItems: hub.cities.length,
		itemListElement: hub.cities.map((c, i) => ({
			"@type": "ListItem",
			position: i + 1,
			name: `${c.city} Solar Permit Guide`,
			url: `${SITE_ORIGIN}${c.guideUrl}`,
		})),
	},
};
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
	<Analytics />
	<DesignHead />
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={CANONICAL_URL} />
	<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
	<link rel="sitemap" href="/sitemap-index.xml" />

	<meta property="og:type" content="website" />
	<meta property="og:url" content={CANONICAL_URL} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	<script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
</head>
<body>
	<a href="#main-content" class="skip-link">Skip to main content</a>


	<Header />

	<div class="page-container">
		<nav class="breadcrumb-nav" aria-label="Breadcrumb">
			{breadcrumbItems.map((item, i) => (
				<>
					{i > 0 && <span class="crumb-sep">/</span>}
					{i === breadcrumbItems.length - 1
						? <span class="crumb-current">{item.name}</span>
						: <a href={item.url.replace(SITE_ORIGIN, "")}>{item.name}</a>}
				</>
			))}
		</nav>

		<main class="content-card" id="main-content" tabindex="-1">
			<h1>{hub.utilityShort} Solar Permit Cities</h1>
			<p class="subtitle">{hub.cities.length} verified cities across {hub.counties.length} {hub.counties.length === 1 ? "county" : "counties"}</p>
<DirectoryFilter />

			<div class="disclaimer-box">
				<strong>Informational only.</strong> This page summarizes verified per-city facts already published on each city's own guide. {hub.utilityShort} is the interconnection and distribution utility for the cities listed. The city's own building department, not {hub.utilityShort}, issues the construction/electrical permit. Not legal, engineering, or permit advice.
			</div>

			<section id="role">
				<h2>{hub.utilityShort}'s role</h2>
				<p>{hub.utilityShort} reviews and approves grid interconnection for residential solar and battery systems in the cities below (a separate process from, and usually reviewed independently of, each city's building/electrical permit). See <a href="/california/#permit-vs-interconnection">why these are two separate approvals</a>.</p>
				{hub.commonInterconnectionUrl && (
					<p>{hub.utilityShort}'s own interconnection page (cited identically across every verified city below): <a href={hub.commonInterconnectionUrl} target="_blank" rel="noopener">{hub.commonInterconnectionUrl}</a></p>
				)}
			</section>

			<section id="cities">
				<h2>Verified {hub.utilityShort} cities</h2>
				<div class="guide-grid">
					{hub.cities.map((c) => (
						<a href={c.guideUrl} class="guide-card" data-filter-text={[c.county, hub.utilityShort].filter(Boolean).join(" ")} data-track-click="permit_guide_clicked">
							<h2>{c.city}</h2>
							{c.county && <p class="card-field"><strong>County:</strong> {c.county}</p>}
							<span class="card-link">View full guide →</span>
						</a>
					))}
				</div>
			</section>

			<div class="footer-disclaimer">
				<p><strong>Disclaimers:</strong> This page is for informational purposes only and is not legal, engineering, financial, tax, or permit advice. GridPermit is not a solar installer, contractor, engineering firm, public utility, or government agency. Verify current requirements with each city's listed permit authority and with {hub.utilityShort} directly.</p>
				<p><a href="/california/">California Solar Permit Guide</a> · <a href="/california/solar-permit-guides/">All California Guides</a> · <a href="/methodology/">Methodology</a> · <a href="/">Back to GridPermit</a></p>
			</div>
		</main>
	</div>

	<Footer />

	<style>
		.disclaimer-box { background: var(--gp-surface); border: 1px solid var(--gp-line); color: var(--gp-muted); border-radius: 2px; padding: 0.9rem 1.1rem; font-size: 0.88rem; margin-bottom: 1.5rem; }.card-field strong { color: var(--text-main); }
	</style>
</body>
</html>
