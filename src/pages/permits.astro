---
import DirectoryFilter from "../components/DirectoryFilter.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import DesignHead from "../components/DesignHead.astro";
// The national discovery surface: one honest page per state, coverage
// derived entirely from the real dataset at build time — never a hardcoded
// snapshot. A state with a published guide shows its real guide count; a
// state with only LIMITED records says so plainly rather than being hidden
// or padded to look more complete than it is. See
// docs/NATIONAL_PRODUCT_STRATEGY.md's "current coverage limitations"
// section — this page is that section's live, user-facing counterpart.
import {
	SITE_ORIGIN,
	buildLocalityIndexEntries,
	buildBreadcrumbSchema,
	type LocalityRecord,
} from "../lib/locality-guide";
import { STATE_META, SUPPORTED_STATE_CODES } from "../lib/state-meta";
import Analytics from "../components/Analytics.astro";

const localityModules = import.meta.glob("../../data/localities/*.json", { eager: true }) as Record<
	string,
	{ default: LocalityRecord & { record_id: string } }
>;
const allRecords = Object.values(localityModules).map((mod) => mod.default);
const recordsById = new Map(allRecords.map((r) => [r.record_id, r]));

const evaluationModules = import.meta.glob("../../output/*-evaluation.json", { eager: true }) as Record<
	string,
	{ default: { records: Array<{ record_id: string; readiness: string; completeness_pct: number }> } }
>;
const allEvaluatedRecords = Object.values(evaluationModules).flatMap((mod) => mod.default.records);
const readyEntries = buildLocalityIndexEntries(allEvaluatedRecords, recordsById);

interface StateCoverage {
	code: string;
	name: string;
	slug: string;
	url: string;
	readyCount: number;
	totalRecords: number;
}

const stateCoverage: StateCoverage[] = SUPPORTED_STATE_CODES.map((code) => {
	const meta = STATE_META[code];
	const readyCount = readyEntries.filter((e) => e.state === code).length;
	const totalRecords = allRecords.filter((r) => r.state === code).length;
	const url = code === "CA" ? "/california/" : `/${meta.slug}/`;
	return { code, name: meta.name, slug: meta.slug, url, readyCount, totalRecords };
}).sort((a, b) => a.name.localeCompare(b.name));

const publishedStates = stateCoverage.filter((s) => s.readyCount > 0);
const inProgressStates = stateCoverage.filter((s) => s.readyCount === 0);
const totalGuides = stateCoverage.reduce((sum, s) => sum + s.readyCount, 0);

const PAGE_PATH = "/permits/";
const CANONICAL_URL = `${SITE_ORIGIN}${PAGE_PATH}`;
const title = "Solar Permit Guides by State (All 50 States) | GridPermit";
const description = `Browse GridPermit's solar permit research by state — ${publishedStates.length} states have at least one published, source-linked city guide; research is on file for all 50 states.`;

const breadcrumbSchema = buildBreadcrumbSchema([
	{ name: "Home", url: `${SITE_ORIGIN}/` },
	{ name: "Browse States", url: CANONICAL_URL },
]);

const collectionSchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: title,
	description,
	url: CANONICAL_URL,
};
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
	<Analytics />
	<DesignHead />
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description} />
	<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
	<link rel="canonical" href={CANONICAL_URL} />
	<link rel="sitemap" href="/sitemap-index.xml" />
	<meta property="og:type" content="website" />
	<meta property="og:url" content={CANONICAL_URL} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	<script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

</head>
<body>
	<a href="#main-content" class="skip-link">Skip to main content</a>
	<Header />

	<div class="page-container">
		<nav class="breadcrumb-nav" aria-label="Breadcrumb">
			<a href="/">Home</a> / <span>Browse States</span>
		</nav>

		<main class="gp-directory-main" id="main-content" tabindex="-1">
			<p class="gp-kicker">Explore the directory</p><h1>Solar Permit Guides<br/>by State.</h1>
			<p class="page-lead">GridPermit has research on file for all 50 states. {publishedStates.length} states have at least one guide that's cleared our bar to publish. The rest have real research in progress that hasn't yet met that bar. We say so plainly rather than filling gaps with guesses. See our <a href="/methodology/">Methodology</a> for exactly what "published" requires.</p>

			<div class="summary-stats">
				<div class="summary-stat"><span class="num">50</span><span class="label">States With Research on File</span></div>
				<div class="summary-stat"><span class="num">{publishedStates.length}</span><span class="label">States With Published Guides</span></div>
				<div class="summary-stat"><span class="num">{totalGuides}</span><span class="label">Total Published Guides</span></div>
				<div class="summary-stat"><span class="num">{stateCoverage.find((s) => s.code === "CA")?.readyCount ?? 0}</span><span class="label">Published in California Alone</span></div>
			</div>

			<DirectoryFilter />
<h2 class="section-heading">States with published guides</h2>
			<div class="state-grid">
				{publishedStates.map((s) => (
					<a href={s.url} class={`state-card ${s.code === "CA" ? "flagship" : ""}`} data-track-click="permit_guide_clicked">
						<div class="state-name">{s.name}</div>
						<span class="coverage-badge published">{s.readyCount} guide{s.readyCount === 1 ? "" : "s"} published</span>
					</a>
				))}
			</div>

			<h2 class="section-heading">Research in progress</h2>
			<p class="in-progress-note">These states have real locality records on file, but none has yet reached the completeness and source-verification bar GridPermit requires before publishing a guide. Check back, or use <a href="/search/">search</a> to see exactly what's on file today.</p>
			<div class="state-grid">
				{inProgressStates.map((s) => (
					<a href={s.url} class="state-card">
						<div class="state-name">{s.name}</div>
						<span class="coverage-badge in-progress">Research in progress</span>
					</a>
				))}
			</div>
		<details class="gp-directory-reading"><summary>Decision guides for permit and PTO problems</summary><h2 class="section-heading">Decision guides for permit and PTO problems</h2>
			<p class="in-progress-note">Use these when the question is not just “what does my city require?” but “which approval path am I actually on, what changed, and who owns the next step?” Each guide is tied to current first-party utility or SolarAPP+ sources.</p>
			<div class="decision-grid">
				<a class="decision-card" href="/permit-path/"><strong>Permit Path Checker</strong><span>Choose a researched jurisdiction and flag battery, MPU, ground mount, existing PV, owner-builder or equipment-change facts before deciding where to file.</span></a>
				<a class="decision-card" href="/blog/pge-no-pto-installer-closed/"><strong>Installed solar, but no PG&amp;E PTO</strong><span>Find the missing interconnection milestone, document, owner and submission date before paying someone to fix PTO.</span></a>
				<a class="decision-card" href="/blog/sce-add-battery-existing-solar/"><strong>Adding a battery to existing SCE solar</strong><span>Separate the AHJ permit path from SCE interconnection and check whether the proposed configuration changes the application.</span></a>
				<a class="decision-card" href="/blog/solarapp-eligibility-2026/"><strong>Can this project use SolarAPP+?</strong><span>Check storage, MPU, existing PV, homeowner installation and ground-mount eligibility before choosing the submission path.</span></a>
				<a class="decision-card" href="/blog/city-permit-vs-utility-pto/"><strong>City permit vs utility interconnection/PTO</strong><span>Understand why a passed local inspection does not necessarily mean the utility process is complete.</span></a>
				<a class="decision-card" href="/blog/long-beach-solar-ess-express-vs-plan-review/"><strong>Long Beach solar + ESS permit rejected</strong><span>Determine whether the project should be on the Express route or full plan review, and identify the exact professional-document requirement before hiring a plan provider.</span></a>
				<a class="decision-card" href="/blog/pge-zero-export-solar-battery-interconnection/"><strong>PG&amp;E zero-export solar + battery</strong><span>Classify the Rule 21 non-export path before assuming which application, fee or review process applies.</span></a>
				<a class="decision-card" href="/blog/california-sb868-plugin-solar-status/"><strong>California plug-in solar / SB 868 status</strong><span>Check whether the proposed 1,200 W plug-in solar exemption is actually law before relying on it for a current project.</span></a>
				<a class="decision-card" href="/blog/el-cerrito-solar-permit-plan-service/"><strong>El Cerrito permit-plan service quote</strong><span>Separate SolarAPP+ eligibility, City plan/engineering scope and PG&amp;E interconnection work before paying for a permit package.</span></a>
				<a class="decision-card" href="/blog/epe-failed-solar-inspection-rec-meter/"><strong>EPE solar field inspection failed</strong><span>Separate the AHJ final from EPE field inspection and compare approved metering drawings with the as-built layout before authorizing a correction.</span></a>
			</div>

			</details>
</main>

		<div class="footer-disclaimer">
			<p>Coverage counts reflect GridPermit's own verified dataset as of the last data update. A state showing published guides may still have cities with no guide yet. Search for your specific city to check. See <a href="/methodology/">Methodology</a> for how a record earns "published" status, and <a href="/how-it-works/">How It Works</a> for the full process.</p>
		</div>
	</div>
<Footer />
<style>
 .gp-directory-main { padding: 30px 0; }
 .gp-directory-main > h1 { margin-bottom: 32px; }
 .page-lead { max-width: 800px; color: var(--gp-muted); font-size: 16px; }
 .summary-stats { display: flex; flex-wrap: wrap; gap: 28px 54px; border-block: 1px solid var(--gp-line); padding: 24px 0; margin: 36px 0; }
 .summary-stat .num { display: block; font-size: 30px; font-weight: 300; }
 .summary-stat .label { font: 10px/1.6 var(--gp-mono); color: var(--gp-muted); text-transform: uppercase; }
 .state-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 0 42px; }
 .state-card { padding-block: 22px; }
 .state-card .state-name { font-size: 24px; font-weight: 300; margin-bottom: 6px; }
 .coverage-badge { font: 11px/1.6 var(--gp-mono); color: var(--gp-muted); }
 .state-card.flagship .state-name { color: var(--gp-accent); }
 .section-heading { margin: 56px 0 24px; }
 .in-progress-note { max-width: 820px; font-size: 15px; color: var(--gp-muted); }
 .gp-directory-reading { margin-top: 60px; border-top: 1px solid var(--gp-line); }
 .gp-directory-reading > summary { font-size: 24px; font-weight: 300; }
 .gp-directory-reading > h2 { display: none; }
 .decision-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; }
 .decision-card { padding: 24px 0; border-top: 1px solid var(--gp-line); text-decoration: none; }
 .decision-card strong { display: block; font-weight: 400; font-size: 20px; margin-bottom: 12px; }
 .decision-card span { font-size: 14px; color: var(--gp-muted); }
 @media(max-width:760px) { .state-grid { grid-template-columns: 1fr 1fr; gap: 0 24px; } .state-card .state-name { font-size: 21px; } .decision-grid { grid-template-columns:1fr; } }
</style>
</body>
</html>
