---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DesignHead from "../components/DesignHead.astro";
import Analytics from "../components/Analytics.astro";
import { SOLAR_ORGANIZER, organizerCheckout } from "../lib/solar-organizer";

const title = "Solar Project Organizer: Fillable PDF & Templates | GridPermit";
const description = "Organize solar quotes, permit paperwork, inspections and utility approval in a six-page fillable PDF and three CSV templates. $9 USD, one-time purchase.";
const canonical = `https://mygridpermit.com${SOLAR_ORGANIZER.path}`;
const price = SOLAR_ORGANIZER.priceCents / 100;
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonical,
};
// Product data mirrors the buy button: same price constant and currency, and the same gate (the
// checkout URL must pass validatedOrganizerCheckout). It adds no claims beyond the page itself.
const productSchema = organizerCheckout ? {
  "@context": "https://schema.org",
  "@type": "Product",
  name: SOLAR_ORGANIZER.title,
  description,
  image: "https://mygridpermit.com/products/solar-project-organizer-preview.png",
  brand: { "@type": "Brand", name: "GridPermit" },
  offers: {
    "@type": "Offer",
    price: price.toFixed(2),
    priceCurrency: SOLAR_ORGANIZER.currency,
    availability: "https://schema.org/InStock",
    url: canonical,
  },
} : null;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <DesignHead />
  <Analytics />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {!organizerCheckout && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://mygridpermit.com/products/solar-project-organizer-preview.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  {productSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />}
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <Header />
  <main id="main-content" class="gp-container organizer-page" tabindex="-1">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb"><a href="/">Home</a><span class="crumb-sep" aria-hidden="true">/</span><span class="crumb-current" aria-current="page">Solar Project Organizer</span></nav>
    <section class="organizer-hero" aria-labelledby="organizer-title">
      <div>
        <p class="gp-kicker"><span class="gp-accent">Downloadable workbook</span> / For homeowners</p>
        <h1 id="organizer-title">Solar Project Organizer</h1>
        <p class="lead">Keep your quotes, permit paperwork and utility approvals in one working file.</p>
        <p class="intro">Compare written offers, track the next step and collect the documents you will need at the end of your solar project.</p>
        <div class="purchase-box">
          <p class="price">${price} <span>USD · one-time purchase</span></p>
          <p class="includes">Six-page fillable PDF + three editable CSV templates. No subscription.</p>
          {organizerCheckout ? <>
            <a class="buy-link" href={organizerCheckout} rel="noopener" data-track-click="organizer_checkout_clicked" aria-describedby="checkout-note">Buy the organizer · ${price} <span class="buy-arrow" aria-hidden="true">↗</span></a>
            <p class="checkout-note" id="checkout-note">Checkout opens on Whop, which handles payment and tax. After payment, sign in to Whop and download the ZIP from Files.</p>
          </> : <>
            <button class="buy-link" disabled>Checkout not yet available</button>
            <p class="checkout-note">This product is not currently for sale.</p>
          </>}
          <ul class="purchase-facts">
            <li>Download access lasts one year; keep your own copy of the files.</li>
            <li>Any applicable tax is shown at checkout. See the <a href="/terms/">digital download terms</a>.</li>
            <li><strong>14-day refund policy:</strong> Request a full refund within 14 days of purchase through <a href="/contact/#organizer-orders">GridPermit support</a>, using your checkout email address. No reason required. Your statutory consumer rights remain unaffected.</li>
          </ul>
        </div>
      </div>
      <figure>
        <a href="/products/solar-project-organizer-preview.png" aria-label="View the first page of the organizer">
          <picture>
            <source srcset="/products/solar-project-organizer-preview.webp" type="image/webp" />
            <img src="/products/solar-project-organizer-preview.png" alt="Preview of the organizer's project overview page, with blank fields for project details and next actions" width="773" height="1000" fetchpriority="high" />
          </picture>
        </a>
        <figcaption>Page 1 of 6. Select the image to view the sample.</figcaption>
      </figure>
    </section>
    <section class="details sample" aria-labelledby="sample-title">
      <h2 id="sample-title">Try one page before you buy</h2>
      <p>Use the organizer's quote comparison page to record two written offers. Compare the equipment, payment terms, permit tasks and exclusions in one place.</p>
      <p><a class="sample-link" href="/products/solar-project-organizer-sample.pdf" download data-track-click="internal_resource_clicked" aria-describedby="sample-note">Download free sample (PDF, 22 KB)</a></p>
      <p id="sample-note">One page from the six-page organizer. No email or account needed. Open it in a PDF reader that supports forms, add a few entries, then save and reopen it to check they are kept. CSV templates are included with the full organizer.</p>
    </section>
    <section class="details" aria-labelledby="fit-title">
      <h2 id="fit-title">Who it is for</h2>
      <div class="fit-grid">
        <div>
          <h3>A good fit if you</h3>
          <ul>
            <li>are comparing written solar quotes from more than one installer</li>
            <li>are tracking a permit, an inspection and the utility's approval at the same time</li>
            <li>want a working file of your own, on your own computer</li>
          </ul>
        </div>
        <div>
          <h3>Start somewhere else if you</h3>
          <ul>
            <li>want the permit rules for your city looked up for you. Our free <a href="/search/">city permit guides</a> and <a href="/permit-path/">permit path checker</a> do that, and they stay free.</li>
            <li>need someone to design the system or file the application</li>
          </ul>
        </div>
      </div>
    </section>
    <section class="details" aria-labelledby="included-title">
      <h2 id="included-title">What you get</h2>
      <div class="contents-grid">
        <div>
          <h3>A six-page PDF with 45 fillable fields</h3>
          <ul>
            <li>Project overview</li>
            <li>Quote comparison</li>
            <li>Permit office check</li>
            <li>Permit and inspection tracker</li>
            <li>Utility approval tracker</li>
            <li>Final handoff checklist</li>
          </ul>
        </div>
        <div>
          <h3>Three editable CSV templates</h3>
          <ul>
            <li>Quote comparison</li>
            <li>Project action log</li>
            <li>Source check log</li>
          </ul>
          <p>Add more rows as your project grows.</p>
        </div>
        <div>
          <h3>A short setup guide</h3>
          <p>Save your own copy, open the PDF in a reader that supports forms, and use a spreadsheet application for the CSV files. The PDF can also be printed.</p>
        </div>
      </div>
    </section>
    <section class="details" id="how-it-works" aria-labelledby="how-title">
      <h2 id="how-title">How buying and downloading works</h2>
      <ol class="steps">
        <li><strong>Buy on Whop.</strong> Checkout, payment and tax are handled by Whop. The price is $9 USD, one time. Checkout may show a converted amount in your local currency.</li>
        <li><strong>Download the ZIP.</strong> After payment, sign in to Whop and open Files. Download access lasts one year, so save a copy of the files.</li>
        <li><strong>Fill it in.</strong> The PDF has no submit button, automatic upload or JavaScript. Your completed files stay with you.</li>
      </ol>
    </section>
    <section class="details boundary" aria-labelledby="scope-title">
      <h2 id="scope-title">Know what you are buying</h2>
      <p>This is a blank organizer. It does not include current permit rules, individual research, application filing, design work or live updates. Verify your project's requirements with the official permit office and electric utility.</p>
      <p>Questions about the download? <a href="/contact/">Contact GridPermit</a>.</p>
    </section>
  </main>
  <Footer />
</body>
</html>
<style>
  .organizer-page { padding-block: var(--gp-space-4) var(--gp-space-10); }
  .organizer-page .breadcrumb-nav { margin-bottom: var(--gp-space-5); }
  .organizer-hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(32px, 6vw, 80px); align-items: start; }
  .organizer-hero .gp-kicker { margin-bottom: var(--gp-space-3); }
  h1 { font-size: clamp(40px, 5vw, 68px); max-width: 680px; margin-bottom: var(--gp-space-3); }
  .lead { font-size: 22px; line-height: 1.5; margin-bottom: var(--gp-space-2); }
  .intro { color: var(--gp-muted); max-width: 600px; }
  .purchase-box { border-top: 1px solid var(--gp-line); margin-top: var(--gp-space-4); padding-top: var(--gp-space-3); max-width: 600px; }
  .price { font-size: 40px; font-weight: 500; line-height: 1.1; letter-spacing: -.02em; margin: 0 0 var(--gp-space-1); }
  .price span { font-size: 15px; font-weight: 400; letter-spacing: 0; color: var(--gp-muted); }
  .includes { font-size: 15px; margin: 0 0 var(--gp-space-3); }
  .buy-link { display: inline-flex; align-items: center; justify-content: space-between; gap: var(--gp-space-4); min-height: 52px; border: 1px solid var(--gp-accent); border-radius: 2px; padding: 14px 24px; background: var(--gp-accent); color: var(--gp-accent-ink); font: 500 16px/1.4 var(--gp-font); text-decoration: none; transition: filter .2s ease, transform .2s ease; }
  .buy-link:hover { color: var(--gp-accent-ink); filter: brightness(1.08); }
  .buy-link:active { transform: translateY(1px); }
  .buy-arrow { transition: transform .25s ease; }
  .buy-link:hover .buy-arrow { transform: translate(3px, -3px); }
  .buy-link:disabled { background: var(--gp-surface); border-color: var(--gp-line); color: var(--gp-muted); cursor: not-allowed; }
  .checkout-note { color: var(--gp-muted); font-size: 14px; margin: var(--gp-space-2) 0 var(--gp-space-3); max-width: 570px; }
  .purchase-facts { list-style: none; margin: 0; padding: var(--gp-space-2) 0 0; border-top: 1px solid var(--gp-line); max-width: 570px; }
  .purchase-facts li { position: relative; margin: 0 0 var(--gp-space-1); padding-left: var(--gp-space-3); color: var(--gp-muted); font-size: 14px; line-height: 1.6; }
  .purchase-facts li::before { content: ''; position: absolute; left: 2px; top: .62em; width: 7px; height: 7px; background: var(--gp-accent); }
  .purchase-facts strong { color: var(--gp-ink); }
  figure picture { display: block; }
  figure { margin: 0; }
  figure img { display: block; width: 100%; height: auto; border: 1px solid var(--gp-line); background: white; }
  figcaption { margin-top: 12px; font-size: 12px; color: var(--gp-muted); }
  .details { margin-top: var(--gp-space-8); padding-top: var(--gp-space-4); border-top: 1px solid var(--gp-line); }
  .sample { max-width: 850px; }
  .sample p { color: var(--gp-muted); }
  .sample-link { display: inline-flex; align-items: center; min-height: 44px; text-underline-offset: .2em; }
  .details h2 { font-size: 32px; margin-bottom: var(--gp-space-3); }
  .contents-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gp-space-4); }
  .contents-grid h3 { font-size: 22px; line-height: 1.3; }
  .contents-grid p, .boundary p { color: var(--gp-muted); }
  .boundary { max-width: 850px; }
  .fit-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gp-space-4); }
  .fit-grid h3 { font-size: 22px; line-height: 1.3; }
  .details ul { margin: 0; padding-left: 1.2em; color: var(--gp-muted); }
  .details li { margin: 0 0 .45em; }
  .steps { margin: 0; padding-left: 1.4em; max-width: 760px; color: var(--gp-muted); }
  .steps li { margin: 0 0 1em; padding-left: .3em; }
  .steps strong { color: var(--gp-ink); }
  @media (max-width: 760px) { .organizer-hero, .contents-grid, .fit-grid { grid-template-columns: 1fr; } .organizer-hero figure { max-width: 480px; } .lead { font-size: 20px; } .details { margin-top: var(--gp-space-6); } .organizer-page .breadcrumb-nav { margin-bottom: var(--gp-space-3); } .buy-link { width: 100%; } }
</style>
