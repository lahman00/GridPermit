---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import DesignHead from "../components/DesignHead.astro";
import Analytics from "../components/Analytics.astro";
const title = "Partner Integration Inquiry | GridPermit";
const description = "Email GridPermit about a platform, workflow, referral or integration inquiry.";
const inquirySubject = "GridPermit business workflow inquiry";
const inquiryBody = ["Company or organization:", "Role or team:", "State and city or county:", "Workflow you are trying to complete:", "Where you get stuck:", "", "Please omit homeowner names, street addresses, account numbers and private documents."].join("\r\n");
const inquiryHref = `mailto:support@mygridpermit.com?subject=${encodeURIComponent(inquirySubject)}&body=${encodeURIComponent(inquiryBody)}`;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <Analytics />
	<DesignHead />
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://mygridpermit.com/partner-inquiry/" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://mygridpermit.com/partner-inquiry/" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <style>
    .card { background:var(--gp-surface); border:1px solid var(--gp-line); border-radius:2px; padding:2rem; }
    .button { display:inline-flex; align-items:center; min-height:48px; margin:8px 0; border-radius:2px; background:var(--gp-accent); color:var(--gp-bg); font:inherit; font-weight:700; padding:12px 16px; text-decoration:none; }
    .button:focus-visible { outline:2px solid var(--gp-ink); outline-offset:4px; }
    .small { font-size:.875rem; color:var(--gp-muted); }
    @media(max-width:620px) { .card { padding:20px; } .button { width:100%; justify-content:center; box-sizing:border-box; } }
  </style>
</head>
<body>
<a href="#main-content" class="skip-link">Skip to main content</a>
<Header />
  <main id="main-content" tabindex="-1">
    <div class="card">
      <h1>Discuss a GridPermit integration or distribution pilot</h1>
      <p>Use this for software integrations, workflow pilots, referral/distribution partnerships or permit/interconnection service routing.</p>
      <p>The strongest pilot candidates already have project context—address, AHJ, utility, system design or milestone data—but still send operations teams into manual research when a battery, MPU, existing PV, equipment revision, SolarAPP+ eligibility question, failed inspection or stalled PTO changes the normal path. GridPermit's proposed role is to classify that exception, show current first-party evidence and route the project into the partner's existing execution workflow rather than replace it.</p>
      <section aria-labelledby="inquiry-email-heading">
        <h2 id="inquiry-email-heading">Tell us about your workflow</h2>
        <p>Include your company or organization, your role, the state and city or county you work in, and one task that sends your team back to manual research.</p>
        <a class="button" href={inquiryHref} data-inquiry-email="compose">Compose a business inquiry</a>
        <p class="small">Opens a draft in your email app. Review it and send it there. Clicking this link does not submit an inquiry.</p>
        <p>No email app? Write to <a href="mailto:support@mygridpermit.com" data-inquiry-email="address">support@mygridpermit.com</a>.</p>
        <p class="small">Please leave out homeowner names, street addresses, account numbers, login details and private project documents. This is a conversation about a possible pilot, not an order or a commitment to a service.</p>
      </section>
    </div>
  </main>


<!-- Page-scoped GA4 events deliberately leave the shared analytics bundle and
     frozen measurement pages untouched. Reuse the existing Google tag only.
     A click is a draft-opening attempt, never a sent email or qualified lead. -->
<script is:inline>
  (() => {
    if (!['mygridpermit.com', 'www.mygridpermit.com'].includes(location.hostname)) return;
    if (window.__gpInquiryMeasurement) return;
    window.__gpInquiryMeasurement = true;
    const pageLocation = 'https://mygridpermit.com/partner-inquiry/';
    const emit = (name, params = {}) => {
      if (typeof window.gtag !== 'function') return;
      try { window.gtag('event', name, { page_location: pageLocation, ...params }); }
      catch { /* Measurement must never break the email handoff. */ }
    };
    emit('inquiry_page_viewed');
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest('a[data-inquiry-email]');
      if (!link) return;
      const action = link.getAttribute('data-inquiry-email');
      if (action !== 'compose' && action !== 'address') return;
      emit('inquiry_email_clicked', { inquiry_action: action });
    });
  })();
</script>
<Footer />
</body>
</html>
