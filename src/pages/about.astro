---
import Analytics from "../components/Analytics.astro";

const webPageSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	name: "About Us - GridPermit",
	description: "Learn about GridPermit, an independent educational resource for California residential solar and battery storage decisions.",
	url: "https://mygridpermit.com/about/",
};
---
<!DOCTYPE html>
<html lang="en">
<head>
	<Analytics />
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>About Us - GridPermit</title>
	<meta name="description" content="Learn about GridPermit, an independent educational resource for California residential solar and battery storage decisions." />
	<link rel="canonical" href="https://mygridpermit.com/about/" />
	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://mygridpermit.com/about/" />
	<meta property="og:title" content="About Us - GridPermit" />
	<meta property="og:description" content="Learn about GridPermit, an independent educational resource for California residential solar and battery storage decisions." />
	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content="About Us - GridPermit" />
	<meta name="twitter:description" content="Learn about GridPermit, an independent educational resource for California residential solar and battery storage decisions." />
	<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
	<link rel="sitemap" href="/sitemap-index.xml" />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" class="async-font-css">
	<noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"></noscript>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
	<style>
		body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f8fafc; color: #0f172a; line-height: 1.6; padding: 2rem 1rem; }
		.container { max-width: 800px; margin: 0 auto; background: white; padding: 2.5rem; border-radius: 12px; border: 1px solid #e2e8f0; }
		h1 { font-size: 2rem; font-weight: 800; margin-bottom: 1rem; color: #0f172a; }
		h2 { font-size: 1.25rem; font-weight: 700; margin-top: 1.5rem; margin-bottom: 0.5rem; color: #2563eb; }
		p { font-size: 0.95rem; color: #475569; margin-bottom: 1rem; }
		.back-link { display: inline-block; margin-bottom: 1.5rem; color: #2563eb; font-weight: 600; text-decoration: none; }
		.cross-links { font-size: 0.85rem; color: #64748b; margin-bottom: 1.5rem; }
		.cross-links a { color: #2563eb; text-decoration: none; }
	</style>
</head>
<body>
	<main class="container">
		<a href="/" class="back-link">← Back to Calculator</a>
		<p class="cross-links"><a href="/blog">Blog</a> · <a href="/california/solar-permit-guides/">California Guides</a> · <a href="/methodology">Methodology</a> · <a href="/contact">Contact</a></p>
		<h1>About GridPermit</h1>
		<p>GridPermit is an independent educational platform built to help California homeowners understand residential solar energy and battery storage decisions.</p>

		<h2>Educational Purpose</h2>
		<p>GridPermit currently provides a simple, clearly-labeled illustrative system-size estimate based on standardized placeholder assumptions — not real utility rate data or property-specific analysis. We say so plainly on every page rather than implying more precision than the tool actually has; see our <a href="/methodology" style="color:#2563eb;">Methodology</a> for the exact numbers used. Our goal is to offer transparent informational tools, with optional links to independent third-party solar marketplaces.</p>

		<h2>Independent Referral Model</h2>
		<p>GridPermit is not a solar installer, contractor, engineering firm, public utility, or government agency. We do not provide engineering calculations or binding price quotes. Outbound links to third-party solar marketplaces (such as EnergySage) are currently plain links with no affiliate or tracking relationship and no compensation to GridPermit — if that changes in the future, we will disclose it clearly on the page where the link appears and update this page to match.</p>
	</main>
</body>
</html>
