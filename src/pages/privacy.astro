		.updated { color: #64748b; font-size: 0.85rem; margin-bottom: 2rem; }
		h2 { font-size: 1.3rem; font-weight: 700; margin-top: 1.75rem; margin-bottom: 0.5rem; }
		p { color: #334155; margin-bottom: 1rem; }
		.btn-back { display: inline-block; margin-top: 2rem; color: var(--primary); font-weight: 700; text-decoration: none; }
	</style>
