---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import DesignHead from "../components/DesignHead.astro";
// Astro's documented convention: a src/pages/404.astro file is built to
// dist/404.html, which Netlify automatically serves (with a real 404
// status) for any unmatched path — no netlify.toml redirect needed.
//
// Before this file existed, every broken/mistyped/stale link on the site
// fell through to Netlify's own generic default 404 page (plain text,
// zero GridPermit branding, zero navigation back into the product — see
// the overnight product-audit findings). This replaces that dead end with
// a real page offering the two things that actually work today: search
// (spans all represented states) and the homepage.
import Analytics from "../components/Analytics.astro";

const webPageSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	name: "Page Not Found - GridPermit",
	description: "This page doesn't exist on GridPermit. Search for a city or state solar permit guide instead.",
	url: "https://mygridpermit.com/404/",
};
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
	<Analytics />
	<DesignHead />
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Page Not Found - GridPermit</title>
	<meta name="description" content="This page doesn't exist on GridPermit. Search for a city or state solar permit guide instead." />
	<meta name="robots" content="noindex, follow" />
	<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
	<style>.status-pill { display: inline-block; background: var(--gp-surface); color: var(--gp-muted); font-weight: 700; font-size: 0.78rem; padding: 0.3rem 0.75rem; border-radius: 2px; margin-bottom: 1.25rem; }.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-bottom: 2rem; }.btn-primary { display: inline-block; background: var(--gp-accent); color: var(--gp-ink); padding: 0.75rem 1.5rem; border-radius: 2px; font-weight: 700; font-size: 0.9rem; text-decoration: none; }.btn-secondary { display: inline-block; background: var(--gp-surface); color: var(--gp-accent); padding: 0.75rem 1.5rem; border-radius: 2px; font-weight: 700; font-size: 0.9rem; text-decoration: none; }.cross-links { font-size: 0.85rem; color: var(--gp-muted); }.cross-links a { color: var(--gp-accent); text-decoration: none; }
	</style>
</head>
<body data-track-view="page_not_found">
<a href="#main-content" class="skip-link">Skip to main content</a>
<Header />
	<main class="gp-reading-page" id="main-content" tabindex="-1">
		<div class="status-pill">404: Page Not Found</div>
		<h1>We couldn't find that page</h1>
		<p>The link you followed may be broken, or the page may have moved. GridPermit publishes verified solar permit guides for cities across all 50 states. Search for yours below.</p>
		<div class="actions">
			<a href="/search/" class="btn-primary">Search GridPermit →</a>
			<a href="/" class="btn-secondary">Go to Homepage</a>
		</div>
		<p class="cross-links"><a href="/california/solar-permit-guides/">California Guides</a> · <a href="/blog/">Blog</a> · <a href="/how-it-works/">How It Works</a> · <a href="/contact/">Contact</a></p>
	</main>
<Footer />
</body>
</html>
