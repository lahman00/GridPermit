---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import DesignHead from "../components/DesignHead.astro";
// GridPermit Pro — an interest-validation page, not a real product. Per
// docs/MONETIZATION_STRATEGY.md Section 4 & 7: this page exists to measure
// whether installers/permit specialists would pay for a deeper tool, before
// any accounts, billing, or subscription infrastructure gets built. The
// single CTA fires a tracked "pro_interest_clicked" event and goes nowhere
// but a mailto — no email capture, no form, no backend.
import Analytics from "../components/Analytics.astro";

const webPageSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	name: "GridPermit Pro (Coming Soon) - GridPermit",
	description: "A faster way for solar installers and permit specialists to get AHJ requirements, documents, and fees for every city they work in. Tell us if you'd use it.",
	url: "https://mygridpermit.com/pro/",
};
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
	<Analytics />
	<DesignHead />
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>GridPermit Pro (Coming Soon) - GridPermit</title>
	<meta name="description" content="A faster way for solar installers and permit specialists to get AHJ requirements, documents, and fees for every city they work in. Tell us if you'd use it." />
	<link rel="canonical" href="https://mygridpermit.com/pro/" />
	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://mygridpermit.com/pro/" />
	<meta property="og:title" content="GridPermit Pro (Coming Soon) - GridPermit" />
	<meta property="og:description" content="A faster way for solar installers and permit specialists to get AHJ requirements, documents, and fees for every city they work in. Tell us if you'd use it." />
	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content="GridPermit Pro (Coming Soon) - GridPermit" />
	<meta name="twitter:description" content="A faster way for solar installers and permit specialists to get AHJ requirements, documents, and fees for every city they work in. Tell us if you'd use it." />
	<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
	<link rel="sitemap" href="/sitemap-index.xml" />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
	<style>.badge-pill { display: inline-block; background: var(--gp-surface); color: var(--gp-accent); font-weight: 700; font-size: 0.78rem; padding: 0.3rem 0.75rem; border-radius: 2px; margin-bottom: 1rem; }ul { margin: 0 0 1rem 1.25rem; color: var(--gp-muted); font-size: 0.95rem; }li { margin-bottom: 0.4rem; }.back-link { display: inline-block; margin-bottom: 1.5rem; color: var(--gp-accent); font-weight: 600; text-decoration: none; }.cross-links { font-size: 0.85rem; color: var(--gp-muted); margin-top: 1.5rem; }.cross-links a { color: var(--gp-accent); text-decoration: none; }.price-box { background: var(--gp-surface); color: var(--gp-ink); border-radius: 2px; padding: 1.5rem; text-align: center; margin: 2rem 0; }.price-box .price { font-size: 2rem; font-weight: 800; }.price-box .price span { font-size: 1rem; font-weight: 500; color: var(--gp-muted); }.price-box p { color: var(--gp-muted); font-size: 0.85rem; margin: 0.5rem 0 1.25rem 0; }.pro-cta-btn { display: inline-block; background: var(--gp-accent); color: var(--gp-ink); border: none; padding: 0.9rem 1.75rem; border-radius: 2px; font-weight: 800; font-size: 0.95rem; text-decoration: none; transition: background 0.2s ease; }.pro-cta-btn:hover { background: var(--gp-accent); }.hypothesis-note { font-size: 0.78rem; color: var(--gp-muted); margin-top: 1rem !important; line-height: 1.4; }.disclaimer-box { background: var(--gp-surface); border: 1px solid var(--gp-line); color: var(--gp-muted); border-radius: 2px; padding: 0.9rem 1.1rem; font-size: 0.85rem; margin: 1.5rem 0; }
	</style>
</head>
<body>
<a href="#main-content" class="skip-link">Skip to main content</a>
<Header />
	<main class="gp-reading-page" id="main-content" tabindex="-1">
		<a href="/" class="back-link">← Back to GridPermit</a>
		<div class="badge-pill">Coming Soon: Not Yet Available</div>
		<h1>GridPermit Pro</h1>
		<p>For solar installers and permit specialists who are tired of rebuilding the same AHJ research, city by city, job by job.</p>

		<div class="disclaimer-box">
			<strong>This page describes a product that does not exist yet.</strong> We're gauging interest before building any of it. Clicking the button below records that you're interested. It does not create an account, start a trial, or charge you anything.
		</div>

		<h2>What it would include</h2>
		<ul>
			<li>Full AHJ requirements for every city GridPermit has verified: permit authority, required documents, permit fees, inspection steps</li>
			<li>Utility and interconnection details, source-linked and confidence-scored, the same way our free guides already are</li>
			<li>Saved AHJs across the cities you actually work in, instead of re-searching every time</li>
			<li>A downloadable permit checklist per city, ready to hand to a customer or a permit runner</li>
			<li>An alert when a jurisdiction's requirements change since you last checked</li>
		</ul>

		<div class="price-box">
			<div class="price">$29<span>/mo</span></div>
			<p>A hypothesis, not a committed price: this is what we'd expect to charge for a focused permit-research tool, not a full design/CRM platform.</p>
			<a href="mailto:support@mygridpermit.com?subject=GridPermit%20Pro%20interest" class="pro-cta-btn" data-track-click="pro_interest_clicked">I'd use this, notify me →</a>
			<p class="hypothesis-note">Opens an email to let us know you're interested. No account, no payment, no commitment.</p>
		</div>

		<h2>Why we're asking first</h2>
		<p>GridPermit already publishes free, verified permit guides for cities in every U.S. state. Before building accounts, billing, or a dashboard, we want real signal that installers and permit specialists would actually pay for a deeper version, not just build it and hope. See our <a href="/methodology/" style="color: var(--gp-accent);">Methodology</a> for how the underlying data is verified today.</p>

		<p class="cross-links"><a href="/">Home</a> · <a href="/search/">Browse all guides</a> · <a href="/how-it-works/">How It Works</a> · <a href="/contact/">Contact</a></p>
	</main>
<Footer />
</body>
</html>
