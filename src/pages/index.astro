<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>GridPermit | NEM 3.0 Solar & Battery ROI Calculator</title>
</head>
<body>
	<main class="container">
		<header class="hero">
			<h1>GridPermit</h1>
			<p>Calculate your exact solar payback period & battery savings under NEM 3.0 rules.</p>
		</header>

		<section class="calculator-card">
			<h2>NEM 3.0 Solar Savings Calculator</h2>
			<form id="solar-form">
				<div class="input-group">
					<label for="zip">ZIP Code</label>
					<input type="text" id="zip" placeholder="e.g. 90210" required />
				</div>
				<div class="input-group">
					<label for="bill">Average Monthly Electric Bill ($)</label>
					<input type="number" id="bill" placeholder="e.g. 250" required min="50" />
				</div>
				<button type="submit" class="btn-primary">Calculate My Savings</button>
			</form>

			<div id="results" class="results-box hidden">
				<h3>Your Estimated Savings</h3>
				<div class="stats-grid">
					<div class="stat">
						<span class="label">Solar Only Payback</span>
						<span class="value" id="payback-solar">--</span>
					</div>
					<div class="stat highlight">
						<span class="label">Solar + Battery Payback</span>
						<span class="value" id="payback-battery">--</span>
					</div>
				</div>

				<div class="lead-box">
					<h4>Get Matched With Top Pre-Vetted Local Installers</h4>
					<p>Lock in 30% federal tax credits and state battery incentives before rates rise.</p>
					<button class="btn-lead" type="button" onclick="alert('Lead capture integration active!')">Get My 3 Free Quotes</button>
				</div>
			</div>
		</section>

		<footer style="margin-top: 3rem; text-align: center; color: #64748b;">
			<p><a href="/blog" style="color: #2563eb; text-decoration: none; font-weight: bold;">Read Our Latest Solar Guides & Blog Posts &rarr;</a></p>
		</footer>
	</main>

	<script is:inline>
		const form = document.getElementById('solar-form');
		const results = document.getElementById('results');

		if (form) {
			form.addEventListener('submit', (e) => {
				e.preventDefault();
				const billInput = document.getElementById('bill');
				const bill = Number(billInput ? billInput.value : 250);
				
				const solarPayback = Math.max(7, Math.round(12 - (bill / 100)));
				const batteryPayback = Math.max(4, Math.round(7 - (bill / 150)));

				const elSolar = document.getElementById('payback-solar');
				const elBattery = document.getElementById('payback-battery');

				if (elSolar) elSolar.innerText = solarPayback + ' Years';
				if (elBattery) elBattery.innerText = batteryPayback + ' Years';

				if (results) results.classList.remove('hidden');
			});
		}
	</script>

	<style>
		body { background: #f1f5f9; margin: 0; padding: 0; }
		.container { max-width: 800px; margin: 0 auto; padding: 2rem; font-family: system-ui, sans-serif; }
		.hero { text-align: center; margin-bottom: 2rem; }
		.hero h1 { font-size: 3rem; color: #1e293b; margin-bottom: 0.5rem; }
		.calculator-card { background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 2rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
		.input-group { margin-bottom: 1.2rem; }
		.input-group label { display: block; margin-bottom: 0.4rem; font-weight: 600; color: #334155; }
		.input-group input { width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 1rem; box-sizing: border-box; }
		.btn-primary { width: 100%; padding: 0.85rem; background: #2563eb; color: white; border: none; border-radius: 6px; font-size: 1.1rem; font-weight: bold; cursor: pointer; }
		.btn-primary:hover { background: #1d4ed8; }
		.hidden { display: none; }
		.results-box { margin-top: 2rem; padding-top: 1.5rem; border-top: 2px dashed #cbd5e1; }
		.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1.5rem 0; }
		.stat { background: #f8fafc; padding: 1rem; border-radius: 8px; text-align: center; border: 1px solid #e2e8f0; }
		.stat.highlight { border: 2px solid #16a34a; background: #f0fdf4; }
		.stat .value { display: block; font-size: 1.5rem; font-weight: bold; margin-top: 0.5rem; color: #1e293b; }
		.lead-box { background: #1e293b; color: white; padding: 1.5rem; border-radius: 8px; text-align: center; margin-top: 1.5rem; }
		.btn-lead { background: #16a34a; color: white; border: none; padding: 0.8rem 1.5rem; border-radius: 6px; font-size: 1rem; font-weight: bold; cursor: pointer; margin-top: 0.5rem; }
	</style>
</body>
</html>
