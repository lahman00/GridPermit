<script>
 // Decorative motion starts only after load/paint and while the map is visible.
 const routeMap = document.querySelector<HTMLElement>('.gp-route-map');
 const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
 if (routeMap && !reducedMotion.matches && 'IntersectionObserver' in window) {
   const observeMap = () => requestAnimationFrame(() => requestAnimationFrame(() => {
     const observer = new IntersectionObserver(entries => {
       for (const entry of entries) {
         routeMap.toggleAttribute('data-visible', entry.isIntersecting);
         if (entry.isIntersecting) {
           routeMap.classList.add('has-entered');
           const device = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
           const canEnhance = !reducedMotion.matches && window.matchMedia('(min-width: 1021px) and (hover: hover) and (pointer: fine)').matches
             && !device.connection?.saveData && (device.deviceMemory ?? 4) >= 4
             && (device.hardwareConcurrency || 4) >= 4;
           if (canEnhance && !routeMap.dataset.depthRequested) {
             routeMap.dataset.depthRequested = 'true';
             void import('../lib/hero-depth').then(({ enableHeroDepth }) => enableHeroDepth(routeMap)).catch(() => {});
           }
         }
       }
     });
     observer.observe(routeMap);
   }));
   const device = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
   const canAnimatePage = window.matchMedia('(min-width: 1021px) and (hover: hover) and (pointer: fine)').matches
     && !device.connection?.saveData && (device.deviceMemory ?? 4) >= 4 && (device.hardwareConcurrency || 4) >= 4;
   const enhancePage = () => requestAnimationFrame(() => requestAnimationFrame(() => {
     if (canAnimatePage && !reducedMotion.matches) void import('../lib/home-motion').then(({ enhanceHomeMotion }) => enhanceHomeMotion()).catch(() => {});
   }));
   if (document.readyState === 'complete') enhancePage();
   else window.addEventListener('load', enhancePage, { once: true });
   if (document.readyState === 'complete') observeMap();
   else window.addEventListener('load', observeMap, { once: true });
 }
 const revealCalculator = () => { if (window.location.hash === '#calculator') document.getElementById('calculator')?.setAttribute('open', ''); };
 window.addEventListener('hashchange', revealCalculator); revealCalculator();
</script>

