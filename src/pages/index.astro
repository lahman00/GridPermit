		.stat-divider { width: 1px; height: 35px; background: rgba(255, 255, 255, 0.15); }

		.hero-trust-card { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: var(--radius); padding: 1.75rem; }
