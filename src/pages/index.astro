---
import Analytics from "../components/Analytics.astro";
import { SITE_ORIGIN } from "../lib/locality-guide";

// Organization + WebSite/SearchAction JSON-LD. The SearchAction's target
// actually works: src/pages/search.astro reads the same ?q= query param on
// load and runs the search immediately — the hero form below submits there.
const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "GridPermit",
	url: `${SITE_ORIGIN}/`,
};
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "GridPermit",
	url: `${SITE_ORIGIN}/`,
	potentialAction: {
		"@type": "SearchAction",
		target: `${SITE_ORIGIN}/search?q={search_term_string}`,
		"query-input": "required name=search_term_string",
	},
};

// These figures come from output/national-coverage-report.json and the
// per-state breakdown behind it (regenerated by
// scripts/evaluate-state-batch.mjs across every state) — not invented
// copy. If the underlying dataset changes, this text goes stale until
// someone re-checks it against a fresh coverage report; there is
// deliberately no live computation here (matching how the rest of the
// site's aggregate stats already work). Accurate as of 2026-08-15: 404
// verified locality records across all 50 states, 33 states with at
// least one published guide, 288 published guides in California alone
// (its deepest single coverage area by a wide margin).
---
<!DOCTYPE html>
<html lang="en">
<head>
	<Analytics />

	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>GridPermit - Solar Permit Guides for U.S. Cities (All 50 States)</title>
	<meta name="description" content="Search verified, source-linked solar permit guides for U.S. cities. Research on file for all 50 states — deepest coverage in California." />
<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
	<link rel="canonical" href="https://mygridpermit.com/" />
	<link rel="sitemap" href="/sitemap-index.xml" />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" class="async-font-css">
	<noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"></noscript>

	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://mygridpermit.com/" />
	<meta property="og:title" content="GridPermit - Solar Permit Guides for U.S. Cities (All 50 States)" />
	<meta property="og:description" content="Search verified, source-linked solar permit guides for U.S. cities. Research on file for all 50 states — deepest coverage in California." />
	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content="GridPermit - Solar Permit Guides for U.S. Cities (All 50 States)" />
	<meta name="twitter:description" content="Search verified, source-linked solar permit guides for U.S. cities. Research on file for all 50 states — deepest coverage in California." />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
	<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
</head>
