		.disclaimer-text { font-size: 0.72rem; color: #64748b; margin-bottom: 1.25rem; font-style: italic; }
		.lead-action-box { background: var(--bg-dark); color: white; border-radius: 10px; padding: 1.25rem; text-align: center; }
		.lead-action-box h3 { font-size: 1.05rem; font-weight: 700; }
		.lead-action-box p { font-size: 0.8rem; color: #94a3b8; margin: 0.3rem 0 0.8rem 0; }
		.btn-green-action-link { display: inline-block; background: var(--accent); color: white; border: none; padding: 0.85rem 1.5rem; border-radius: 6px; font-weight: 800; font-size: 0.9rem; text-decoration: none; transition: background 0.2s ease; }
		.btn-green-action-link:hover { background: #059669; }

		.guides-teaser { background: var(--bg-slate); padding: 3.5rem 1.5rem; border-top: 1px solid var(--border-color); }
