---
---
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>GridPermit - California NEM 3.0 Solar & Battery Calculator</title>
	<meta name="description" content="Estimate solar payback timelines, annual savings, and battery ROI under California's NEM 3.0 export rules." />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
	<div class="top-banner">
		California Incentive Notice: 30% Federal Tax Credit & SGIP Battery Rebates Available.
	</div>

	<nav class="navbar">
		<div class="nav-container">
			<a href="/" class="brand-logo" aria-label="GridPermit Home">
				<div class="logo-flex">
					<span class="logo-text">Grid<span class="logo-bold">Permit</span></span>
				</div>
			</a>
			<div class="nav-links">
				<a href="#calculator">ROI Calculator</a>
				<a href="/blog/solar-battery-payback-nem3">NEM 3.0 Guide</a>
				<a href="/blog/pge-rate-hikes-2026">PG&E Audit</a>
				<a href="/blog/sdge-battery-roi-guide">SDG&E Guide</a>
			</div>
			<a href="#calculator" class="btn-cta-nav">Get Free Audit</a>
		</div>
	</nav>

	<header class="hero">
		<div class="hero-overlay"></div>
		<div class="hero-container">
			<div class="hero-content">
				<div class="badge-pill">Independent California Solar & Battery Tool</div>
				<h1>Estimate Your Solar & Battery Payback Under NEM 3.0 Tariff Rules</h1>
				<p class="hero-lead">Utility export credits dropped significantly under CPUC rules. Get a preliminary payback and savings estimate in 30 seconds.</p>
				<div class="hero-stats">
					<div class="stat-item"><span class="stat-number">NEM 3.0</span><span class="stat-label">CPUC Baseline</span></div>
					<div class="stat-divider"></div>
					<div class="stat-item"><span class="stat-number">30%</span><span class="stat-label">Tax Credit Assumption</span></div>
					<div class="stat-divider"></div>
					<div class="stat-item"><span class="stat-number">Fast</span><span class="stat-label">Instant Calculation</span></div>
				</div>
			</div>

			<div class="calculator-glass-card" id="calculator">
				<div class="calc-header">
					<h3>Instant Solar & Battery Payback Estimate</h3>
					<p>Enter your ZIP code & monthly electric bill for regional baseline</p>
				</div>
				<form id="solar-form">
					<div class="input-field">
						<label for="zip">California ZIP Code</label>
						<input type="text" id="zip" placeholder="e.g. 90210" required pattern="[0-9]{5}" />
					</div>
					<div class="input-field">
						<label for="bill">Avg. Monthly Electric Bill ($)</label>
						<input type="number" id="bill" placeholder="e.g. 275" required min="25" max="5000" />
					</div>
					<button type="submit" class="btn-glow-submit">
						<span>Calculate Savings & Payback Range</span>
					</button>
				</form>

				<div id="results" class="results-container hidden">
					<div class="results-badge">Preliminary Estimate Calculated</div>
					
					<div class="results-table-wrap">
						<table class="results-table">
							<thead>
								<tr>
									<th>Scenario</th>
									<th>Estimated Payback</th>
									<th>Est. Annual Savings</th>
									<th>20-Yr Cumulative</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td><strong>Solar Only</strong></td>
									<td id="res-payback-solar">--</td>
									<td id="res-savings-solar">--</td>
									<td id="res-cumulative-solar">--</td>
								</tr>
								<tr class="highlight-row">
									<td><strong>Solar + Battery</strong></td>
									<td id="res-payback-battery">--</td>
									<td id="res-savings-battery">--</td>
									<td id="res-cumulative-battery">--</td>
								</tr>
							</tbody>
						</table>
					</div>

					<p class="disclaimer-text">*Illustrative estimate based on regional average rates. Detailed utility bill analysis required for precise design.</p>

					<div class="lead-action-box">
						<h4>Compare Up To 3 Local Vetted Quotes</h4>
						<p>Connect with up to three matched installers with active California licenses.</p>
						<button id="claim-btn" class="btn-green-action" type="button" onclick="document.getElementById('lead-form-wrap').classList.remove('hidden'); this.style.display='none';">
							Request Installer Comparison
						</button>
						<div id="lead-form-wrap" class="hidden lead-inline-form">
							<form id="lead-capture-form">
								<div class="input-field dark-input"><label for="fullname">Full Name</label><input type="text" id="fullname" placeholder="John Doe" required /></div>
								<div class="input-field dark-input"><label for="email">Email Address</label><input type="email" id="email" placeholder="john@example.com" required /></div>
								<div class="input-field dark-input"><label for="phone">Phone Number</label><input type="tel" id="phone" placeholder="(555) 000-0000" required /></div>
								
								<div class="tcpa-box">
									<label class="tcpa-label">
										<input type="checkbox" required />
										<span>I agree to receive calls, emails, and SMS from GridPermit and up to three matched installation partners at the phone number provided. Consent is not required to purchase. Msg & data rates may apply.</span>
									</label>
								</div>

								<button type="submit" class="btn-green-action" id="submit-lead-btn" style="width:100%; margin-top:0.5rem;">Request Vetted Quotes</button>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
	</header>

	<footer class="footer">
		<div class="footer-container">
			<p>© 2026 GridPermit. All rights reserved.</p>
			<p class="affiliate-disclosure">
				Disclaimer: GridPermit is an independent solar comparison platform operated by GridPermit Media LLC (30 N Gould St, Sheridan, WY). We are not affiliated with CPUC or any utility provider (PG&E, SCE, SDG&E). We may receive referral compensation when users request quotes.
			</p>
			<div class="footer-links">
				<a href="/about">About Us</a> | <a href="/contact">Contact</a> | <a href="/privacy">Privacy Policy & CCPA Rights</a> | <a href="/terms">Terms of Service</a>
			</div>
		</div>
	</footer>

	<script is:inline>
		const form = document.getElementById('solar-form');
		const results = document.getElementById('results');
		if (form) {
			form.addEventListener('submit', (e) => {
				e.preventDefault();
				const bill = Number(document.getElementById('bill')?.value || 250);
				
				const paybackSolar = Math.max(7, Math.round(12 - (bill / 120)));
				const paybackBattery = Math.max(4, Math.round(7 - (bill / 160)));
				
				const annualSavingsSolar = Math.round(bill * 12 * 0.45);
				const annualSavingsBattery = Math.round(bill * 12 * 0.82);

				const cumulativeSolar = annualSavingsSolar * 20;
				const cumulativeBattery = annualSavingsBattery * 20;

				document.getElementById('res-payback-solar').innerText = paybackSolar + ' - ' + (paybackSolar + 3) + ' Yrs';
				document.getElementById('res-payback-battery').innerText = paybackBattery + ' - ' + (paybackBattery + 2) + ' Yrs';

				document.getElementById('res-savings-solar').innerText = '$' + annualSavingsSolar.toLocaleString() + '/yr';
				document.getElementById('res-savings-battery').innerText = '$' + annualSavingsBattery.toLocaleString() + '/yr';

				document.getElementById('res-cumulative-solar').innerText = '$' + cumulativeSolar.toLocaleString();
				document.getElementById('res-cumulative-battery').innerText = '$' + cumulativeBattery.toLocaleString();

				if (results) results.classList.remove('hidden');
			});
		}
		const leadForm = document.getElementById('lead-capture-form');
		if (leadForm) {
			leadForm.addEventListener('submit', (e) => {
				e.preventDefault();
				const btn = document.getElementById('submit-lead-btn');
				if (btn) btn.innerText = "Request Submitted";
				alert('Thank you! Matched licensed installers in your area will reach out with your detailed audit.');
			});
		}
	</script>

	<style>
		:root { --primary: #2563eb; --primary-dark: #1d4ed8; --accent: #10b981; --bg-dark: #0f172a; --bg-slate: #f8fafc; --text-main: #0f172a; --text-muted: #64748b; --border-color: #e2e8f0; --radius: 16px; }
		* { box-sizing: border-box; margin: 0; padding: 0; }
		body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background-color: var(--bg-slate); color: var(--text-main); line-height: 1.6; }
		.top-banner { background: #1e293b; color: #cbd5e1; text-align: center; padding: 0.6rem 1rem; font-size: 0.85rem; font-weight: 500; }
		.navbar { background: white; border-bottom: 1px solid var(--border-color); padding: 0.85rem 2rem; position: sticky; top: 0; z-index: 100; }
		.nav-container { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
		.brand-logo { text-decoration: none; display: inline-block; }
		.logo-flex { display: flex; align-items: center; gap: 0.75rem; }
		.logo-text { font-size: 1.75rem; font-weight: 400; color: #0F172A; }
		.logo-bold { font-weight: 800; }
		.nav-links { display: flex; gap: 1.5rem; }
		.nav-links a { text-decoration: none; color: var(--text-muted); font-weight: 600; font-size: 0.9rem; }
		.btn-cta-nav { background: var(--primary); color: white; padding: 0.6rem 1.25rem; border-radius: 8px; font-weight: 700; text-decoration: none; font-size: 0.9rem; }
		.hero { position: relative; background: #0f172a; padding: 5rem 1.5rem 6rem 1.5rem; color: white; }
		.hero-container { position: relative; z-index: 10; max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: center; }
		@media (max-width: 960px) { .hero-container { grid-template-columns: 1fr; } }
		.badge-pill { display: inline-flex; align-items: center; background: rgba(37, 99, 235, 0.2); border: 1px solid rgba(96, 165, 250, 0.3); color: #93c5fd; padding: 0.4rem 1rem; border-radius: 9999px; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; margin-bottom: 1.25rem; }
		.hero h1 { font-size: 2.8rem; font-weight: 800; line-height: 1.15; margin-bottom: 1rem; }
		.hero-lead { font-size: 1.15rem; color: #94a3b8; margin-bottom: 2rem; max-width: 580px; }
		.hero-stats { display: flex; align-items: center; gap: 1.5rem; background: rgba(255, 255, 255, 0.05); padding: 1.25rem; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.1); width: fit-content; }
		.stat-number { display: block; font-size: 1.25rem; font-weight: 800; color: #38bdf8; }
		.stat-label { font-size: 0.7rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; }
		.stat-divider { width: 1px; height: 35px; background: rgba(255, 255, 255, 0.15); }
		.calculator-glass-card { background: rgba(255, 255, 255, 0.95); border-radius: var(--radius); padding: 2.25rem; color: var(--text-main); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35); }
		.calc-header h3 { font-size: 1.4rem; font-weight: 800; }
		.calc-header p { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.5rem; }
		.input-field { margin-bottom: 1.25rem; }
		.input-field label { display: block; font-size: 0.85rem; font-weight: 700; color: #334155; margin-bottom: 0.4rem; }
		.input-field input { width: 100%; padding: 0.85rem 1rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; }
		.btn-glow-submit { width: 100%; background: var(--primary); color: white; border: none; padding: 1.1rem; border-radius: 10px; font-size: 1rem; font-weight: 800; cursor: pointer; }
		.hidden { display: none; }
		.results-container { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 2px dashed #cbd5e1; }
		.results-badge { display: inline-block; background: #dcfce7; color: #166534; font-size: 0.75rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 4px; text-transform: uppercase; margin-bottom: 0.75rem; }
		.results-table-wrap { overflow-x: auto; margin-bottom: 0.75rem; }
		.results-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left; }
		.results-table th, .results-table td { padding: 0.6rem; border-bottom: 1px solid var(--border-color); }
		.results-table th { background: #f1f5f9; color: var(--text-muted); font-weight: 700; font-size: 0.75rem; text-transform: uppercase; }
		.highlight-row { background: #f0fdf4; font-weight: 700; color: #166534; }
		.disclaimer-text { font-size: 0.72rem; color: #64748b; margin-bottom: 1.25rem; font-style: italic; }
		.lead-action-box { background: var(--bg-dark); color: white; border-radius: 10px; padding: 1.25rem; text-align: center; }
		.lead-action-box h4 { font-size: 1.05rem; font-weight: 700; }
		.lead-action-box p { font-size: 0.8rem; color: #94a3b8; margin: 0.3rem 0 0.8rem 0; }
		.btn-green-action { background: var(--accent); color: white; border: none; padding: 0.75rem 1.25rem; border-radius: 6px; font-weight: 800; font-size: 0.9rem; cursor: pointer; }
		.lead-inline-form { margin-top: 1rem; text-align: left; }
		.dark-input label { color: #cbd5e1 !important; }
		.tcpa-box { margin: 1rem 0; }
		.tcpa-label { display: flex; gap: 0.5rem; font-size: 0.72rem; color: #94a3b8; line-height: 1.3; }
		.tcpa-label input { margin-top: 2px; }
		.footer { background: var(--bg-dark); color: white; padding: 2.5rem 1.5rem; text-align: center; border-top: 1px solid rgba(255, 255, 255, 0.1); }
		.affiliate-disclosure { font-size: 0.75rem; color: #64748b; max-width: 800px; margin: 0.75rem auto; line-height: 1.4; }
		.footer-links { margin-top: 0.75rem; font-size: 0.85rem; }
		.footer-links a { color: #94a3b8; text-decoration: none; margin: 0 0.5rem; }
	</style>
</body>
</html>
