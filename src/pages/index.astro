			.spinner { animation: none; }
		}
		.results-container { margin-top: 1rem; }
		.results-badge { display: inline-block; background: #dcfce7; color: #166534; font-size: 0.8rem; font-weight: 800; padding: 0.3rem 0.75rem; border-radius: 6px; text-transform: uppercase; margin-bottom: 1rem; }
		.illustrative-badge { background: #fef3c7; color: #92400e; }
		.main-savings-card { background: #1e293b; color: white; padding: 1.25rem; border-radius: 12px; text-align: center; margin-bottom: 1rem; }
