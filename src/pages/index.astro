              <path d="m283 144 20-12v48l-20 12Z" fill="var(--scene-right)" stroke="var(--scene-edge)"/>
              <path d="m263 132 20-12 20 12-20 12Z" fill="var(--scene-top)" stroke="var(--scene-edge)"/>
              <path d="m268 149 10 6v17l-10-6Z" fill="var(--scene-roof)"/>
              <path d="m271 155 3 2-2 5 4-1-4 6 1-6-3 1Z" fill="var(--gp-accent)"/>
              <path d="M283 121V104" fill="none" stroke="var(--scene-edge)" stroke-width="3"/>
              <circle cx="283" cy="98" r="11" fill="var(--gp-accent)"/>
              <path d="m278 98 4 4 6-8" fill="none" stroke="var(--gp-accent-ink)" stroke-width="2.5"/>
              <!-- Inspection marker and two small landscape elements. -->
              <ellipse cx="221" cy="226" rx="12" ry="7" fill="var(--scene-shadow)" opacity=".15"/>
              <path d="M221 222v-22" stroke="var(--gp-accent)" stroke-width="3"/>
              <circle cx="221" cy="191" r="12" fill="var(--scene-top)" stroke="var(--gp-accent)" stroke-width="3"/>
              <path d="m216 191 4 4 7-9" fill="none" stroke="var(--gp-accent)" stroke-width="2.5"/>
              <g><ellipse cx="66" cy="206" rx="10" ry="5" fill="var(--scene-shadow)" opacity=".12"/><path d="M66 203v-20" stroke="var(--scene-roof)" stroke-width="3"/><circle cx="66" cy="177" r="11" fill="var(--scene-foliage)"/><circle cx="62" cy="171" r="8" fill="var(--scene-foliage-light)"/></g>
              <g><ellipse cx="324" cy="220" rx="8" ry="4" fill="var(--scene-shadow)" opacity=".12"/><path d="M324 218v-15" stroke="var(--scene-roof)" stroke-width="2"/><circle cx="324" cy="198" r="9" fill="var(--scene-foliage)"/><circle cx="321" cy="193" r="6" fill="var(--scene-foliage-light)"/></g>
            </svg>
            <div class="gp-route-label gp-route-label--permit"><span>01</span><strong>Permit</strong><small>Local authority</small></div>
            <div class="gp-route-label gp-route-label--inspect"><span>02</span><strong>Inspection</strong><small>Field approval</small></div>
            <div class="gp-route-label gp-route-label--pto"><span>03</span><strong>PTO</strong><small>Utility approval</small></div>
            </div>
            <div class="gp-route-readout"><span><i></i> Verified facts</span><span>No contact info</span></div>
