---
import QuickSearch from "../components/QuickSearch.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import DesignHead from "../components/DesignHead.astro";
import Analytics from "../components/Analytics.astro";
import ProjectNavigator from "../components/ProjectNavigator.astro";
import { SITE_ORIGIN } from "../lib/locality-guide";
import { getPartner, getCplState, getCplDisclosureText } from "../lib/partners";

const energysage = getPartner("energysage")!;
const energysageDisclosure = getCplDisclosureText(getCplState(energysage), energysage.name);

// Organization + WebSite/SearchAction JSON-LD. The SearchAction's target
// actually works: src/pages/search.astro reads the same ?q= query param on
// load and runs the search immediately — the hero form below submits there.
const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "GridPermit",
	url: `${SITE_ORIGIN}/`,
	logo: `${SITE_ORIGIN}/brand/gridpermit-logo.png`,
};
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "GridPermit",
	url: `${SITE_ORIGIN}/`,
	potentialAction: {
		"@type": "SearchAction",
		target: `${SITE_ORIGIN}/search?q={search_term_string}`,
		"query-input": "required name=search_term_string",
	},
};

// The redesign deliberately avoids frozen coverage totals. Discovery pages derive their counts from the canonical records.
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
	<Analytics />
	<DesignHead />

	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>GridPermit - Solar Permit Guides for U.S. Cities (All 50 States)</title>
	<meta name="description" content="Search verified, source-linked solar permit guides for U.S. cities. Research on file for all 50 states — deepest coverage in California." />
<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
	<meta name="fo-verify" content="d0b5e74a-b083-4814-9569-032b16bd5fb6" />
	<link rel="canonical" href="https://mygridpermit.com/" />
	<link rel="sitemap" href="/sitemap-index.xml" />

	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://mygridpermit.com/" />
	<meta property="og:title" content="GridPermit - Solar Permit Guides for U.S. Cities (All 50 States)" />
	<meta property="og:description" content="Search verified, source-linked solar permit guides for U.S. cities. Research on file for all 50 states — deepest coverage in California." />
	<meta property="og:image" content="https://mygridpermit.com/brand/gridpermit-banner.png" />
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content="GridPermit - Solar Permit Guides for U.S. Cities (All 50 States)" />
	<meta name="twitter:description" content="Search verified, source-linked solar permit guides for U.S. cities. Research on file for all 50 states — deepest coverage in California." />
	<meta name="twitter:image" content="https://mygridpermit.com/brand/gridpermit-banner.png" />
	<link rel="icon" type="image/svg+xml" href="/brand/gridpermit-mark.svg" />
	<link rel="icon" type="image/png" href="/brand/gridpermit-favicon.png" sizes="64x64" />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
	<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
</head>
<body>
	<a href="#main-content" class="skip-link">Skip to main content</a>


	<Header />

	<main class="gp-home" id="main-content" tabindex="-1">
      <section class="gp-home-hero gp-container" aria-labelledby="home-heading">
        <div class="gp-hero-stage">
          <div class="gp-hero-copy">
            <p class="gp-kicker"><span class="gp-accent">Local knowledge</span> / Solar permitting</p>
            <h1 id="home-heading">Solar permitting,<br/><span>without the guessing.</span></h1>
            <p class="gp-home-lead">Local permit requirements. Utility approvals.<br/>The official sources behind your next step.</p>
            <QuickSearch />
          </div>
          <div class="gp-route-map" aria-hidden="true">
            <div class="gp-route-map-head"><span>Project route</span><span>Source linked</span></div>
            <svg viewBox="0 0 400 390" role="presentation">
              <g class="gp-route-grid">
                <path d="M40 48H360M40 133H360M40 218H360M40 303H360" />
                <path d="M80 24V344M200 24V344M320 24V344" />
              </g>
              <path class="gp-route-line-shadow" d="M70 286C105 286 118 231 157 231S203 150 246 150s49-70 91-70" />
              <path class="gp-route-line" d="M70 286C105 286 118 231 157 231S203 150 246 150s49-70 91-70" />
              <g class="gp-route-node gp-route-node--one" transform="translate(70 286)"><circle r="15"/><circle r="4"/></g>
              <g class="gp-route-node gp-route-node--two" transform="translate(200 178)"><circle r="15"/><circle r="4"/></g>
              <g class="gp-route-node gp-route-node--three" transform="translate(337 80)"><circle r="19"/><path d="m-7 0 5 5L8-7" /></g>
            </svg>
            <div class="gp-route-label gp-route-label--permit"><span>01</span><strong>Permit</strong><small>Local authority</small></div>
            <div class="gp-route-label gp-route-label--inspect"><span>02</span><strong>Inspection</strong><small>Field approval</small></div>
            <div class="gp-route-label gp-route-label--pto"><span>03</span><strong>PTO</strong><small>Utility approval</small></div>
            <div class="gp-route-readout"><span><i></i> Verified facts</span><span>No contact info</span></div>
          </div>
        </div>
        <div class="gp-home-hero-bottom"><span>Find. Understand. Act.</span><a href="#know-your-path">Scroll to explore <span aria-hidden="true">↓</span></a></div>
      </section>
      <ProjectNavigator />
      <section class="gp-container gp-home-section gp-home-path" id="know-your-path">
        <div><p class="gp-kicker">01 / Know your path</p><h2>City permit.<br/>Utility approval.<br/><span class="gp-muted-heading">Not the same thing.</span></h2></div>
        <div class="gp-home-track-list">
          <div><span class="gp-kicker">Local authority</span><h3>The installation.</h3><p>Your city or county handles the permit and local inspection requirements. Start with the authority named in your guide.</p></div>
          <div><span class="gp-kicker">Electric utility</span><h3>The connection.</h3><p>Your electric utility handles interconnection and permission to operate. A building permit does not replace utility approval.</p></div>
          <a href="/how-it-works/" class="gp-text-link">Understand the process <span aria-hidden="true">↗</span></a>
        </div>
      </section>
      <section class="gp-container gp-home-section gp-home-discover">
        <div><p class="gp-kicker">02 / Start locally</p><h2>Every place.<br/>Its own requirements.</h2><p>Find the guidance we have published for your location. Where research is incomplete, we say so.</p></div>
        <nav aria-label="Explore permit guidance" class="gp-explore-rows">
          <a href="/california/"><span><small>Our deepest coverage</small>California</span><span aria-hidden="true">↗</span></a>
          <a href="/permits/"><span><small>Local research, nationwide</small>Browse by state</span><span aria-hidden="true">↗</span></a>
          <a href="/blog/"><span><small>Permits, utilities &amp; batteries</small>Solar guides</span><span aria-hidden="true">↗</span></a>
        </nav>
      </section>
      <section class="gp-statement" aria-labelledby="trust-heading"><div class="gp-container"><p class="gp-kicker">Our standard</p><h2 id="trust-heading">We don't fill gaps<br/>with guesses.</h2><a href="/methodology/">Read our methodology <span aria-hidden="true">↗</span></a></div></section>
      <section class="gp-container gp-home-section gp-trust-editorial">
        <p class="gp-kicker">03 / Evidence, not assumptions</p>
        <div><h2>Know what is verified.<br/>See what is not.</h2><p>Read the permit facts alongside their sources, access dates and confidence notes. Check the local authority's current requirements before making a project decision.</p><a href="/search/" class="gp-text-link">Find your local guide <span aria-hidden="true">↗</span></a></div>
      </section>
<section class="gp-container gp-lab-section" aria-label="Illustrative tool">
<details id="calculator" class="gp-lab"><summary><span class="gp-kicker">Optional / Illustrative tool</span>California system-sizing estimator <span aria-hidden="true">+</span></summary>
		<div class="calculator-section-inner">
			<div class="calculator-section-header">
				<div class="badge-pill-light">California-Only Tool</div>
				<h2>California system-sizing estimator</h2>
				<p>A separate, smaller tool from our permit guides above: a quick, clearly-labeled illustrative estimate for California ZIP codes only. Not a substitute for a real utility rate lookup or installer quote.</p>
			</div>

			<div class="calculator-glass-card">
				<div class="calc-header">
					<h3>Enter a California ZIP Code</h3>
					<p>Takes only 30 seconds • No contact info required • California ZIP codes only</p>
				</div>

				<form id="solar-form">
					<div class="input-field">
						<label for="zip">California ZIP Code</label>
						<input type="text" id="zip" placeholder="e.g. 90210, 94103, 92101" required pattern="[0-9]{5}" />
						<div id="utility-detected" class="utility-pill hidden">✓ ZIP code is within California's range</div>
						<div id="utility-not-ca" class="utility-pill-warn hidden">This doesn't look like a California ZIP code. This estimator currently covers California only. Try our <a href="/search/">location search</a> instead for other states.</div>
					</div>
					<div class="input-field">
						<label for="bill">Avg. Monthly Electric Bill ($)</label>
						<input type="number" id="bill" placeholder="e.g. 250" required min="25" max="5000" />
					</div>
					<button type="submit" class="btn-glow-submit" id="calc-btn">
						<span id="btn-text">See My Preliminary Estimate →</span>
					</button>
				</form>

				<div id="loading-box" class="loading-container hidden">
					<div class="spinner"></div>
					<p id="loading-text">Applying statewide placeholder assumptions...</p>
				</div>

				<div id="results" class="results-container hidden">
					<div class="results-badge illustrative-badge">⚠ Illustrative Only: Not Utility-Specific</div>

					<div class="main-savings-card">
						<span class="savings-head">20-Year Savings & Payback</span>
						<span class="savings-amount coming-soon">Coming Soon</span>
						<span class="savings-sub">Requires real utility rate data (PG&E / SCE / SDG&E) we haven't integrated yet</span>
					</div>

					<div class="confidence-box">
						<div class="conf-header">
							<span>What this estimate is (and isn't)</span>
						</div>
						<ul class="conf-list">
							<li>✓ Confirms your ZIP code falls within California's range</li>
							<li>✓ Gives a rough system-size figure from one flat, disclosed placeholder rate (see below)</li>
							<li>✗ Does <strong>not</strong> look up your actual utility (PG&E / SCE / SDG&E) or rate schedule (coming soon)</li>
							<li>✗ Does <strong>not</strong> estimate dollar savings or payback yet: that requires real rate data we don't have</li>
							<li>⚡ <em>The number below is a rough sizing figure, not a quote or financial projection</em></li>
						</ul>
					</div>

					<div class="results-metrics-grid">
						<div class="metric-card">
							<span class="m-label">Illustrative System Size</span>
							<span class="m-val" id="res-sys-size">0.0 kW</span>
						</div>
						<div class="metric-card">
							<span class="m-label">Typical Battery Range</span>
							<span class="m-val">10–20 kWh (site-dependent)</span>
						</div>
					</div>

					<div class="results-table-wrap">
						<table class="results-table">
							<thead>
								<tr>
									<th scope="col">Configuration</th>
									<th scope="col">Payback Period</th>
									<th scope="col">Annual Savings</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td><strong>Solar Only</strong></td>
									<td>Coming Soon</td>
									<td>Coming Soon</td>
								</tr>
								<tr class="highlight-row">
									<td><strong>Solar + Battery</strong></td>
									<td>Coming Soon</td>
									<td>Coming Soon</td>
								</tr>
							</tbody>
						</table>
					</div>

					<p class="disclaimer-text">*Illustrative estimate based on one flat, statewide placeholder assumption, not your actual utility rate, solar production, or property details. Actual system size, pricing, incentives, and savings vary significantly. Review our <a href="/methodology/" style="color: var(--gp-accent);">Methodology</a> and verify final figures with a qualified installer.</p>

					<div class="lead-action-box">
						<h3>Compare Quotes From Solar Installers</h3>
						<p>EnergySage is an independent solar marketplace where you can request property-specific pricing from installers.</p>
						<a href={energysage.destination} target="_blank" rel="noopener noreferrer" class="btn-green-action-link" data-track-click="external_partner_clicked">
							Visit EnergySage →
						</a>
						<p style="font-size: 0.75rem; color: var(--gp-muted); margin-top: 0.75rem; line-height: 1.4;">
							You’ll continue on {energysage.name}’s website. {energysageDisclosure}
						</p>
					</div>
				</div>
			</div>
		</div>
	</details>
</section>
</main>

	<Footer />

	<script>
		import { trackEvent } from "../lib/analytics-events";

		document.addEventListener("DOMContentLoaded", () => {
			// Honest-MVP notice: these are the ONLY two assumptions behind the system-size
			// figure below, and both are flat statewide placeholders — not real utility
			// rate or solar-production data. See /methodology for the full explanation.
			const PLACEHOLDER_RATE_PER_KWH = 0.30; // not a real PG&E/SCE/SDG&E rate
			const PLACEHOLDER_YIELD_KWH_PER_KW_YEAR = 1400; // rough statewide placeholder, not location-specific

			// California ZIP codes fall in the 90001-96162 range. This is a structural
			// range check only — it does not identify a specific utility or address.
			function isCaliforniaZip(zip: string): boolean {
				const n = Number(zip);
				return /^\d{5}$/.test(zip) && n >= 90001 && n <= 96162;
			}

			const zipInput = document.getElementById("zip") as HTMLInputElement | null;
			const caPill = document.getElementById("utility-detected");
			const notCaPill = document.getElementById("utility-not-ca");

			if (zipInput && caPill && notCaPill) {
				zipInput.addEventListener("input", (e) => {
					const val = (e.target as HTMLInputElement).value;
					if (val.length !== 5) {
						caPill.classList.add("hidden");
						notCaPill.classList.add("hidden");
						return;
					}
					if (isCaliforniaZip(val)) {
						caPill.classList.remove("hidden");
						notCaPill.classList.add("hidden");
					} else {
						caPill.classList.add("hidden");
						notCaPill.classList.remove("hidden");
					}
				});
			}

			const form = document.getElementById("solar-form");
			const loadingBox = document.getElementById("loading-box");
			const loadingText = document.getElementById("loading-text");
			const results = document.getElementById("results");

			if (form && loadingBox && loadingText && results && zipInput && notCaPill) {
				form.addEventListener("submit", (e) => {
					e.preventDefault();

					const zipVal = zipInput.value || "";
					if (!isCaliforniaZip(zipVal)) {
						notCaPill.classList.remove("hidden");
						zipInput.focus();
						return;
					}

					trackEvent("calculator_started");

					form.classList.add("hidden");
					loadingBox.classList.remove("hidden");

					setTimeout(() => { loadingText.innerText = "Applying statewide placeholder assumptions..."; }, 800);
					setTimeout(() => { loadingText.innerText = "Building your illustrative estimate..."; }, 1600);

					setTimeout(() => {
						loadingBox.classList.add("hidden");
						results.classList.remove("hidden");

						const billInput = document.getElementById("bill") as HTMLInputElement | null;
						const bill = Number(billInput?.value || 250);

						// The only figure this MVP computes: a rough system-size guess,
						// derived transparently from the two placeholder constants above.
						const annualKwh = (bill * 12) / PLACEHOLDER_RATE_PER_KWH;
						const sysKw = annualKwh / PLACEHOLDER_YIELD_KWH_PER_KW_YEAR;

						const sysSizeEl = document.getElementById("res-sys-size");
						if (sysSizeEl) sysSizeEl.innerText = sysKw.toFixed(1) + " kW";
						trackEvent("calculator_completed");
					}, 2400);
				});
			}
		});
	</script>

<style>
