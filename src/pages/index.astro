 .utility-pill,.utility-pill-warn { font-size: 13px; color: var(--gp-muted); margin-top: 10px; }
 .btn-glow-submit,.btn-green-action-link { display: inline-block; border: 1px solid var(--gp-line); background: var(--gp-surface); padding: 16px 24px; color: var(--gp-ink); font-size: 14px; text-decoration: none; border-radius: 2px; }
 .loading-container { padding: 30px 0; }
 .results-container { padding: 24px 0; }
 .results-badge,.savings-head,.m-label { display: block; font: 11px/1.6 var(--gp-mono); text-transform: uppercase; margin-bottom: 12px; }
 .main-savings-card,.confidence-box,.lead-action-box { padding: 24px 0; border-top: 1px solid var(--gp-line); margin-top: 24px; }
 .savings-amount { display: block; font-size: 32px; }
 .savings-sub,.conf-list,.disclaimer-text { font-size: 13px; color: var(--gp-muted); }
 .results-metrics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding: 24px 0; }
 .results-table-wrap { overflow-x: auto; }
 .lead-action-box p { color: var(--gp-muted); font-size: 14px; }
 @media (max-width: 1020px) { .gp-hero-stage { grid-template-columns: 1fr; } .gp-route-map { width: min(100%, 560px); min-height: 330px; } }
 @media (max-width: 900px) { .gp-home-path,.gp-home-discover { gap: 50px; } }
 @media (max-width: 760px) {
  .gp-home-hero { min-height: auto; padding-top: 62px; }
  .gp-home-hero h1 { font-size: clamp(40px,8.5vw,60px); }
  .gp-home-lead { font-size: 16px; }
  .gp-hero-copy > .gp-kicker { font-size: 10px; margin-bottom: 30px; }
  .gp-hero-stage { gap: 46px; }
  .gp-route-map { min-height: 300px; }
  .gp-route-label { grid-template-columns: 20px auto; padding: 4px 5px; }
  .gp-route-label--permit { left: 24%; top: 71%; }
  .gp-route-label--inspect { left: 53%; top: 48%; }
  .gp-route-label--pto { right: 19%; top: 10%; }
  .gp-home-hero-bottom { margin-top: 58px; font-size: 8px; gap: 20px; }
  .gp-home-section { padding-block: 64px; }
  .gp-home-path,.gp-home-discover,.gp-trust-editorial { grid-template-columns: 1fr; gap: 32px; }
  .gp-statement { padding-block: 60px; }
  .gp-lab > summary { flex-wrap: wrap; font-size: 14px; }
  .gp-lab > summary .gp-kicker { flex-basis: 100%; }
 }
 @media (prefers-reduced-motion: reduce) {
  .gp-route-line { animation: none; stroke-dashoffset: 0; }
  .gp-route-node--two,.gp-route-node--three,.gp-route-readout i { animation: none; }
 }
</style>
<script>
 const revealCalculator = () => { if (window.location.hash === '#calculator') document.getElementById('calculator')?.setAttribute('open', ''); };
 window.addEventListener('hashchange', revealCalculator); revealCalculator();
</script>

