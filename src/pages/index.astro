---
import Analytics from "../components/Analytics.astro";
import { SITE_ORIGIN } from "../lib/locality-guide";

// Organization + WebSite/SearchAction JSON-LD — no page on the site declared
// these site-wide schema types before. The SearchAction's target actually
// works: src/pages/search.astro reads the same ?q= query param on load.
const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "GridPermit",
	url: `${SITE_ORIGIN}/`,
};
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "GridPermit",
	url: `${SITE_ORIGIN}/`,
	potentialAction: {
		"@type": "SearchAction",
		target: `${SITE_ORIGIN}/search?q={search_term_string}`,
		"query-input": "required name=search_term_string",
	},
};
---
<!DOCTYPE html>
<html lang="en">
<head>
	<Analytics />

	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>GridPermit - California Solar & Battery Savings Estimator (2026)</title>
	<meta name="description" content="An educational, California-only starting point for home solar and battery payback questions. Illustrative estimates only — not a utility rate lookup." />
<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
	<link rel="canonical" href="https://mygridpermit.com/" />
	<link rel="sitemap" href="/sitemap-index.xml" />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" class="async-font-css">
	<noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"></noscript>

	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://mygridpermit.com/" />
	<meta property="og:title" content="GridPermit - California Solar & Battery Savings Estimator (2026)" />
	<meta property="og:description" content="An educational, California-only starting point for home solar and battery payback questions. Illustrative estimates only — not a utility rate lookup." />
	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content="GridPermit - California Solar & Battery Savings Estimator (2026)" />
	<meta name="twitter:description" content="An educational, California-only starting point for home solar and battery payback questions. Illustrative estimates only — not a utility rate lookup." />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
	<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
</head>
<body>
	<a href="#main-content" class="skip-link">Skip to main content</a>
	<div class="top-banner">
		Independent Educational Guide: Residential solar permit facts for verified jurisdictions across 37 states (CA, RI, DE, VT, CO, AZ, HI, OR, NM, NV, IL, NJ, UT, MD, VA, NC, SC, GA, WI, MN, CT, NH, WA, ID, FL, KY, TN, PA, AK, NY, WV, OK, TX, AR, AL, IA, NE), plus a California solar & battery savings estimator. Illustrative only — not utility-specific.
	</div>

	<nav class="navbar">
		<div class="nav-container">
			<a href="/" class="brand-logo" aria-label="GridPermit Home">
				<div class="logo-flex">
					<span class="logo-text">Grid<span class="logo-bold">Permit</span></span>
				</div>
			</a>
			<div class="nav-links">
				<a href="#calculator">ROI Calculator</a>
				<a href="/how-it-works">How It Works</a>
				<a href="/california/solar-permit-guides/">California Guides</a>
				<a href="/blog">Blog</a>
				<a href="/about">About</a>
				<a href="/methodology">Methodology</a>
				<a href="/contact">Contact</a>
			</div>
			<a href="/search" class="nav-search-link" aria-label="Search">🔍</a>
			<a href="#calculator" class="btn-cta-nav">Estimate Savings</a>
		</div>
	</nav>

	<main class="hero" id="main-content" tabindex="-1">
		<div class="hero-container">
			<div class="hero-content">
				<div class="badge-pill">Independent California Solar & Battery Estimator</div>
				<h1>A Straight-Talk Starting Point for Solar & Battery in California</h1>
				<p class="hero-lead">Enter a California ZIP code and your monthly bill for a quick, clearly-labeled illustrative estimate — not a substitute for a real utility rate lookup or installer quote.</p>
				<div class="hero-stats">
					<div class="stat-item"><span class="stat-number">California</span><span class="stat-label">Only, For Now</span></div>
					<div class="stat-divider"></div>
					<div class="stat-item"><span class="stat-number">Illustrative</span><span class="stat-label">Not Utility-Specific</span></div>
					<div class="stat-divider"></div>
					<div class="stat-item"><span class="stat-number">30 Sec</span><span class="stat-label">No Contact Info</span></div>
				</div>
				<p style="font-size: 0.85rem; color: #94a3b8; margin-top: 1.5rem;">
					This estimate uses one flat, clearly-labeled placeholder assumption for the whole state — it does not yet look up your actual utility, rate schedule, or solar production data. See our <a href="/methodology" style="color:#93c5fd;">Methodology</a> for exactly what is and isn't modeled.
				</p>
			</div>

			<div class="calculator-glass-card" id="calculator">
				<div class="calc-header">
					<h2>California Solar & Battery Estimator</h2>
					<p>Takes only 30 seconds • No contact info required • California ZIP codes only</p>
				</div>

				<form id="solar-form">
					<div class="input-field">
						<label for="zip">California ZIP Code</label>
						<input type="text" id="zip" placeholder="e.g. 90210, 94103, 92101" required pattern="[0-9]{5}" />
						<div id="utility-detected" class="utility-pill hidden">✓ ZIP code is within California's range</div>
						<div id="utility-not-ca" class="utility-pill-warn hidden">This doesn't look like a California ZIP code. GridPermit currently covers California only.</div>
					</div>
					<div class="input-field">
						<label for="bill">Avg. Monthly Electric Bill ($)</label>
						<input type="number" id="bill" placeholder="e.g. 250" required min="25" max="5000" />
					</div>
					<button type="submit" class="btn-glow-submit" id="calc-btn">
						<span id="btn-text">See My Preliminary Estimate →</span>
					</button>
				</form>

				<div id="loading-box" class="loading-container hidden">
					<div class="spinner"></div>
					<p id="loading-text">Applying statewide placeholder assumptions...</p>
				</div>

				<div id="results" class="results-container hidden">
					<div class="results-badge illustrative-badge">⚠ Illustrative Only — Not Utility-Specific</div>

					<div class="main-savings-card">
						<span class="savings-head">20-Year Savings & Payback</span>
						<span class="savings-amount coming-soon">Coming Soon</span>
						<span class="savings-sub">Requires real utility rate data (PG&E / SCE / SDG&E) we haven't integrated yet</span>
					</div>

					<div class="confidence-box">
						<div class="conf-header">
							<span>What this estimate is — and isn't</span>
						</div>
						<ul class="conf-list">
							<li>✓ Confirms your ZIP code falls within California's range</li>
							<li>✓ Gives a rough system-size figure from one flat, disclosed placeholder rate — see below</li>
							<li>✗ Does <strong>not</strong> look up your actual utility (PG&E / SCE / SDG&E) or rate schedule — coming soon</li>
							<li>✗ Does <strong>not</strong> estimate dollar savings or payback yet — that requires real rate data we don't have</li>
							<li>⚡ <em>The number below is a rough sizing figure, not a quote or financial projection</em></li>
						</ul>
					</div>

					<div class="results-metrics-grid">
						<div class="metric-card">
							<span class="m-label">Illustrative System Size</span>
							<span class="m-val" id="res-sys-size">0.0 kW</span>
						</div>
						<div class="metric-card">
							<span class="m-label">Typical Battery Range</span>
							<span class="m-val">10–20 kWh (site-dependent)</span>
						</div>
					</div>

					<div class="results-table-wrap">
						<table class="results-table">
							<thead>
								<tr>
									<th scope="col">Configuration</th>
									<th scope="col">Payback Period</th>
									<th scope="col">Annual Savings</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td><strong>Solar Only</strong></td>
									<td>Coming Soon</td>
									<td>Coming Soon</td>
								</tr>
								<tr class="highlight-row">
									<td><strong>Solar + Battery</strong></td>
									<td>Coming Soon</td>
									<td>Coming Soon</td>
								</tr>
							</tbody>
						</table>
					</div>

					<p class="disclaimer-text">*Illustrative estimate based on one flat, statewide placeholder assumption — not your actual utility rate, solar production, or property details. Actual system size, pricing, incentives, and savings vary significantly. Review our <a href="/methodology" style="color:#2563eb;">Methodology</a> and verify final figures with a qualified installer.</p>

					<div class="lead-action-box">
						<h3>Compare Quotes From Solar Installers</h3>
						<p>EnergySage is an independent solar marketplace where you can request property-specific pricing from installers.</p>
						<!-- NOTE: plain, non-affiliate external link — no tracking ID configured yet. Do not add rel="sponsored" or compensation language until a real affiliate/tracking URL is supplied. -->
						<a href="https://www.energysage.com" target="_blank" rel="noopener noreferrer" class="btn-green-action-link" data-track-click="external_partner_clicked">
							Visit EnergySage →
						</a>
						<p style="font-size: 0.75rem; color: #94a3b8; margin-top: 0.75rem; line-height: 1.4;">
							You’ll continue on EnergySage’s website. This is a plain external link — GridPermit does not currently have an affiliate relationship with EnergySage and earns no compensation from it.
						</p>
					</div>
				</div>
			</div>
		</div>
	</main>

	<section class="guides-teaser">
		<div class="guides-teaser-inner">
			<h2>Verified California solar permit guides, city by city</h2>
			<p>Separately from the estimator above, GridPermit maintains a source-linked, confidence-scored solar permitting guide for verified California cities — permit authority, required documents, inspection steps, and eligibility, each fact traced to an official source.</p>
			<div class="guides-teaser-links">
				<a href="/california/" class="btn-teaser-primary">Read the California Solar Permit Guide →</a>
				<a href="/california/solar-permit-guides/" class="btn-teaser-secondary">Browse verified cities →</a>
			</div>
		</div>
	</section>

	<footer class="footer">
		<div class="footer-container">
			<p>© 2026 GridPermit. All rights reserved.</p>
			<p class="affiliate-disclosure">
				GridPermit is an independent educational resource and referral website. Estimates are provided for informational purposes only and are not engineering, financial, tax, or installation advice. GridPermit is not a solar installer, contractor, engineering firm, public utility, or government agency.
			</p>
			<div class="footer-links">
				<a href="/about">About Us</a> | <a href="/how-it-works">How It Works</a> | <a href="/california/solar-permit-guides/">California Guides</a> | <a href="/pro">GridPermit Pro</a> | <a href="/blog">Blog</a> | <a href="/methodology">Methodology</a> | <a href="/contact">Contact</a> | <a href="/privacy">Privacy Policy</a> | <a href="/terms">Terms of Service</a>
			</div>
		</div>
	</footer>

	<script>
		import { trackEvent } from "../lib/analytics-events";

		document.addEventListener("DOMContentLoaded", () => {
			// Honest-MVP notice: these are the ONLY two assumptions behind the system-size
			// figure below, and both are flat statewide placeholders — not real utility
			// rate or solar-production data. See /methodology for the full explanation.
			const PLACEHOLDER_RATE_PER_KWH = 0.30; // not a real PG&E/SCE/SDG&E rate
			const PLACEHOLDER_YIELD_KWH_PER_KW_YEAR = 1400; // rough statewide placeholder, not location-specific

			// California ZIP codes fall in the 90001-96162 range. This is a structural
			// range check only — it does not identify a specific utility or address.
			function isCaliforniaZip(zip: string): boolean {
				const n = Number(zip);
				return /^\d{5}$/.test(zip) && n >= 90001 && n <= 96162;
			}

			const zipInput = document.getElementById("zip") as HTMLInputElement | null;
			const caPill = document.getElementById("utility-detected");
			const notCaPill = document.getElementById("utility-not-ca");

			if (zipInput && caPill && notCaPill) {
				zipInput.addEventListener("input", (e) => {
					const val = (e.target as HTMLInputElement).value;
					if (val.length !== 5) {
						caPill.classList.add("hidden");
						notCaPill.classList.add("hidden");
						return;
					}
					if (isCaliforniaZip(val)) {
						caPill.classList.remove("hidden");
						notCaPill.classList.add("hidden");
					} else {
						caPill.classList.add("hidden");
						notCaPill.classList.remove("hidden");
					}
				});
			}

			const form = document.getElementById("solar-form");
			const loadingBox = document.getElementById("loading-box");
			const loadingText = document.getElementById("loading-text");
			const results = document.getElementById("results");

			if (form && loadingBox && loadingText && results && zipInput && notCaPill) {
				form.addEventListener("submit", (e) => {
					e.preventDefault();

					const zipVal = zipInput.value || "";
					if (!isCaliforniaZip(zipVal)) {
						notCaPill.classList.remove("hidden");
						zipInput.focus();
						return;
					}

					trackEvent("calculator_started");

					form.classList.add("hidden");
					loadingBox.classList.remove("hidden");

					setTimeout(() => { loadingText.innerText = "Applying statewide placeholder assumptions..."; }, 800);
					setTimeout(() => { loadingText.innerText = "Building your illustrative estimate..."; }, 1600);

					setTimeout(() => {
						loadingBox.classList.add("hidden");
						results.classList.remove("hidden");

						const billInput = document.getElementById("bill") as HTMLInputElement | null;
						const bill = Number(billInput?.value || 250);

						// The only figure this MVP computes: a rough system-size guess,
						// derived transparently from the two placeholder constants above.
						const annualKwh = (bill * 12) / PLACEHOLDER_RATE_PER_KWH;
						const sysKw = annualKwh / PLACEHOLDER_YIELD_KWH_PER_KW_YEAR;

						const sysSizeEl = document.getElementById("res-sys-size");
						if (sysSizeEl) sysSizeEl.innerText = sysKw.toFixed(1) + " kW";
						trackEvent("calculator_completed");
					}, 2400);
				});
			}
		});
	</script>

	<style>
		:root { --primary: #2563eb; --primary-dark: #1d4ed8; --accent: #10b981; --bg-dark: #0f172a; --bg-slate: #f8fafc; --text-main: #0f172a; --text-muted: #64748b; --border-color: #e2e8f0; --radius: 16px; }
		.skip-link { position: absolute; top: -3rem; left: 0; background: var(--primary); color: white; padding: 0.75rem 1.25rem; z-index: 1000; text-decoration: none; font-weight: 700; border-radius: 0 0 8px 0; transition: top 0.15s ease; }
		.skip-link:focus { top: 0; }
		* { box-sizing: border-box; margin: 0; padding: 0; }
		body { font-family: "Plus Jakarta Sans", system-ui, sans-serif; background-color: var(--bg-slate); color: var(--text-main); line-height: 1.6; }
		.top-banner { background: #1e293b; color: #cbd5e1; text-align: center; padding: 0.6rem 1rem; font-size: 0.85rem; font-weight: 500; }
		.navbar { background: white; border-bottom: 1px solid var(--border-color); padding: 0.85rem 2rem; position: sticky; top: 0; z-index: 100; }
		.nav-container { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
		.brand-logo { text-decoration: none; display: inline-block; }
		.logo-text { font-size: 1.75rem; font-weight: 400; color: #0F172A; }
		.logo-bold { font-weight: 800; }
		.nav-links { display: flex; gap: 1.25rem; }
		.nav-links a { text-decoration: none; color: var(--text-muted); font-weight: 600; font-size: 0.88rem; }
		.btn-cta-nav { background: var(--primary); color: white; padding: 0.6rem 1.25rem; border-radius: 8px; font-weight: 700; text-decoration: none; font-size: 0.9rem; }
		.nav-search-link { text-decoration: none; font-size: 1.05rem; padding: 0.3rem; margin-right: 0.25rem; }
		@media (max-width: 640px) {
			.nav-container { flex-wrap: wrap; row-gap: 0.6rem; }
			.nav-links { flex-wrap: wrap; justify-content: center; }
		}
		.hero { position: relative; background: #0f172a; padding: 5rem 1.5rem 6rem 1.5rem; color: white; }
		.hero-container { position: relative; z-index: 10; max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: center; }
		@media (max-width: 960px) { .hero-container { grid-template-columns: 1fr; } }
		.badge-pill { display: inline-flex; align-items: center; background: rgba(37, 99, 235, 0.2); border: 1px solid rgba(96, 165, 250, 0.3); color: #93c5fd; padding: 0.4rem 1rem; border-radius: 9999px; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; margin-bottom: 1.25rem; }
		.hero h1 { font-size: 2.8rem; font-weight: 800; line-height: 1.15; margin-bottom: 1rem; }
		.hero-lead { font-size: 1.15rem; color: #94a3b8; margin-bottom: 2rem; max-width: 580px; }
		.hero-stats { display: flex; align-items: center; gap: 1.5rem; background: rgba(255, 255, 255, 0.05); padding: 1.25rem; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.1); width: fit-content; }
		@media (max-width: 480px) {
			.hero-stats { flex-wrap: wrap; width: auto; }
		}
		.stat-number { display: block; font-size: 1.25rem; font-weight: 800; color: #38bdf8; }
		.stat-label { font-size: 0.7rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; }
		.stat-divider { width: 1px; height: 35px; background: rgba(255, 255, 255, 0.15); }
		.calculator-glass-card { background: rgba(255, 255, 255, 0.95); border-radius: var(--radius); padding: 2.25rem; color: var(--text-main); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35); }
		.calc-header h2 { font-size: 1.4rem; font-weight: 800; }
		.calc-header p { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.5rem; }
		.input-field { margin-bottom: 1.25rem; position: relative; }
		.input-field label { display: block; font-size: 0.85rem; font-weight: 700; color: #334155; margin-bottom: 0.4rem; }
		.input-field input { width: 100%; padding: 0.85rem 1rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; }
		.utility-pill { font-size: 0.75rem; color: #166534; background: #dcfce7; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 700; margin-top: 0.4rem; display: inline-block; }
		.utility-pill-warn { font-size: 0.75rem; color: #92400e; background: #fef3c7; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 700; margin-top: 0.4rem; display: inline-block; }
		.btn-glow-submit { width: 100%; background: var(--primary); color: white; border: none; padding: 1.1rem; border-radius: 10px; font-size: 1rem; font-weight: 800; cursor: pointer; }
