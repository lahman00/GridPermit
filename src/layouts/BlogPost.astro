---
import ContextualPartnerSlot from '../components/ContextualPartnerSlot.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, decisionStage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.decision-cta {
				margin: 2.5rem 0 0;
				padding: 1.25rem 1.35rem;
				border: 1px solid #bfdbfe;
				border-radius: 12px;
				background: #eff6ff;
			}
			.decision-cta strong { display: block; color: #0f172a; margin-bottom: .35rem; }
			.decision-cta p { margin: 0 0 .8rem; color: #475569; }
			.decision-cta a { display: inline-block; font-weight: 700; color: #1d4ed8; text-decoration: none; }
			.decision-cta small { display: block; color: #64748b; margin-top: .7rem; }
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				<ContextualPartnerSlot />
					{
						decisionStage && (
							<div class="decision-cta">
								<strong>Have a project-specific permit or PTO question?</strong>
								<p>Send GridPermit the jurisdiction, utility, project scope and the exact decision or correction you are trying to resolve.</p>
								<a href="/project-help/">Send the project facts →</a>
								<small>Do not include account numbers or other sensitive personal information. GridPermit will label anything it cannot verify rather than guess.</small>
							</div>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
