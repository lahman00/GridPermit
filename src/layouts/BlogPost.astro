---
import ContextualPartnerSlot from '../components/ContextualPartnerSlot.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, decisionStage } = Astro.props;
---

<html lang="en" data-theme="dark">
	<head>
		<BaseHead title={title} description={description} />

	</head>

	<body>
<a href="#main-content" class="skip-link">Skip to main content</a>
		<Header />
		<main class="gp-container" id="main-content" tabindex="-1">
			<article class="gp-article">
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				<ContextualPartnerSlot />
					{
						decisionStage && (
							<div class="decision-cta">
								<strong>Have a project-specific permit or PTO question?</strong>
								<p>Send GridPermit the jurisdiction, utility, project scope and the exact decision or correction you are trying to resolve.</p>
								<a href="/project-help/">Send the project facts →</a>
								<small>Do not include account numbers or other sensitive personal information. GridPermit will label anything it cannot verify rather than guess.</small>
							</div>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
	<script>
 document.querySelectorAll<HTMLTableElement>('.gp-article table').forEach(table => {
   table.tabIndex = 0;
   if (!table.hasAttribute('aria-label') && !table.caption) table.setAttribute('aria-label', 'Guide comparison table. Scroll horizontally for additional columns.');
 });
</script>
</body>
</html>
