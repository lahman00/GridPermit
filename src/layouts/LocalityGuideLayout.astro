---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import DesignHead from "../components/DesignHead.astro";
// Reusable shell for locality guide pages. A page using this layout should
// only import its locality JSON record and pass it here along with the
// route's own path — every other section, schema block, and trust rule is
// implemented once, here. See src/lib/locality-guide.ts for the underlying
// data-shaping functions and docs/PILOT_EVALUATION.md Section 3 for which
// fields are approved to show.
import {
	NOT_VERIFIED,
	buildSourceResolver,
	getDisplayablePrograms,
	formatTimeline,
	buildPageMeta,
	buildBreadcrumbItems,
	buildBreadcrumbSchema,
	buildFaqs,
	buildFaqSchema,
	resolvePermitAuthorityLabel,
	buildLocalityIndexEntries,
	buildRelatedLocalities,
	relationLabel,
	type LocalityRecord,
} from "../lib/locality-guide";
import { buildCountyHubs, countySlug } from "../lib/county-hub";
import { buildUtilityHubs, utilitySlug } from "../lib/utility-hub";
import { getAllBlogPosts, relatedPostsForUtility } from "../lib/blog-posts";
import { stateGuidesIndexUrl } from "../lib/locality-guide";
import { stateMeta } from "../lib/state-meta";
import { hasVerifiedUnambiguousUtility } from "../lib/utility-split-guard";
import ConfidenceBadge from "../components/ConfidenceBadge.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import Analytics from "../components/Analytics.astro";
import InstallerCTA from "../components/InstallerCTA.astro";
import PermitPathwayAnswer from "../components/PermitPathwayAnswer.astro";
import EvidenceState from "../components/EvidenceState.astro";
import LocalityPermitPath from "../components/LocalityPermitPath.astro";
import { buildPermitPathwayAnswer } from "../lib/permit-pathway-answer";

interface Props {
	record: LocalityRecord;
	pagePath: string;
	// Explicit path to the city's own index page (e.g. "/california/oakland/").
	// Required so breadcrumb generation never has to guess it from pagePath.
	cityPath: string;
}

const { record, pagePath, cityPath } = Astro.props;

const FIRST_LEAD_SPRINT_PATHS = new Set([
	"/california/escondido/solar-permit-guide/",
	"/california/hemet/solar-permit-guide/",
	"/california/pomona/solar-permit-guide/",
]);
const isFirstLeadSprintPage = FIRST_LEAD_SPRINT_PATHS.has(pagePath);

const { canonicalUrl, title, description, utilityShortName: utilityShort } = buildPageMeta(record, pagePath);
const permitAuthorityLabel = resolvePermitAuthorityLabel(record);
const sourceCount = record.sources.length;
const utilityIsUnambiguous = hasVerifiedUnambiguousUtility(record);
const recordedPathway = record.eligibility_constraints?.value?.program_or_pathway ?? NOT_VERIFIED;
const hasSourcedValue = (value: unknown, sourceIds?: string[] | null) => Boolean(value) && Boolean(sourceIds?.length);
const authorityVerified = hasSourcedValue(record.permit_authority.value, record.permit_authority.source_ids);
const documentsVerified = Boolean(record.required_documents.value?.length) && Boolean(record.required_documents.source_ids?.length);
const documentsConditional = Boolean(record.required_documents.value?.some(document => Boolean(document.required_when)));
const inspectionVerified = Boolean(record.inspection_steps.value?.length) && Boolean(record.inspection_steps.source_ids?.length);
const interconnectionVerified = hasSourcedValue(record.interconnection_url.value, record.interconnection_url.source_ids);

const firstLeadTimeline = record.timeline_days?.value ?? null;
const firstLeadLocalFact = isFirstLeadSprintPage
	? firstLeadTimeline?.min_days === 0 && firstLeadTimeline?.max_days === 0
		? "Local fact: for SolarAPP+-eligible projects, GridPermit's verified city source says permit issuance can be immediate after fee payment."
		: "Local fact: GridPermit's source-backed record identifies " + permitAuthorityLabel + " as the permit authority for " + record.city.value + "."
	: null;

// "Other verified California guides" cross-links (never linking to this
// page itself) — driven by the same READY-only entry list the locality
// index page uses, so the two can never disagree on which cities qualify.
const localityModules = import.meta.glob("../../data/localities/*.json", { eager: true }) as Record<
	string,
	{ default: LocalityRecord }
>;
const allRecordsById = new Map(Object.values(localityModules).map((mod) => [mod.default.record_id, mod.default]));
// Combine every evaluation run's records — see the same note in
// solar-permit-guides.astro, which this cross-link list must always agree
// with on which cities currently qualify. Loaded via glob so a new batch's
// evaluation file is picked up automatically.
const evaluationModules = import.meta.glob("../../output/*-evaluation.json", { eager: true }) as Record<
	string,
	{ default: { records: Array<{ record_id: string; readiness: string; completeness_pct: number }> } }
>;
const allEvaluatedRecords = Object.values(evaluationModules).flatMap((mod) => mod.default.records);
const allReadyEntries = buildLocalityIndexEntries(allEvaluatedRecords, allRecordsById);
// Built directly from this page's own record (not looked up in
// allReadyEntries) so related-locality ranking still works even in the
// defensive case where this page's own record_id isn't present in the
// evaluation data passed in.
const currentStateMeta = stateMeta(record.state);
const currentEntry = {
	recordId: record.record_id,
	city: record.city.value,
	county: record.county?.value ?? null,
	utility: record.utility.value,
	generationSupplierName: record.generation_supplier.value?.name ?? null,
	completenessPct: 0,
	lastVerified: record.last_verified,
	citySlug: "",
	guideUrl: "",
	state: currentStateMeta.code,
	stateName: currentStateMeta.name,
	stateSlug: currentStateMeta.slug,
};
const relatedLocalities = buildRelatedLocalities(currentEntry, allReadyEntries, 6);

// County hub link — only when this city's county cleared the hub-page
// value threshold (see MIN_READY_CITIES_FOR_HUB in src/lib/county-hub.ts).
// Most counties in this dataset have too few READY cities for a hub page
// to exist, so this is null far more often than not.
const countyHubs = buildCountyHubs(allEvaluatedRecords, allRecordsById);
const countyName = record.county?.value;
const countyHub = countyName
	? countyHubs.find((h) => h.state === record.state && h.countySlug === countySlug(countyName))
	: undefined;
const countyHubUrl = countyHub ? `/${countyHub.stateSlug}/county/${countyHub.countySlug}/` : null;

// Utility hub link — same idea, keyed by short name so it still matches
// regardless of which full-name spelling this record used (see the same
// fix in buildRelatedLocalities).
const utilityHubs = buildUtilityHubs(allEvaluatedRecords, allRecordsById);
const utilityHub = utilityShort
	? utilityHubs.find((h) => h.state === record.state && h.utilitySlug === utilitySlug(utilityShort))
	: undefined;
const utilityHubUrl = utilityHub ? `/${utilityHub.stateSlug}/utility/${utilityHub.utilitySlug}/` : null;

// "Related articles" — blog posts matching this locality's utility, via the
// same shared post list/category logic the blog index itself uses.
const allBlogPosts = await getAllBlogPosts();
const relatedArticles = relatedPostsForUtility(allBlogPosts, utilityShort, 3);

const sourcesFor = buildSourceResolver(record.sources);
// Reviewed "who files the permit" answer; null for every locality not on the
// reviewed list (and for any listed one whose record no longer supports it).
const permitPathway = buildPermitPathwayAnswer(record);
const batteryPrograms = getDisplayablePrograms(record.battery_programs.value);
const rebatePrograms = getDisplayablePrograms(record.rebates.value);
const td = record.timeline_days?.value ?? null;
const hasTimeline = td !== null;
const timeline = td !== null ? formatTimeline(td) : null;
const generationSupplier = record.generation_supplier.value;
const hasGenerationSupplier = generationSupplier !== null;

const breadcrumbItems = buildBreadcrumbItems(record, { cityPath, pageUrl: canonicalUrl });
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems);
const faqs = buildFaqs(record);
const faqSchema = buildFaqSchema(faqs);

// Table of contents — ids match the section anchors added below. FAQ and
// "Other guides" entries are included only when that section will actually
// render (mirrors each section's own conditional).
const tocItems = [
	{ id: "overview", label: "Overview" },
	...(permitPathway ? [{ id: "permit-pathway", label: "Who Files the Permit" }] : []),
	...(isFirstLeadSprintPage ? [{ id: "installer-cta", label: "Compare Solar Quote" }] : []),
	{ id: "utility-supplier", label: "Utility & Supplier" },
	{ id: "permit-authority", label: "Permit Authority" },
	{ id: "required-documents", label: "Required Documents" },
	{ id: "inspection-steps", label: "Inspection Steps" },
	{ id: "eligibility", label: "Eligibility" },
	{ id: "permit-fees", label: "Permit Fees" },
	{ id: "rebates", label: "Rebates" },
	{ id: "official-contacts", label: "Official Contacts" },
	...(faqs.length > 0 ? [{ id: "faq", label: "FAQ" }] : []),
	{ id: "sources", label: "Sources" },
	...(relatedLocalities.length > 0 ? [{ id: "other-guides", label: "Related Cities" }] : []),
	...(relatedArticles.length > 0 ? [{ id: "related-articles", label: "Related Articles" }] : []),
];
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
	<Analytics />
	<DesignHead />
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={canonicalUrl} />

	<meta name="google-site-verification" content="b36wwqlXise5bGI8ckWqbybnEoCYlsTmp4BiV" />
	<link rel="sitemap" href="/sitemap-index.xml" />

	<!-- Open Graph -->
	<meta property="og:type" content="article" />
	<meta property="og:url" content={canonicalUrl} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />

	<!-- Twitter -->
	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />

	<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	{faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</head>
<body data-track-view="locality_guide_viewed">
	<a href="#main-content" class="skip-link">Skip to main content</a>
	<ReadingProgress />

	<Header><Fragment slot="action">{isFirstLeadSprintPage
				? <a href="#installer-cta" class="btn-cta-nav">Compare Solar Quote</a>
				: record.state === "CA"
					? <a href="/#calculator" class="btn-cta-nav" data-contextual-revenue-nav>Estimate Savings</a>
					: <a href="#installer-cta" class="btn-cta-nav">Find an Installer</a>}</Fragment></Header>

	<div class="page-container">
		<nav class="breadcrumb-nav" aria-label="Breadcrumb">
			{breadcrumbItems.map((item, i) => (
				<>
					{i > 0 && <span class="crumb-sep">/</span>}
					{i === breadcrumbItems.length - 1
						? <span class="crumb-current">{item.name}</span>
						: <a href={item.url.replace("https://mygridpermit.com", "")}>{item.name}</a>}
				</>
			))}
		</nav>

		<div class="layout-grid">
		<main class="content-card" id="main-content" tabindex="-1">
			<div class="gp-locality-head">
              <div class="gp-locality-intro">
                <p class="gp-kicker">{currentStateMeta.name} / Local permit guide</p>
                <h1>{record.city.value} <span>Solar Permit Guide</span></h1>
                <p class="gp-locality-lead">Your local requirements. The official sources. A clearer next step.</p>
              </div>
              <dl class="gp-facts" aria-label="Local permit summary">
                <div><dt>Permit authority</dt><dd><a href="#permit-authority">{permitAuthorityLabel}</a><EvidenceState state={authorityVerified ? "verified" : "check"} label={authorityVerified ? "Source linked" : "Confirm source"} /></dd></div>
                <div><dt>Electric utility</dt><dd><a href="#utility-supplier">{utilityIsUnambiguous ? (record.utility.value ?? NOT_VERIFIED) : 'Confirm utility for your address'}</a><EvidenceState state={utilityIsUnambiguous ? "verified" : "check"} label={utilityIsUnambiguous ? "Source linked" : "Address check"} />{!utilityIsUnambiguous && <small>This record is not an unambiguous city-wide utility determination.</small>}</dd></div>
                <div><dt>Local pathway</dt><dd><a href="#eligibility">{recordedPathway}</a>{recordedPathway !== NOT_VERIFIED && <small>Project-specific eligibility conditions apply.</small>}</dd></div>
                <div><dt>Review time</dt><dd><a href="#overview">{timeline?.label ?? NOT_VERIFIED}</a>{timeline?.standardPathCaveat && <small>{timeline.standardPathCaveat}</small>}{hasTimeline && <small>See source scope and conditions below.</small>}</dd></div>
              </dl>
              <a href="#overview" class="gp-button gp-locality-actions">See your permit path <span aria-hidden="true">↓</span></a>
            </div>
            <p class="subtitle gp-locality-context">{record.county.value && <>{countyHubUrl ? <a href={countyHubUrl}>{record.county.value}</a> : record.county.value} · </>}{utilityHubUrl && <a href={utilityHubUrl}>Explore related utility guides</a>}</p>

			<!-- Screen-hidden, print-only: a checklist masthead so a printed
			     page is identifiable and dated on its own, without the nav/
			     banner that's hidden in print. -->
			<div class="print-checklist-header">
				<div class="print-title">{record.city.value} Solar Permit Checklist</div>
				<div class="print-meta">Printed from mygridpermit.com/{pagePath.replace(/^\//, "")} · Last verified {record.last_verified} · {permitAuthorityLabel} / {utilityShort} · Verify current requirements before relying on this checklist. Programs and fees change.</div>
			</div>

			<div class="page-toolbar">
				<div class="gp-source-health" aria-label={`Source health: verified ${record.last_verified}, ${sourceCount} official sources`}>
					<span class="gp-source-health-label"><i aria-hidden="true"></i>Source health</span>
					<span class="badge badge-date">Last verified {record.last_verified}</span>
					<span class="badge badge-sources">{sourceCount} official source{sourceCount === 1 ? "" : "s"}</span>
				</div>
				<button type="button" class="btn-toolbar" id="copy-link-btn">Copy Link</button>
				<button type="button" class="btn-toolbar" id="print-btn">Print Checklist</button>
			</div>

<details class="toc-index"><summary>Jump to a section</summary>
			<nav class="toc-card" aria-label="Table of contents">
				<p class="toc-heading">On This Page</p>
				<ul class="toc-list">
					{tocItems.map((item) => (
						<li><a href={`#${item.id}`}>{item.label}</a></li>
					))}
				</ul>
			</nav>
		</details>
			<div class="disclaimer-box">
				<strong>Informational only.</strong> This page is not legal, engineering, or permit advice. Every fact below links to the official source it came from and shows how confident we are in it. Verify current requirements with {permitAuthorityLabel} and {utilityShort} before making a decision.
			</div>

			{isFirstLeadSprintPage && (
				<p class="first-lead-jump"><a href="#installer-cta">Planning a new solar project? Jump to the homeowner quote path →</a></p>
			)}
			{!isFirstLeadSprintPage && (
				<p class="first-lead-jump" data-approved-quote-jump hidden><a href="#installer-cta">Planning a new solar project? See the homeowner quote option →</a></p>
			)}

			<LocalityPermitPath
				city={record.city.value}
				authority={permitAuthorityLabel}
				utility={record.utility.value ?? NOT_VERIFIED}
				authorityVerified={authorityVerified}
				documentsVerified={documentsVerified}
				documentsConditional={documentsConditional}
				inspectionVerified={inspectionVerified}
				utilityVerified={utilityIsUnambiguous}
				interconnectionVerified={interconnectionVerified}
			/>

			<!-- ===== Overview ===== -->
			<section id="overview">
				<p class="gp-kicker">01 / Know your path</p>
                <h2>Two approvals.<br/>One project.</h2>
                <div class="gp-paths">
                  <div class="gp-path"><span class="gp-kicker">Local authority</span><h3>Permit &amp; inspection</h3><p>{permitAuthorityLabel}</p><a class="gp-text-link" href="#permit-authority">Local requirements <span aria-hidden="true">↗</span></a></div>
                  <div class="gp-path"><span class="gp-kicker">Electric utility</span><h3>Interconnection &amp; PTO</h3><p>{record.utility.value ?? NOT_VERIFIED}</p><a class="gp-text-link" href="#utility-supplier">Utility requirements <span aria-hidden="true">↗</span></a></div>
                </div>
                <p class="fact-notes">A local permit and utility permission to operate are different approvals. Check the local sequence and requirements below.</p>
				<details class="gp-source-evidence"><summary>How to read this guide</summary><p>
					GridPermit collects {currentStateMeta.name} residential solar and permitting facts directly from official sources (city, county, and state government sites, utilities, and public utilities commissions) and shows only what we can verify, with a confidence score and a link to where it came from. Nothing here is estimated or inferred beyond what's stated below. See <a href="/methodology/">our methodology</a> for the rules this page follows.
				</p></details>

				{hasTimeline && timeline && td && (
					<div class="fact-callout">
						<h3>Permit timeline</h3>
						<p class="fact-value">{timeline.label}</p>
						{timeline.standardPathCaveat && <p class="fact-status">{timeline.standardPathCaveat}</p>}
						{td.notes && <p class="fact-notes">{td.notes}</p>}
						<details class="gp-source-evidence"><summary>Sources &amp; confidence</summary><ConfidenceBadge confidence={record.timeline_days.confidence} /><p class="fact-meta">Source(s): {sourcesFor(record.timeline_days.source_ids).map((s, i) => <>{i > 0 && ", "}<a href={s.url} target="_blank" rel="noopener" data-track-click="official_source_clicked">{s.title}</a></>)}</p></details>
					</div>
				)}

				{!isFirstLeadSprintPage && (
					<div class="fact-callout fact-callout-caution">
						<h3>Battery/solar incentive program on record</h3>
						{batteryPrograms.length > 0 ? (
							<>
								{batteryPrograms.map((p) => (
									<div class="program-item">
										<p class="fact-value">{p.name}</p>
										<p class="fact-notes">{p.description}</p>
										<p class="fact-status">Status on file: <strong>{p.status}</strong>. Verify current status before relying on this.</p>
									</div>
								))}
								<details class="gp-source-evidence"><summary>Sources &amp; confidence</summary><ConfidenceBadge confidence={record.battery_programs.confidence} /><p class="fact-meta">Source(s): {sourcesFor(record.battery_programs.source_ids).map((s, i) => <>{i > 0 && ", "}<a href={s.url} target="_blank" rel="noopener" data-track-click="official_source_clicked">{s.title}</a></>)}</p></details>
							</>
						) : (
							<p class="fact-value muted">No battery/storage incentive program is on record for this locality.</p>
						)}
					</div>
				)}
			</section>

			<section id="required-documents">
				<p class="gp-kicker">02 / Prepare your application</p><h2>What you need.</h2>
				{record.required_documents.value ? (
					<>
						<ul class="fact-list gp-checklist">
                            {record.required_documents.value.map((doc) => (
                              <li><label><input type="checkbox" data-checklist-item /><span><strong>{doc.name}</strong>{doc.required_when && <span class="doc-condition">Required when: {doc.required_when}</span>}</span></label></li>
                            ))}
                        </ul>
                        <div class="gp-checklist-tools"><output id="checklist-progress" aria-live="polite">0 of {record.required_documents.value.length} marked</output><button type="button" class="btn-toolbar" id="copy-checklist-btn">Copy checklist + sources</button><button type="button" class="btn-toolbar" id="clear-checklist-btn" hidden>Clear marks</button><span class="fact-notes" id="checklist-storage-status">Saved only on this device; not confirmation of permit readiness.</span></div>
                        <p class="sr-only" id="checklist-copy-status" role="status"></p>
						<script is:inline type="application/json" id="checklist-source-data" set:html={JSON.stringify(record.sources.map(source => ({ title: source.title, url: source.url }))).replace(/</g, "\\u003c")} />
						<details class="gp-source-evidence"><summary>Sources &amp; confidence</summary><ConfidenceBadge confidence={record.required_documents.confidence} /><p class="fact-meta">Source(s): {sourcesFor(record.required_documents.source_ids).map((s, i) => <>{i > 0 && ", "}<a href={s.url} target="_blank" rel="noopener" data-track-click="official_source_clicked">{s.title}</a></>)}</p></details>
					</>
				) : <p class="fact-value muted">{NOT_VERIFIED}</p>}
			</section>

			{permitPathway && <PermitPathwayAnswer answer={permitPathway} />}

			{isFirstLeadSprintPage && (
				<section id="installer-cta" class="first-lead-panel" data-lead-sprint="first_lead_v1">
					<p class="first-lead-kicker">Homeowner quote path</p>
					<h2>Ready to compare a new solar quote in {record.city.value}?</h2>
					<p>
						A new project in {record.city.value} still has two approval tracks: permit review with {permitAuthorityLabel} and utility interconnection/PTO with {utilityShort}. GridPermit explains the approval path; CompareSolarPrices handles the quote request.
					</p>
					<details class="gp-source-evidence"><summary>How a quote fits the approval process</summary>{firstLeadLocalFact && <p class="first-lead-local-fact">{firstLeadLocalFact}</p>}
					<ol class="first-lead-process">
						<li><strong>Compare the project:</strong> request a homeowner quote and confirm the system scope.</li>
						<li><strong>Permit path:</strong> the project still needs review or issuance through {permitAuthorityLabel}.</li>
						<li><strong>Utility path:</strong> interconnection and PTO remain separate from the city permit process.</li>
					</ol></details>
					<ul class="first-lead-fit">
						<li><strong>Best fit:</strong> you own the home and do not already have solar.</li>
						<li><strong>Not the right quote path:</strong> renters or properties that already have solar. You can still use this page for permit and utility facts.</li>
						<li><strong>Utility bill:</strong> helpful for an accurate quote, but not required before you click. CompareSolarPrices may collect it on the form or during follow-up.</li>
						<li><strong>Privacy boundary:</strong> contact details are entered on CompareSolarPrices, not GridPermit.</li>
					</ul>
					<InstallerCTA city={record.city.value} requireFirstLeadQualification={true} recordId={record.record_id} utility={record.utility} />
					<p class="first-lead-note">GridPermit sends only a random non-PII referral code in the outbound link so a genuine quote request can be reconciled back to the click.</p>
				</section>
			)}

			{isFirstLeadSprintPage && batteryPrograms.length > 0 && (
				<section id="battery-incentive" class="fact-callout fact-callout-caution first-lead-post-incentive">
					<h3>Battery/solar incentive program on record</h3>
					{batteryPrograms.map((p) => (
						<div class="program-item">
							<p class="fact-value">{p.name}</p>
							<p class="fact-notes">{p.description}</p>
							<p class="fact-status">Status on file: <strong>{p.status}</strong>. Verify current status before relying on this.</p>
						</div>
					))}
					<details class="gp-source-evidence"><summary>Sources &amp; confidence</summary><ConfidenceBadge confidence={record.battery_programs.confidence} /><p class="fact-meta">Source(s): {sourcesFor(record.battery_programs.source_ids).map((s, i) => <>{i > 0 && ", "}<a href={s.url} target="_blank" rel="noopener" data-track-click="official_source_clicked">{s.title}</a></>)}</p></details>
				</section>
			)}

			<!-- ===== Permit fees ===== -->
			<section id="permit-fees">
				<h2>Permit fees</h2>
				{record.permit_fees.notes && <p class="fact-notes" data-permit-fee-context>{record.permit_fees.notes}</p>}
				{record.permit_fees.value ? (
					<>
						<ul class="fact-list">
							{record.permit_fees.value.map((fee) => (
								<li>
									<strong>{fee.name}</strong>
									{fee.amount_usd != null ? (
										<span>: ${fee.amount_usd}{fee.unit && ` (${fee.unit})`}</span>
									) : (
										<span class="doc-condition">: amount not verified{fee.unit && ` (${fee.unit})`}</span>
									)}
									{fee.notes && <p class="fact-notes">{fee.notes}</p>}
								</li>
							))}
						</ul>
						<details class="gp-source-evidence"><summary>Sources &amp; confidence</summary><ConfidenceBadge confidence={record.permit_fees.confidence} /><p class="fact-meta">Source(s): {sourcesFor(record.permit_fees.source_ids).map((s, i) => <>{i > 0 && ", "}<a href={s.url} target="_blank" rel="noopener" data-track-click="official_source_clicked">{s.title}</a></>)}</p></details>
					</>
				) : <p class="fact-value muted">{NOT_VERIFIED}</p>}
			</section>

			<!-- ===== Rebates ===== -->
			<section id="rebates">
				<h2 class="sr-only">Rebates on record</h2><details class="gp-section-details"><summary>Rebates on record</summary>
				{rebatePrograms.length > 0 ? (
					<>
						{rebatePrograms.map((p) => (
							<div class="program-item">
								<p class="fact-value">{p.name}</p>
								<p class="fact-notes">{p.description}</p>
								<p class="fact-status">Status on file: <strong>{p.status}</strong>. Verify current status before relying on this.</p>
							</div>
						))}
						<details class="gp-source-evidence"><summary>Sources &amp; confidence</summary><ConfidenceBadge confidence={record.rebates.confidence} /><p class="fact-meta">Source(s): {sourcesFor(record.rebates.source_ids).map((s, i) => <>{i > 0 && ", "}<a href={s.url} target="_blank" rel="noopener" data-track-click="official_source_clicked">{s.title}</a></>)}</p></details>
					</>
				) : <p class="fact-value muted">{NOT_VERIFIED}</p>}
			</details></section>

			<!-- ===== Utility and generation supplier ===== -->
			<section id="utility-supplier">
				<h2>Utility and generation supplier</h2>
				<div class="fact-block">
					<h3>Utility</h3>
					<p class="fact-value">{record.utility.value ?? NOT_VERIFIED}</p>
{record.utility.notes && <p class="fact-notes">{record.utility.notes}</p>}
					<details class="gp-source-evidence"><summary>Sources &amp; confidence</summary><ConfidenceBadge confidence={record.utility.confidence} /><p class="fact-meta">Source(s): {sourcesFor(record.utility.source_ids).map((s, i) => <>{i > 0 && ", "}<a href={s.url} target="_blank" rel="noopener" data-track-click="official_source_clicked">{s.title}</a></>)}</p></details>
				</div>

				<div class="fact-block">
					<h3>Generation supplier</h3>
					{hasGenerationSupplier && generationSupplier ? (
						<>
							<p class="fact-value">{generationSupplier.name} ({generationSupplier.type === "cca" ? "Community Choice Aggregator" : generationSupplier.type})</p>
							{generationSupplier.notes && <p class="fact-notes">{generationSupplier.notes}</p>}
							<details class="gp-source-evidence"><summary>Sources &amp; confidence</summary><ConfidenceBadge confidence={record.generation_supplier.confidence} /><p class="fact-meta">Source(s): {sourcesFor(record.generation_supplier.source_ids).map((s, i) => <>{i > 0 && ", "}<a href={s.url} target="_blank" rel="noopener" data-track-click="official_source_clicked">{s.title}</a></>)}</p></details>
						</>
					) : <p class="fact-value muted">{NOT_VERIFIED}</p>}
				</div>

				<div class="fact-block">
					<h3>Interconnection</h3>
					{record.interconnection_url.value ? (
						<>
							<p class="fact-value"><a href={record.interconnection_url.value} target="_blank" rel="noopener">{record.interconnection_url.value}</a></p>
							{record.interconnection_url.notes && <p class="fact-notes">{record.interconnection_url.notes}</p>}
							<ConfidenceBadge confidence={record.interconnection_url.confidence} />
						</>
					) : <p class="fact-value muted">{NOT_VERIFIED}</p>}
				</div>
			</section>

			<!-- ===== Permit authority ===== -->
			<section id="permit-authority">
				<h2>Permit authority</h2>
				<div class="fact-block">
					<p class="fact-value">{record.permit_authority.value ?? NOT_VERIFIED}</p>
					{record.permit_authority.notes && <p class="fact-notes">{record.permit_authority.notes}</p>}
					<details class="gp-source-evidence"><summary>Sources &amp; confidence</summary><ConfidenceBadge confidence={record.permit_authority.confidence} /><p class="fact-meta">Source(s): {sourcesFor(record.permit_authority.source_ids).map((s, i) => <>{i > 0 && ", "}<a href={s.url} target="_blank" rel="noopener" data-track-click="official_source_clicked">{s.title}</a></>)}</p></details>
					{record.permit_url.value && (
						<p class="fact-meta">Permit page: <a href={record.permit_url.value} target="_blank" rel="noopener">{record.permit_url.value}</a></p>
					)}
				</div>
			</section>

			<!-- ===== Required documents ===== -->


			<!-- ===== Inspection steps ===== -->
			<section id="inspection-steps">
				<h2>Inspection steps</h2>
				{record.inspection_steps.value ? (
					<>
						<ul class="fact-list">
							{record.inspection_steps.value.map((step) => <li>{step}</li>)}
						</ul>
						{record.inspection_steps.notes && <p class="fact-notes">{record.inspection_steps.notes}</p>}
						<details class="gp-source-evidence"><summary>Sources &amp; confidence</summary><ConfidenceBadge confidence={record.inspection_steps.confidence} /><p class="fact-meta">Source(s): {sourcesFor(record.inspection_steps.source_ids).map((s, i) => <>{i > 0 && ", "}<a href={s.url} target="_blank" rel="noopener" data-track-click="official_source_clicked">{s.title}</a></>)}</p></details>
					</>
				) : <p class="fact-value muted">{NOT_VERIFIED}</p>}
			</section>

			<!-- ===== Eligibility constraints ===== -->
			<section id="eligibility">
				<h2>Eligibility constraints</h2>
				{record.eligibility_constraints.value ? (
					<>
						<ul class="fact-list">
							<li><strong>Property types:</strong> {record.eligibility_constraints.value.property_types.length ? record.eligibility_constraints.value.property_types.join(", ") : NOT_VERIFIED}</li>
							<li><strong>Max system size (AC):</strong> {record.eligibility_constraints.value.system_size_kw_ac_max != null ? `${record.eligibility_constraints.value.system_size_kw_ac_max} kW` : NOT_VERIFIED}</li>
							<li><strong>Max system size (DC):</strong> {record.eligibility_constraints.value.system_size_kw_dc_max != null ? `${record.eligibility_constraints.value.system_size_kw_dc_max} kW` : NOT_VERIFIED}</li>
							<li><strong>Max thermal capacity:</strong> {record.eligibility_constraints.value.thermal_capacity_kw_max != null ? `${record.eligibility_constraints.value.thermal_capacity_kw_max} kW` : NOT_VERIFIED}</li>
							<li><strong>Program/pathway:</strong> {record.eligibility_constraints.value.program_or_pathway ?? NOT_VERIFIED}</li>
							{record.eligibility_constraints.value.other_conditions.length > 0 && (
								<li><strong>Other conditions:</strong>
									<ul class="fact-sublist">
										{record.eligibility_constraints.value.other_conditions.map((c) => <li>{c}</li>)}
									</ul>
								</li>
							)}
						</ul>
						<details class="gp-source-evidence"><summary>Sources &amp; confidence</summary><ConfidenceBadge confidence={record.eligibility_constraints.confidence} /><p class="fact-meta">Source(s): {sourcesFor(record.eligibility_constraints.source_ids).map((s, i) => <>{i > 0 && ", "}<a href={s.url} target="_blank" rel="noopener" data-track-click="official_source_clicked">{s.title}</a></>)}</p></details>
					</>
				) : <p class="fact-value muted">{NOT_VERIFIED}</p>}
			</section>

			<!-- ===== Official contacts ===== -->
			<section id="official-contacts">
				<h2 class="sr-only">Official contacts</h2><details class="gp-section-details"><summary>Official contacts</summary>
				{record.official_contacts.value ? (
					<>
						<ul class="fact-list">
							{record.official_contacts.value.map((c) => (
								<li>
									<strong>{c.role ?? c.name ?? "Contact"}</strong>
									{c.phone && <span>, phone: {c.phone}</span>}
									{c.email && <span>, email: <a href={`mailto:${c.email}`}>{c.email}</a></span>}
									{c.url && <span>, <a href={c.url} target="_blank" rel="noopener" data-track-click="official_source_clicked">official website</a></span>}
								</li>
							))}
						</ul>
						<ConfidenceBadge confidence={record.official_contacts.confidence} />
					</>
				) : <p class="fact-value muted">{NOT_VERIFIED}</p>}
			</details></section>

			<!-- ===== Installer CTA ===== -->
			{!isFirstLeadSprintPage && (
				<div id="installer-cta">
					<InstallerCTA city={record.city.value} recordId={record.record_id} utility={record.utility} />
				</div>
			)}

			<!-- ===== Sources ===== -->
			<section id="sources">
				<h2 class="sr-only">Official sources</h2><details class="gp-section-details"><summary>Official sources</summary>
				<ul class="fact-list sources-list">
					{record.sources.map((s) => (
						<li>
							<a href={s.url} target="_blank" rel="noopener" data-track-click="official_source_clicked">{s.title}</a>, {s.publisher} ({s.type}). Accessed {s.accessed_date}.
						</li>
					))}
				</ul>
			</details></section>

			<!-- ===== FAQ ===== -->
			{faqs.length > 0 && (
				<section id="faq">
					<h2>Frequently Asked Questions</h2>
					{faqs.map((f) => (
						<details class="faq-item" data-track-toggle="faq_expanded">
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))}
				</section>
			)}

			<!-- ===== Related same-state guides ===== -->
			{relatedLocalities.length > 0 && (
				<section id="other-guides">
					<h2 class="sr-only">Related cities</h2><details class="gp-section-details"><summary>Related cities</summary>
					<p>
						Other verified cities related to {record.city.value}. See all cities on the <a href={stateGuidesIndexUrl(record.state)}>{currentStateMeta.name} solar permit guide index</a>.
					</p>
					<ul class="fact-list other-guides-list">
						{relatedLocalities.map((g) => (
							<li><a href={g.guideUrl}>{g.city}</a>, {g.utility} <span class="related-reason">({relationLabel(g.relation)})</span></li>
						))}
					</ul>
				</details></section>
			)}

			<!-- ===== Related articles ===== -->
			{relatedArticles.length > 0 && (
				<section id="related-articles">
					<h2 class="sr-only">Related solar guides</h2><details class="gp-section-details"><summary>Related solar guides</summary>
					<ul class="fact-list related-articles-list">
						{relatedArticles.map((a) => (
							<li><a href={a.url}>{a.title}</a></li>
						))}
					</ul>
				</details></section>
			)}

			<div class="footer-disclaimer">
				<p><strong>Disclaimers:</strong> This page is for informational purposes only and is not legal, engineering, financial, tax, or permit advice. GridPermit is not a solar installer, contractor, engineering firm, public utility, or government agency. Requirements, fees, and program terms change. Verify current requirements with {permitAuthorityLabel} and {utilityShort} before starting a project. Last verified {record.last_verified}.</p>
				<p><a href={stateGuidesIndexUrl(record.state)}>All {currentStateMeta.name} Guides</a> · <a href="/methodology/">Methodology</a> · <a href="/how-it-works/">How It Works</a> · <a href="/">Back to GridPermit</a></p>
			</div>
		</main>

		</div>
	</div>

	<Footer />

	<script>
		// Copy Link — Clipboard API, no external service.
		const copyBtn = document.getElementById("copy-link-btn");
		copyBtn?.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(window.location.href);
				const original = copyBtn.textContent;
				copyBtn.textContent = "Copied!";
				setTimeout(() => {
					copyBtn.textContent = original;
				}, 1500);
			} catch {
				copyBtn.textContent = "Copy unavailable — copy the address bar";
			}
		});

		// Print — native browser print dialog.
		document.getElementById("print-btn")?.addEventListener("click", () => window.print());
	</script>

<script>
	function showApprovedQuoteShortcut() {
		const approvedQuote = document.querySelector("#installer-cta button[data-compare-solar-cta]");
		const shortcut = document.querySelector<HTMLElement>("[data-approved-quote-jump]");
		if (shortcut) shortcut.hidden = !approvedQuote;

		// Keep the default calculator destination on non-monetized California
		// pages. Only when the approved, fail-closed partner CTA actually
		// rendered do we promote the nav action to the real quote section.
		// This deliberately derives conversion affordance from the rendered
		// route instead of reimplementing partner/utility eligibility here.
		const nav = document.querySelector<HTMLAnchorElement>("[data-contextual-revenue-nav]");
		if (nav && approvedQuote) {
			nav.href = "#installer-cta";
			nav.textContent = "Compare Solar Quote";
		}
	}
	if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", showApprovedQuoteShortcut, { once: true });
	else showApprovedQuoteShortcut();
</script>


<style>
 main section[id], #installer-cta { scroll-margin-top: 8rem; }
 .content-card { min-width: 0; overflow-wrap: anywhere; }
 .gp-locality-context { font-size: 12px; margin: 0 0 22px; }
 @media print { #overview, #faq { display: none; } }
</style>

<script>
  const checks = Array.from(document.querySelectorAll<HTMLInputElement>('[data-checklist-item]'));
  const progress = document.getElementById('checklist-progress');
  const clearChecklist = document.getElementById('clear-checklist-btn') as HTMLButtonElement | null;
  const storageStatus = document.getElementById('checklist-storage-status');
  const checklistStorageKey = `gridpermit:checklist:${window.location.pathname}`;
  const updateProgress = () => {
    const marked = checks.filter(input => input.checked).length;
    if (progress) progress.textContent = `${marked} of ${checks.length} marked`;
    if (clearChecklist) clearChecklist.hidden = marked === 0;
  };
  try {
    const saved = JSON.parse(localStorage.getItem(checklistStorageKey) ?? '[]');
    if (Array.isArray(saved)) checks.forEach((input, index) => { input.checked = saved[index] === true; });
  } catch {}
  updateProgress();
  checks.forEach(input => input.addEventListener('change', () => {
    updateProgress();
    try { localStorage.setItem(checklistStorageKey, JSON.stringify(checks.map(item => item.checked))); if (storageStatus) storageStatus.textContent = 'Progress saved only on this device; not confirmation of permit readiness.'; } catch { if (storageStatus) storageStatus.textContent = 'Progress could not be saved in this browser.'; }
  }));
  clearChecklist?.addEventListener('click', () => {
    checks.forEach(input => { input.checked = false; });
    try { localStorage.removeItem(checklistStorageKey); } catch {}
    updateProgress();
    if (storageStatus) storageStatus.textContent = 'Local checklist marks cleared.';
  });
  document.getElementById('copy-checklist-btn')?.addEventListener('click', async () => {
    const status = document.getElementById('checklist-copy-status');
    const heading = document.querySelector('h1')?.textContent ?? 'Solar permit checklist';
    const lines = checks.map(input => `${input.checked ? '[x]' : '[ ]'} ${input.closest('label')?.textContent?.replace(/\s+/g, ' ').trim() ?? ''}`);
    const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href ?? window.location.href;
    let sources: Array<{title:string;url:string}> = [];
    try { sources = JSON.parse(document.getElementById('checklist-source-data')?.textContent ?? '[]'); } catch {}
    const sourceLines = sources.map((source, index) => `${index + 1}. ${source.title}: ${source.url}`);
    try { await navigator.clipboard.writeText([heading, ...lines, '', 'Official sources', ...sourceLines, '', 'Confirm current requirements with the local authority.', canonical].join('\n')); if (status) status.textContent = 'Checklist and sources copied.'; }
    catch { if (status) { status.className = 'fact-notes'; status.textContent = 'Copy is unavailable in this browser. Use Print Checklist instead.'; } }
  });
  // Print all source and requirement details; restore the reader's expanded state afterwards.
  let openedForPrint: HTMLDetailsElement[] = [];
  window.addEventListener('beforeprint', () => { openedForPrint = Array.from(document.querySelectorAll<HTMLDetailsElement>('main details:not([open])')); openedForPrint.forEach(detail => detail.open = true); });
  window.addEventListener('afterprint', () => { openedForPrint.forEach(detail => detail.open = false); openedForPrint = []; });
  const revealHash = () => {
    let id: string; try { id = decodeURIComponent(window.location.hash.slice(1)); } catch { return; }
    const target = document.getElementById(id);
    target?.querySelector<HTMLDetailsElement>(':scope > .gp-section-details')?.setAttribute('open', '');
  };
  window.addEventListener('hashchange', revealHash); revealHash();
</script>

</body>
</html>
