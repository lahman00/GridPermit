---
// Single source of truth for the GA4 snippet — every page includes this
// instead of repeating the tracking ID inline. Previously only
// src/pages/index.astro had analytics; every other page (21 of 22) had none.
//
// This component also wires the site's conversion-event tracking (see
// src/lib/analytics-events.ts): any element anywhere on the site can opt in
// to tracking purely via a markup attribute —
//   data-track-view="locality_guide_viewed"  fires once, on page load
//   data-track-click="official_source_clicked" fires on click
//   data-track-toggle="faq_expanded"         fires when a <details> opens
// — so no page needs its own copy of this wiring or its own gtag snippet.
---

<!-- Google tag (gtag.js) -->
<script is:inline>
  // Preview visits must not pollute the production measurement stream.
  if (window.location.hostname === 'mygridpermit.com' || window.location.hostname === 'www.mygridpermit.com') {
    window.dataLayer = window.dataLayer || [];
    window.gtag = function gtag() { window.dataLayer.push(arguments); };
    window.gtag('js', new Date());
    window.gtag('config', 'G-PGX9SJ9QLG');
    const tag = document.createElement('script');
    tag.async = true;
    tag.src = 'https://www.googletagmanager.com/gtag/js?id=G-PGX9SJ9QLG';
    document.head.append(tag);
  }
</script>

<!-- Every page preloads its Google Fonts stylesheet (rel="preload") instead
of a render-blocking rel="stylesheet", then flips it to a real stylesheet
once loaded. The <noscript> fallback next to each preload link still
applies the font with JS disabled. -->
<script is:inline>
	window.addEventListener("load", () => {
		for (const link of document.querySelectorAll("link.async-font-css")) {
			link.rel = "stylesheet";
		}
	});
</script>
<script>
	import { trackEvent, isKnownAnalyticsEvent } from "../lib/analytics-events";

	document.addEventListener("DOMContentLoaded", () => {
		for (const el of document.querySelectorAll("[data-track-view]")) {
			const name = el.getAttribute("data-track-view") ?? "";
			if (isKnownAnalyticsEvent(name)) trackEvent(name);
		}
	});

	document.addEventListener("click", (e) => {
		const target = e.target;
		if (!(target instanceof Element)) return;
		const trigger = target.closest("[data-track-click]");
		if (!trigger) return;
		const name = trigger.getAttribute("data-track-click") ?? "";
		if (isKnownAnalyticsEvent(name)) trackEvent(name);
	});

	// <details>'s native "toggle" event doesn't bubble, so each element needs
	// its own listener rather than one delegated document-level listener.
	// Only fires on open (not close) — an "expanded" event, not a raw toggle.
	document.addEventListener("DOMContentLoaded", () => {
		for (const el of document.querySelectorAll("[data-track-toggle]")) {
			if (!(el instanceof HTMLDetailsElement)) continue;
			const name = el.getAttribute("data-track-toggle") ?? "";
			if (!isKnownAnalyticsEvent(name)) continue;
			el.addEventListener("toggle", () => {
				if (el.open) trackEvent(name);
			});
		}
	});
</script>
