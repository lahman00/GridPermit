---
import { buildLocalityIndexEntries, type LocalityRecord } from '../lib/locality-guide';
import { buildSearchIndex } from '../lib/search-index';
import { buildCountyHubs } from '../lib/county-hub';
import { buildUtilityHubs } from '../lib/utility-hub';
import { getAllBlogPosts } from '../lib/blog-posts';
import { STATE_META, SUPPORTED_STATE_CODES } from '../lib/state-meta';

const localityModules = import.meta.glob('../../data/localities/*.json', { eager: true }) as Record<string, { default: LocalityRecord }>;
const recordsById = new Map(Object.values(localityModules).map(mod => [mod.default.record_id, mod.default]));
const evaluationModules = import.meta.glob('../../output/*-evaluation.json', { eager: true }) as Record<string, { default: { records: Array<{record_id:string;readiness:string;completeness_pct:number}> } }>;
const evaluations = Object.values(evaluationModules).flatMap(mod => mod.default.records);
const localityEntries = buildLocalityIndexEntries(evaluations, recordsById);
const index = buildSearchIndex({
  localityEntries,
  blogPosts: await getAllBlogPosts(),
  countyHubs: buildCountyHubs(evaluations, recordsById).filter(hub => hub.state === 'CA'),
  utilityHubs: buildUtilityHubs(evaluations, recordsById).filter(hub => hub.state === 'CA'),
  states: SUPPORTED_STATE_CODES.map(code => STATE_META[code]),
});

---
<div class="gp-quick-search" data-quick-search>
  <form id="hero-search-form" action="/search/" method="get" role="search">
    <label for="hero-search-input" class="gp-kicker">Start with your location</label>
    <div class="gp-search-row">
      <input type="search" id="hero-search-input" name="q" placeholder="City, county or electric utility" autocomplete="off" aria-controls="quick-search-results" aria-describedby="quick-search-help" />
      <button type="submit" class="gp-button">Find <span aria-hidden="true">↗</span></button>
    </div>
  </form>
  <div class="gp-search-dropdown" data-search-dropdown hidden>
    <ul id="quick-search-results" aria-label="Suggested guides"></ul>
    <p data-search-empty hidden>No exact match. Try a city or utility, or <a href="/permits/">browse all states</a>.</p>
    <a class="gp-search-all" data-search-all href="/search/">See all results <span aria-hidden="true">↗</span></a>
  </div>
  <p id="quick-search-help" class="gp-search-help">City-level research. No address or contact details required.</p>
  <p class="sr-only" data-search-status role="status"></p>
  <script is:inline type="application/json" data-quick-search-index set:html={JSON.stringify(index).replace(/</g, '\\u003c')} />
</div>
<script>
  import { searchEntries, type SearchEntry } from '../lib/search-index';
  const root = document.querySelector<HTMLElement>('[data-quick-search]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('#hero-search-input');
    const list = root.querySelector<HTMLUListElement>('#quick-search-results');
    const dropdown = root.querySelector<HTMLElement>('[data-search-dropdown]');
    const empty = root.querySelector<HTMLElement>('[data-search-empty]');
    const all = root.querySelector<HTMLAnchorElement>('[data-search-all]');
    const status = root.querySelector<HTMLElement>('[data-search-status]');
    const index: SearchEntry[] = JSON.parse(root.querySelector('[data-quick-search-index]')?.textContent ?? '[]');
    const close = () => { if (dropdown) dropdown.hidden = true; };
    const render = () => {
      if (!input || !list || !dropdown || !empty || !all) return;
      const q = input.value.trim();
      list.replaceChildren();
      if (!q) { close(); if (status) status.textContent = ''; return; }
      const results = searchEntries(index, q);
      for (const result of results.slice(0, 5)) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        const type = document.createElement('span');
        const title = document.createElement('span');
        type.className = 'gp-suggestion-type';
        type.textContent = result.url.includes('/solar-permit-guide/') ? 'Locality' : result.category.replace('Blog · ', 'Guide · ');
        title.textContent = result.title;
        a.href = result.url;
        a.append(type, document.createTextNode(' '), title);
        li.append(a);
        list.append(li);
      }
      all.href = '/search/?q=' + encodeURIComponent(q);
      all.hidden = !results.length;
      empty.hidden = results.length > 0;
      dropdown.hidden = false;
      if (status) status.textContent = results.length ? `${results.length} results. ${Math.min(results.length, 5)} suggestions shown. Use Tab or Arrow Down to explore.` : 'No exact match. Try a city, county or electric utility.';
    };
    input?.addEventListener('input', render);
    input?.addEventListener('focus', render);
    input?.addEventListener('keydown', event => {
      if (event.key === 'ArrowDown' && dropdown && !dropdown.hidden) {
        const first = list?.querySelector('a');
        if (first) { event.preventDefault(); first.focus(); }
      }
      if (event.key === 'Escape') close();
    });
    dropdown?.addEventListener('keydown', event => {
      const links = Array.from(dropdown.querySelectorAll<HTMLAnchorElement>('a')).filter(link => !link.closest('[hidden]'));
      const active = links.findIndex(link => link === document.activeElement);
      if (event.key === 'Escape') { event.preventDefault(); close(); input?.focus(); close(); }
      if (event.key === 'ArrowDown' && active >= 0) { event.preventDefault(); links[Math.min(active + 1, links.length - 1)]?.focus(); }
      if (event.key === 'ArrowUp' && active >= 0) { event.preventDefault(); if (active === 0) input?.focus(); else links[active - 1]?.focus(); }
    });
    document.addEventListener('click', event => { if (event.target instanceof Node && !root.contains(event.target)) close(); });
    root.addEventListener('focusout', event => { if (event.relatedTarget instanceof Node && !root.contains(event.relatedTarget)) close(); });
  }
</script>
<style is:global>
  .gp-quick-search { position: relative; max-width: 670px; margin-top: 42px; }
  .gp-quick-search form > label { margin-bottom: 12px; font-size: 10px; }
  .gp-search-row { display: flex; gap: 8px; padding: 6px; border: 1px solid var(--gp-line); background: var(--gp-surface); border-radius: 2px; }
  .gp-search-row input { width: 100%; flex: 1; border: 0; padding: 12px 16px; background: transparent; font-size: 17px; }
  .gp-search-row .gp-button { flex: none; min-width: 115px; }
  .gp-search-help { font-size: 11px; color: var(--gp-muted); margin: 13px 0 0; }
  .gp-search-dropdown { position: absolute; left: 0; right: 0; top: calc(100% - 24px); background: var(--gp-surface); border: 1px solid var(--gp-line); z-index: 50; }
  .gp-search-dropdown ul { list-style: none; padding: 0; margin: 0; }
  .gp-search-dropdown li { margin: 0; }
  .gp-search-dropdown li a { display: block; padding: 14px 20px; font-size: 15px; border-bottom: 1px solid var(--gp-line); text-decoration: none; }
  .gp-search-dropdown a:hover, .gp-search-dropdown a:focus-visible { background: var(--gp-surface-hover); }
  .gp-suggestion-type { display: block; font: 9px/1.6 var(--gp-mono); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 5px; color: var(--gp-muted); }
  .gp-search-all { padding: 16px 20px; display: flex; justify-content: space-between; text-decoration: none; font-size: 12px; }
  .gp-search-dropdown > p { margin: 0; padding: 20px; font-size: 14px; color: var(--gp-muted); }
  @media(max-width: 600px) { .gp-search-row input { font-size: 16px; padding-inline: 10px; } .gp-search-row .gp-button { min-width: auto; gap: 14px; padding-inline: 16px; } }
</style>
