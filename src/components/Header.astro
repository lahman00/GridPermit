---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/" class="site-brand"><img src="/brand/gridpermit-logo.png" alt="" width="36" height="36" /> <span>{SITE_TITLE}</span></a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog/">Blog</HeaderLink>
			<HeaderLink href="/california/solar-permit-guides/">California Guides</HeaderLink>
			<HeaderLink href="/about/">About</HeaderLink>
			<HeaderLink href="/methodology/">Methodology</HeaderLink>
			<HeaderLink href="/partners/">Partners</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.site-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
	}
	.site-brand img {
		width: 36px;
		height: 36px;
		object-fit: contain;
		border-radius: 8px;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
</style>
