---
// Single shared confidence-badge renderer — every locality-page confidence
// line goes through this component instead of repeating the same
// dot+label markup at each of the ~10 call sites in LocalityGuideLayout.astro.
import { confidenceLabel, confidenceBadgeClass } from "../lib/locality-guide";

interface Props {
	confidence: unknown;
}

const { confidence } = Astro.props;
const label = confidenceLabel(confidence);
const dotClass = confidenceBadgeClass(confidence);
---

<p class="fact-meta"><span class={`confidence-dot ${dotClass}`} aria-hidden="true"></span>Confidence: {label}</p>

<style>
	.confidence-dot {
		display: inline-block;
		width: 0.55em;
		height: 0.55em;
		border-radius: 50%;
		margin-right: 0.4em;
		vertical-align: middle;
	}
	.badge-high { background: #16a34a; }
	.badge-medium { background: #d97706; }
	.badge-low { background: #ea580c; }
	.badge-none, .badge-unknown { background: #94a3b8; }
</style>
