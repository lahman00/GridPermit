---
interface Props {
  label?: string;
  compact?: boolean;
}

const { label = 'GridPermit', compact = false } = Astro.props;
---
<span class:list={['gp-brand-logo', { 'gp-brand-logo--compact': compact }]} aria-label={label}>
  <svg class="gp-brand-mark" viewBox="0 0 40 40" aria-hidden="true">
    <rect class="gp-brand-tile" x="2" y="2" width="36" height="36" />
    <path class="gp-brand-grid" d="M20 5v30M5 20h30" />
    <path class="gp-brand-route" d="m7 30 9-9 6 5 11-16" />
    <circle class="gp-brand-origin" cx="7" cy="30" r="2.5" />
    <circle class="gp-brand-terminal" cx="33" cy="10" r="5" />
    <path class="gp-brand-check" d="m30.5 10 1.7 1.8 3-3.5" />
  </svg>
  <span class="gp-brand-type" aria-hidden="true"><span>Grid</span><strong>Permit</strong></span>
</span>
