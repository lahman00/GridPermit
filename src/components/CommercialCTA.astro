---
// Staged component. No production layout imports this yet.
// Selection is always recomputed here; callers cannot pass a pre-approved CTA.
import type { CommercialCatalog, CommercialContext, ExperimentConfig } from '../lib/commercial/types';
import { selectCommercialRoute } from '../lib/commercial/routing';
import { selectExperimentRoute } from '../lib/commercial/experiments';
import CompareSolarPricesCTA from './CompareSolarPricesCTA.astro';
interface Props { context: CommercialContext; catalog: CommercialCatalog; now?: string; experiments?: ExperimentConfig[]; anonymousSession?: string; requireFirstLeadQualification?: boolean; }
const {context,catalog,now=new Date().toISOString(),experiments=[],anonymousSession,requireFirstLeadQualification=true}=Astro.props;
const experiment=selectExperimentRoute(experiments,context,catalog,now,anonymousSession);
const selected=experiments.length ? experiment.selected : selectCommercialRoute(context,catalog,{now});
const copy={SOLAR_QUOTE:['Explore a new solar project','Request a new-system quote'],BATTERY_SERVICE:['Add storage to your existing solar','Explore battery installation'],
  PERMIT_ENGINEERING:['Need professional help with your permit package?','Explore permit and engineering services'],PTO_HELP:['Need help completing interconnection?','Explore PTO assistance'],
  B2B:['Use permitting information in your workflow','Explore GridPermit for professionals'],LOCAL_INSTALLER:['Find a local installer','Explore the sponsored local installer'],PAY_PER_CALL:['Talk to a project specialist','Call the approved campaign'],NONE:['','']};
const text=selected?copy[selected.route.channel]:null;
---
{selected && text && (selected.route.tracking.mode==='legacy_csp'
  ? <CompareSolarPricesCTA state={context.state} city={context.city} requireFirstLeadQualification={requireFirstLeadQualification}/>
  : <section class="commercial-cta" aria-label={text[0]} data-commercial-config={JSON.stringify(selected)} data-experiment-id={experiment.assignment?.experimentId??'none'} data-variant={experiment.assignment?.variant??'none'}>
      <h2>{text[0]}</h2>
      <p>Continue to {selected.partner.name}. Confirm that the provider can help with your project before proceeding.</p>
      <ul>{selected.route.eligibility.map(item=><li>{item}</li>)}</ul>
      <button type="button" data-commercial-action>{text[1]} <span>(opens in a new tab)</span></button>
      <p class="disclosure">{selected.disclosure}</p>
      <p role="status" aria-live="polite" data-commercial-status></p>
    </section>)}
<script>
  import {newCommercialCid,buildCommercialOutbound,commercialRouteCurrent} from '../lib/commercial/attribution';
  import {trackCommercialEvent} from '../lib/commercial/events';
  import type {SelectedCommercialRoute} from '../lib/commercial/types';
  for (const root of document.querySelectorAll<HTMLElement>('[data-commercial-config]')) {
    if (root.dataset.initialized==='true') continue;
    root.dataset.initialized='true';
    const selected=JSON.parse(root.dataset.commercialConfig!) as SelectedCommercialRoute;
    // A static build must not keep a stale generic referral clickable forever.
    if (!commercialRouteCurrent(selected)) {root.hidden=true;continue;}
    window.setTimeout(()=>{root.hidden=true;},Math.max(0,Date.parse(selected.validUntil)-Date.now()));
    const emit=(stage:'rendered'|'exposed'|'clicked',cid?:string)=>{
      try {trackCommercialEvent(stage,selected,cid,root.dataset.experimentId,root.dataset.variant);} catch { /* analytics never blocks navigation */ }
    };
    emit('rendered');
    const action=root.querySelector<HTMLButtonElement>('[data-commercial-action]');
    if (!action) continue;
    if ('IntersectionObserver' in window) {
      const observer=new IntersectionObserver(entries=>{if(entries.some(x=>x.isIntersecting&&x.intersectionRatio>=0.5)){emit('exposed');observer.disconnect();}},{threshold:0.5});
      observer.observe(action);
    }
    action.addEventListener('click',()=>{
      try {if(!commercialRouteCurrent(selected)){root.hidden=true;return;}const cid=newCommercialCid();const url=buildCommercialOutbound(selected,cid); window.open(url,'_blank','noopener,noreferrer');emit('clicked',cid);}
      catch {const status=root.querySelector('[data-commercial-status]');if(status)status.textContent='This provider link is unavailable. Please try again later.';}
    });
  }
</script>
<style>
  .commercial-cta{box-sizing:border-box;max-width:48rem;padding:1.5rem;margin:2rem auto;border:1px solid #94a3b8;border-radius:12px;background:#0f172a;color:#f8fafc;font:1rem/1.6 system-ui}
  h2{font-size:1.35rem;line-height:1.3;margin:0 0 .75rem;color:inherit}p{margin:.75rem 0}ul{padding-left:1.25rem}
  button{box-sizing:border-box;max-width:100%;min-height:48px;padding:.8rem 1rem;background:#6ee7b7;color:#052e23;border:0;border-radius:6px;font:700 1rem/1.4 system-ui;cursor:pointer;overflow-wrap:anywhere}
  button:focus-visible{outline:3px solid #fbbf24;outline-offset:4px}button span{font-size:.8rem;display:block}
  .disclosure{font-size:.875rem;color:#cbd5e1}[role=status]{min-height:1.6em;margin-bottom:0}
</style>
