<dialog class="gp-command" data-command-search aria-labelledby="command-search-title">
  <div class="gp-command-head">
    <div><span class="gp-kicker">Quick find</span><strong id="command-search-title">Go anywhere.</strong></div>
    <button type="button" class="gp-command-close" data-command-close aria-label="Close search">Esc</button>
  </div>
  <form action="/search/" method="get" role="search">
    <label class="sr-only" for="command-search-input">Search city, county, utility or topic</label>
    <span aria-hidden="true">⌕</span>
    <input id="command-search-input" name="q" type="search" placeholder="City, county, utility or topic" autocomplete="off" />
    <button type="submit">Search <span aria-hidden="true">↗</span></button>
  </form>
  <div class="gp-command-results" data-command-results hidden>
    <p class="gp-command-result-count" role="status" data-command-result-count></p>
    <ul aria-label="Search suggestions" data-command-result-list></ul>
  </div>
  <nav aria-label="Quick links" data-command-quick-links>
    <a href="/california/"><span>01</span>California</a>
    <a href="/permits/"><span>02</span>Browse states</a>
    <a href="/blog/"><span>03</span>Solar guides</a>
    <a href="/methodology/"><span>04</span>Methodology</a>
  </nav>
  <p>Press <kbd>↵</kbd> to search · <kbd>Esc</kbd> to close</p>
</dialog>
<script>
  import { searchEntries, type SearchEntry } from '../lib/search-index';
  const command = document.querySelector<HTMLDialogElement>('[data-command-search]');
  const commandInput = command?.querySelector<HTMLInputElement>('input');
  const commandResults = command?.querySelector<HTMLElement>('[data-command-results]');
  const commandResultList = command?.querySelector<HTMLUListElement>('[data-command-result-list]');
  const commandResultCount = command?.querySelector<HTMLElement>('[data-command-result-count]');
  const quickLinks = command?.querySelector<HTMLElement>('[data-command-quick-links]');
  let searchIndex: SearchEntry[] | null = null;
  let indexPromise: Promise<SearchEntry[]> | null = null;
  let activeResult = -1;
  const loadIndex = () => {
    if (searchIndex) return Promise.resolve(searchIndex);
    if (!indexPromise) indexPromise = fetch('/search-index.json', { cache: 'force-cache' }).then(response => {
      if (!response.ok) throw new Error('Search index unavailable');
      return response.json() as Promise<SearchEntry[]>;
    }).then(index => searchIndex = index).catch(() => []);
    return indexPromise;
  };
  const currentResults = () => Array.from(commandResultList?.querySelectorAll<HTMLAnchorElement>('a') ?? []);
  const selectResult = (index: number) => {
    const items = currentResults(); if (!items.length) return;
    activeResult = ((index % items.length) + items.length) % items.length;
    items.forEach((item, itemIndex) => item.classList.toggle('is-active', itemIndex === activeResult));
    items[activeResult]?.scrollIntoView({ block: 'nearest' });
  };
  const renderResults = async () => {
    const query = commandInput?.value.trim() ?? '';
    if (!commandResults || !commandResultList || !quickLinks || !commandResultCount) return;
    if (!query) { commandResults.hidden = true; quickLinks.hidden = false; commandResultList.innerHTML = ''; commandResultCount.textContent = ''; activeResult = -1; return; }
    const token = query;
    const index = await loadIndex();
    if (commandInput?.value.trim() !== token) return;
    const matches = searchEntries(index, query).slice(0, 6);
    quickLinks.hidden = true; commandResults.hidden = false; commandResultList.innerHTML = ''; activeResult = -1;
    commandResultCount.textContent = matches.length ? `${matches.length} best ${matches.length === 1 ? 'match' : 'matches'}` : 'No instant match — press Enter for full search';
    for (const match of matches) {
      const li = document.createElement('li'); const link = document.createElement('a'); link.href = match.url;
      const meta = document.createElement('span'); meta.className = 'gp-command-result-meta'; meta.textContent = match.category;
      const title = document.createElement('strong'); title.textContent = match.title;
      const description = document.createElement('small'); description.textContent = match.description;
      link.append(meta, title, description); li.append(link); commandResultList.append(li);
    }
  };
  const openCommand = () => {
    if (!command) return;
    if (!command.open) command.showModal();
    window.setTimeout(() => commandInput?.focus(), 0);
    void loadIndex();
  };
  document.addEventListener('click', event => {
    const trigger = event.target instanceof Element ? event.target.closest('[data-command-open]') : null;
    if (!trigger) return;
    event.preventDefault();
    openCommand();
  });
  document.addEventListener('keydown', event => {
    const target = event.target;
    const typing = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement || (target instanceof HTMLElement && target.isContentEditable);
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); openCommand(); return; }
    if (event.key === '/' && !typing && !event.metaKey && !event.ctrlKey && !event.altKey) { event.preventDefault(); openCommand(); }
  });
  command?.querySelector('[data-command-close]')?.addEventListener('click', () => command.close());
  command?.addEventListener('click', event => { if (event.target === command) command.close(); });
  commandInput?.addEventListener('input', () => void renderResults());
  commandInput?.addEventListener('keydown', event => {
    const items = currentResults();
    if (event.key === 'ArrowDown' && items.length) { event.preventDefault(); selectResult(activeResult + 1); }
    else if (event.key === 'ArrowUp' && items.length) { event.preventDefault(); selectResult(activeResult - 1); }
    else if (event.key === 'Enter' && activeResult >= 0 && items[activeResult]) { event.preventDefault(); items[activeResult].click(); }
  });
</script>
<style is:global>
  .gp-command { width: min(680px, calc(100% - 32px)); max-height: min(680px, calc(100dvh - 32px)); padding: 0; color: var(--gp-ink); background: var(--gp-bg); border: 1px solid var(--gp-line); border-radius: 2px; box-shadow: 0 24px 80px rgba(0,0,0,.35); }
  .gp-command::backdrop { background: rgba(0,0,0,.72); backdrop-filter: blur(6px); }
  .gp-command-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; padding: 24px; border-bottom: 1px solid var(--gp-line); }
  .gp-command-head .gp-kicker { margin: 0 0 4px; color: var(--gp-accent); }
  .gp-command-head strong { font-size: 27px; font-weight: 300; letter-spacing: -.03em; }
  .gp-command-close { padding: 6px 8px; color: var(--gp-muted); background: transparent; border: 1px solid var(--gp-line); font: 10px/1 var(--gp-mono); text-transform: uppercase; }
  .gp-command form { display: grid; grid-template-columns: 28px minmax(0,1fr) auto; align-items: center; gap: 8px; margin: 24px; border: 1px solid var(--gp-line); background: var(--gp-surface); padding: 7px 7px 7px 16px; }
  .gp-command form > span { color: var(--gp-accent); font-size: 24px; }
  .gp-command input { width: 100%; border: 0; background: transparent; padding: 13px 8px; font-size: 18px; outline: 0 !important; }
  .gp-command form button { min-height: 48px; padding: 0 18px; color: var(--gp-accent-ink); background: var(--gp-accent); border: 0; }
  .gp-command nav { display: grid; grid-template-columns: 1fr 1fr; padding: 0 24px; }
  .gp-command nav a { display: flex; gap: 14px; padding: 18px 0; text-decoration: none; border-top: 1px solid var(--gp-line); }
  .gp-command nav a:nth-child(odd) { margin-right: 18px; }
  .gp-command nav a:nth-child(even) { margin-left: 18px; }
  .gp-command nav span { color: var(--gp-accent); font: 9px/1.7 var(--gp-mono); }
  .gp-command-results { padding: 0 24px; }
  .gp-command-result-count { margin: 0 0 10px; color: var(--gp-muted); font: 9px/1.5 var(--gp-mono); letter-spacing: .06em; text-transform: uppercase; }
  .gp-command-results ul { max-height: 340px; overflow: auto; margin: 0; padding: 0; list-style: none; border-bottom: 1px solid var(--gp-line); }
  .gp-command-results li { margin: 0; border-top: 1px solid var(--gp-line); }
  .gp-command-results a { display: grid; grid-template-columns: 94px minmax(0,1fr); gap: 5px 16px; padding: 14px 10px; text-decoration: none; }
  .gp-command-results a:hover,.gp-command-results a.is-active { background: var(--gp-surface); outline: 1px solid var(--gp-accent); outline-offset: -1px; }
  .gp-command-result-meta { grid-row: 1 / 3; color: var(--gp-accent); font: 9px/1.5 var(--gp-mono); text-transform: uppercase; }
  .gp-command-results strong { font-size: 14px; font-weight: 500; }
  .gp-command-results small { overflow: hidden; color: var(--gp-muted); font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
  .gp-command > p { margin: 18px 24px 22px; color: var(--gp-muted); font: 10px/1.5 var(--gp-mono); text-transform: uppercase; }
  .gp-command kbd,.gp-nav-shortcut { padding: 2px 5px; color: var(--gp-muted); border: 1px solid var(--gp-line); font: 9px/1 var(--gp-mono); }
  @media(max-width:600px) { .gp-command nav { grid-template-columns: 1fr; } .gp-command nav a:nth-child(n) { margin-inline: 0; } .gp-command form { grid-template-columns: 20px minmax(0,1fr); } .gp-command form button { grid-column: 1 / -1; } .gp-command-results a { grid-template-columns: 1fr; } .gp-command-result-meta { grid-row: auto; } }
</style>
