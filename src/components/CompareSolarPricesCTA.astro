---
// Staged only. This component is deliberately not imported by any production
// page yet. GitHub issue #5 is the activation gate: payment setup + W-8BEN
// must be complete before this can be wired into LocalityGuideLayout.
import { isCompareSolarServedCity } from "../lib/compare-solar-prices";

interface Props {
	city: string;
}

const { city } = Astro.props;
const eligible = isCompareSolarServedCity(city);
---

{eligible && (
	<section class="compare-solar-cta" aria-label="CompareSolarPrices referral" data-track-view="cpl_cta_viewed">
		<p class="compare-solar-disclosure">
			<strong>Paid referral disclosure:</strong> GridPermit has a paid referral relationship with CompareSolarPrices. If you use this link and later complete a qualifying action, GridPermit may receive compensation.
		</p>
		<h2>Want a solar quote after reviewing the permit requirements in {city}?</h2>
		<p>Continue to CompareSolarPrices to request a homeowner solar quote for {city}.</p>
		<button type="button" class="compare-solar-btn" data-compare-solar-cta data-city={city}>
			Request a quote from CompareSolarPrices →
		</button>
		<p class="compare-solar-note">You will continue on CompareSolarPrices' website. GridPermit is not the installer.</p>
	</section>
)}

<script>
	import { buildCompareSolarReferralUrl } from "../lib/compare-solar-prices";
	import { trackEvent } from "../lib/analytics-events";

	document.addEventListener("click", (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;
		const trigger = target.closest("[data-compare-solar-cta]");
		if (!(trigger instanceof HTMLButtonElement)) return;

		const city = trigger.dataset.city ?? "";
		const referralUrl = buildCompareSolarReferralUrl(city);
		if (!referralUrl) return;

		trackEvent("cpl_cta_clicked", {
			partner: "compare_solar_prices",
			city_slug: city.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, ""),
			page_path: window.location.pathname,
		});

		window.open(referralUrl, "_blank", "noopener,noreferrer");
	});
</script>

<style>
	.compare-solar-cta {
		background: var(--bg-dark, #0f172a);
		color: white;
		border-radius: 10px;
		padding: 1.5rem;
		text-align: center;
		margin: 2rem 0;
	}

	.compare-solar-cta h2 {
		font-size: 1.15rem;
		font-weight: 700;
		margin: 0 0 0.5rem;
		color: white;
	}

	.compare-solar-cta p {
		font-size: 0.85rem;
		color: #cbd5e1;
		line-height: 1.5;
	}

	.compare-solar-disclosure {
		margin: 0 0 1rem;
		font-size: 0.78rem !important;
	}

	.compare-solar-btn {
		display: inline-block;
		background: var(--accent, #10b981);
		color: white;
		border: 0;
		padding: 0.85rem 1.5rem;
		border-radius: 6px;
		font: inherit;
		font-weight: 800;
		font-size: 0.9rem;
		cursor: pointer;
	}

	.compare-solar-btn:hover {
		background: #059669;
	}

	.compare-solar-btn:focus-visible {
		outline: 3px solid white;
		outline-offset: 3px;
	}

	.compare-solar-note {
		font-size: 0.72rem !important;
		color: #94a3b8 !important;
		margin: 0.9rem 0 0 !important;
	}
</style>
